# ============================================================
# Giochi System — fragmento COMUM do BusyBox
# ============================================================
# Applets que TODO aparelho precisa ter, independente de SoC ou painel. É a
# definição do "sistema base" no que depende do busybox.
#
# Regra que vale aqui: um applet entra nesta lista quando a falta dele impede
# **diagnosticar ou acessar** o aparelho. Editor de texto e cliente de e-mail não
# entram; `ip`, `udhcpd` e `nc` entram.
#
# Fragmento de busybox usa kconfig: desligar é "# CONFIG_X is not set" e
# ligar é "CONFIG_X=y". Não existe merge parcial — o valor vale inteiro.

# ── tc: DESLIGADO, e é correção, não contorno ───────────────
# O applet `tc` do busybox 1.36.1 usa `TCA_CBQ_*` e `struct tc_cbq_*`, que foram
# REMOVIDOS do kernel junto com o qdisc CBQ (saíram no 6.12). Com
# `BR2_KERNEL_HEADERS_AS_KERNEL=y` os headers do toolchain são os do kernel
# escolhido, então a compilação morre em `networking/tc.c` com uma parede de
# "invalid use of undefined type 'struct tc_cbq_wrropt'" que não cita kernel,
# headers nem busybox.
#
# Isto pertence ao COMUM e não ao fragmento do aparelho: depende da versão do
# kernel, que é a mesma (6.12) para todos. Estava só na X55 porque ela foi o
# primeiro aparelho — e o X35H quebrou no `tc` exatamente por isso.
#
# Não é perda: `iproute2` está na imagem comum e o `tc` dele compila contra os
# headers atuais. Quem precisa de shaping usa `/sbin/tc`, não o applet.
#
# NÃO troque a sintaxe: só "# CONFIG_X is not set" desliga o símbolo de fato.
# CONFIG_TC is not set

# ── udhcpd: dá IP ao PC pelo cabo USB ───────────────────────
# Sem isto, o acesso por SSH sobre USB exige que a pessoa configure IP estático
# na mão, em cada máquina, e descubra qual endereço usar. Com isto, o PC pluga o
# cabo, recebe 10.55.0.1 por DHCP em ~1 s e o aparelho está acessível.
#
# Isto é a diferença entre "funciona" e "funciona depois de 15 minutos de
# configuração manual no Windows" — e a maioria dos aparelhos desta árvore não
# tem Wi-Fi, Bluetooth nem TTL.
CONFIG_UDHCPD=y
# Lease de 1 hora é o padrão do applet. O host é um só, cabo curto: não há por
# que mexer.
CONFIG_UDHCPC=y

# ── rede: diagnóstico ───────────────────────────────────────
# `ip` já é o do busybox; o iproute2 está na imagem comum e tem precedência no
# PATH, mas manter os dois evita imagem quebrada se o pacote sair.
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
CONFIG_ROUTE=y
CONFIG_NETSTAT=y
CONFIG_PING=y
CONFIG_PING6=y
CONFIG_TRACEROUTE=y
CONFIG_FEATURE_TRACEROUTE_VERBOSE=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_TELNET=y

# ── diagnóstico do sistema ──────────────────────────────────
# `nc` é o canivete para testar porta e transferir arquivo quando não há scp:
#   nc -l -p 5556 > arquivo            (no aparelho)
#   nc 10.55.0.2 5556 < arquivo        (no PC)
# Em bring-up, é o caminho mais curto para tirar um log de dentro do aparelho.
CONFIG_NC=y
CONFIG_NC_SERVER=y
CONFIG_NC_EXTRA=y
CONFIG_DMESG=y
CONFIG_FEATURE_DMESG_PRETTY=y
CONFIG_HEXDUMP=y
CONFIG_STRINGS=y
CONFIG_LSOF=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_TOP=y
CONFIG_FEATURE_TOP_CPU_USAGE_PERCENTAGE=y
CONFIG_IOSTAT=y
CONFIG_MPSTAT=y

# ── arquivo e transferência ─────────────────────────────────
# `scp`/`sftp` vêm do **OpenSSH** (a imagem não tem dropbear, §10-A: os dois
# juntos disputavam a porta 22). Estes são os que faltam quando é preciso copiar
# algo rápido sem servidor.
CONFIG_BASE64=y
CONFIG_UNZIP=y
CONFIG_GZIP=y
CONFIG_TAR=y
# Nomes MEDIDOS no Kconfig do busybox 1.36.1 (`archival/Config.in`):
# `FEATURE_SEAMLESS_GZ` / `FEATURE_SEAMLESS_XZ`. Os que estavam aqui,
# `CONFIG_FEATURE_TAR_GZIP` e `CONFIG_FEATURE_TAR_XZ`, **não existem desde o
# 1.31** — o `olddefconfig` do busybox descartava os dois em silêncio, e o
# resultado medido no R35S era `# CONFIG_FEATURE_SEAMLESS_GZ is not set`:
# `tar xzf` NÃO funcionava, embora o fragmento dissesse que sim.
#
# `AUTODETECT` liga sozinho UMA das compressões (ligou o XZ), e não dá para
# depender de qual: com as duas explícitas, as duas funcionam.
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_DD=y
CONFIG_SYNC=y

# ── editor mínimo ───────────────────────────────────────────
# `vi` do busybox é o que sobra quando a única via é o console e um arquivo
# errado impede o boot. Não é conforto: é o que permite corrigir
# /etc/wpa_supplicant.conf ou /etc/network/interfaces sem tirar o cartão.
CONFIG_VI=y
CONFIG_FEATURE_VI_UNDO=y
CONFIG_FEATURE_VI_SEARCH=y

# ── processo e serviço ──────────────────────────────────────
CONFIG_PS=y
# `FEATURE_PS_WIDE` NÃO pode ser ligado nesta imagem e ficou fora de propósito.
# Medido: `procps/Config.in` do busybox 1.36.1 declara
#   depends on (PS || MINIPS) && !DESKTOP
# e `CONFIG_DESKTOP=y` na config final, então o símbolo é descartado pelo
# `olddefconfig` sem uma linha de aviso.
#
# Além disso ele seria inútil: a imagem traz **procps-ng** e o binário dele vence
# o symlink do busybox no PATH (§12.46). O `ps` que o operador usa é o do
# procps-ng, e nele `-w` é outra coisa.
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_KILLALL5=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_CRONTAB=y
# `FEATURE_CROND_DIR` é STRING, não bool (`miscutils/Config.in`):
#   config FEATURE_CROND_DIR
#   string "crond spool directory"
#   default "/var/spool/cron"
# Escrever `=y` aqui era descartado e o default ficava — o efeito desejado, por
# um caminho que não era o escrito. O valor padrão serve; a linha saiu.

# ── shell ───────────────────────────────────────────────────
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_EXPAND_PRMT=y

# ── diagnóstico ─────────────────────────────────────────────
# `timeout` faltava, e custou tempo: sem ele um teste que trava prende o
# console para sempre, porque não há segunda sessão para matar o processo.
# Pedido da equipe da engine (relatório de 07/11/2026, P2).
#
# O applet do busybox resolve por ~1 KB. `BR2_PACKAGE_COREUTILS` traria o
# `timeout` e mais 100 utilitários que a imagem não usa — o mesmo raciocínio do
# `tc` (§12.7): preferir o applet quando ele cobre o caso.
CONFIG_TIMEOUT=y
