# ============================================================
# Giochi System — configuração comum a todos os dispositivos
# ============================================================
# Este fragmento é aplicado depois do defconfig de cada device.
# Opções específicas de hardware devem ficar no fragmento do
# dispositivo, em device/<device>/buildroot.fragment.
#
# A senha de root, o hostname, o issue e os overlays são
# definidos por scripts/prepare-config.mjs durante o build.

# ── SDK: headers e sysroot para build cruzado ───────────────
# Pedido da equipe da engine (07/11/2026, P1). O `/usr/include` da imagem é
# VAZIO — medido: zero entradas. Não há stdio.h, stdlib.h nem os headers das
# satélites do SDL2. Consequência: não se compila nada no aparelho, e um build
# cruzado que use o sysroot dele fica incompleto.
#
# A correção certa NÃO é copiar `include/` e `lib/` para o rootfs (isso
# multiplica o tamanho da imagem e continua sem os headers de libc). É exportar
# um SDK de verdade: o Buildroot gera um tarball auto-contido com sysroot,
# toolchain e `environment-setup-*`, e `make sdk` o produz.
#
#   BR2_PACKAGE_HOST_ENVIRONMENT_SETUP=y   → `environment-setup-<arch>`
#   make sdk                                → tarball em images/
#
# A vantagem que resolve o P1 inteiro: o SDK já traz `PKG_CONFIG_SYSROOT_DIR` e
# `PKG_CONFIG_LIBDIR` apontados para o sysroot certo. É exatamente o que faltava
# quando os `.pc` do host vazaram para o cross-compile (§12.54, §12.55).
BR2_PACKAGE_HOST_ENVIRONMENT_SETUP=y

# Pacotes básicos de operação e diagnóstico.
#
# BR2_PACKAGE_BUSYBOX_SHOW_OTHERS libera os pacotes que o BusyBox já fornece
# (bash, less, procps-ng e outros). Sem ele o `olddefconfig` DESCARTARIA os
# três em silêncio — foi o que o `assert-config` pegou no primeiro build real.
# O defconfig do QEMU deixa essa opção desligada.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_CA_CERTIFICATES=y
# O símbolo antigo `BR2_PACKAGE_CURL` é LEGACY no 2024.02: ele seleciona
# BR2_LEGACY, e o Buildroot aborta com "You have legacy configuration in your
# .config!" sem dizer qual símbolo é o culpado. O nome atual é
# BR2_PACKAGE_LIBCURL_CURL (o binário); a biblioteca é BR2_PACKAGE_LIBCURL.
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_DOSFSTOOLS=y
# evtest: base da ferramenta `giochi-buttons` e do diagnóstico de entrada. Sem
# ele não há como provar que um botão chega ao kernel com o código certo — o
# `giochi-selftest` conta capacidades, mas não vê eventos.
BR2_PACKAGE_EVTEST=y
# bootsplash: padrão em TODOS os aparelhos desta árvore.
#
# O `psplash` é userspace e cobre do `init` até o launcher assumir a tela. Ele
# não é o único pedaço: o kernel mostra texto no framebuffer entre o U-Boot e o
# init (ver `CONFIG_LOGO` nos fragmentos de kernel), e o psplash pinta por cima
# quando sobe.
#
# A imagem é NOSSA e é gerada no tamanho da tela do aparelho por
# `scripts/gerar-splash.mjs`, entregue ao pacote por `config/package-overrides.mk`.
# Sem o override o psplash usaria o logo do Yocto, que não é deste projeto.
#
# `BR2_USE_WCHAR` é dependência do pacote e já vem do defconfig arm64; num
# defconfig sem wchar o símbolo seria descartado em silêncio e o `assert-config`
# reprovaria o build — que é o comportamento certo.
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_E2FSPROGS=y
# iproute2 é do sistema base, não do aparelho: o `giochi-usbnet` usa
# `ip link`/`ip addr` e o applet `tc` do busybox está desligado no comum
# (config/common.busybox.fragment) porque não compila contra o kernel 6.12.
# O `tc` do iproute2 é o substituto. Sem isto, um aparelho novo perde as duas
# coisas de uma vez — e o sintoma é "usb0 não sobe".
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_STRACE=y
# binutils no ALVO: é de onde vem o `readelf`.
#
# A decisão anterior neste projeto era NÃO instalar (§12.36): pesava "a toolchain
# inteira no aparelho" para servir a um diagnóstico. Medido em 06/11/2026, o
# custo real é outro: o `readelf` aarch64 tem **1 053 240 B** (1 MB) e o conjunto
# completo dá ~4 MB sem strip — num rootfs de 1 GB isso é 0,4%.
#
# O que se ganha é a prova EXATA de ligação dinâmica: `readelf -d` mostra as
# `DT_NEEDED`, que é a única forma de responder "esta biblioteca é USADA?" em vez
# de "esta biblioteca existe?" — a distinção que já custou dois falsos positivos
# neste projeto (harfbuzz no SDL2_ttf e libasound no launcher).
#
# O `giochi-selftest` continua com a cascata (`ld.so --list` pelo exit code,
# `grep -a` no `.dynstr`), porque imagem sem binutils tem de continuar
# funcionando. O `readelf` é a primeira opção quando existe.
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_BINUTILS_TARGET=y
# `ldd` no alvo — o `readelf` do binutils responde "quais bibliotecas este ELF
# pede", mas o `ldd` responde a pergunta que o operador faz de verdade: "o que
# falta para ESTE binário abrir?". A mensagem `version 'GLIBC_2.39' not found`
# ou uma `libfoo.so` ausente viram tentativa e erro sem ele.
#
# Pedido da equipe da engine (13/11/2026, item 3). Medido no Buildroot 2024.02:
#   package/glibc/Config.in:67   config BR2_PACKAGE_GLIBC_UTILS
#   package/glibc/glibc.mk:218   GLIBC_TARGET_UTILS_USR_BIN = posix/getconf elf/ldd
#   package/glibc/glibc.mk:224   GLIBC_TARGET_UTILS_SBIN  = elf/ldconfig
#
# Vem junto `ldconfig` (hoje ausente, e é ele quem atualiza o cache de soname) e
# `getconf`. Custo: o `ldd` do glibc é um SCRIPT de shell (`elf/ldd.bash.in`),
# não um binário — e o Buildroot já fixa `ac_cv_path_BASH_SHELL=/bin/bash`
# porque `BR2_PACKAGE_BASH=y` está aqui em cima. Quem tirar o bash tem de saber
# que o `ldd` cai para `sh` (o `GLIBC_LDD_NO_BASH` do glibc.mk reescreve o
# script).
#
# Não é opção de aparelho: todo device desta árvore usa a glibc do próprio
# Buildroot (o `choice` de libc tem `default BR2_TOOLCHAIN_BUILDROOT_GLIBC`, e
# nenhum defconfig escolhe uclibc/musl), então o símbolo existe em todos.
#
# ARMADILHA do build retomado (§12.29): num `work/` já construído o glibc NÃO
# reinstala — o build fica verde e sem `ldd`. Este símbolo exige build do zero
# (ou `rm -rf work/<device>/build/glibc-*/`).
BR2_PACKAGE_GLIBC_UTILS=y
BR2_PACKAGE_UTIL_LINUX=y

# kmscube NÃO entra aqui.
#
# `BR2_PACKAGE_KMSCUBE` não sobrevive ao olddefconfig no 2024.02: ele depende da
# pilha mesa3d (GBM + OpenGL ES + libdrm), que o defconfig do QEMU não liga. Ligar
# só o kmscube não basta — arrasta mesa inteiro, e num aparelho real o custo é
# outro (Mali via panfrost).
#
# Consequência assumida: `giochi-selftest` marca o bloco 3D como SKIP e DIZ que
# não pode provar EGL/GLES, em vez de assumir que funciona. Provar 3D exige
# habilitar a pilha gráfica por aparelho, com a GPU daquele SoC.
#
# Para habilitar no futuro, no fragmento DO DISPOSITIVO (não no comum):
#   BR2_PACKAGE_MESA3D=y
#   BR2_PACKAGE_MESA3D_GBM=y
#   BR2_PACKAGE_MESA3D_OPENGL_ES=y
#   BR2_PACKAGE_KMSCUBE=y
# e confirmar que os quatro sobrevivem ao assert-config.

# Console serial: o getty NÃO define a velocidade, o kernel define.
#
# Quem manda no baud é a linha de comando do kernel (`console=ttyS2,1500000n8`
# no X55, `console=ttyAMA0,115200` no QEMU). Um baud explícito aqui faz o getty
# REPROGRAMAR a UART — no X55 isso derruba o console de 1500000 para 115200 e a
# saída vira lixo. Com KEEP, o getty recebe "0" e não mexe no que o kernel
# configurou.
#
# Quem precisa de 115200 (como o QEMU) não faz nada: o kernel já está em 115200.
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y

# Imagem de rootfs em ext4; o tamanho pode ser sobrescrito no
# fragmento do dispositivo.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y

# O Buildroot gera um usuário root com a senha configurada no
# build (padrão: giochi-system). Troque antes de distribuir imagens.
