# Powkiddy X55 — fragmento de KERNEL
#
# Aplicado ao `.config` do kernel via `BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES`.
# NÃO é fragmento de Buildroot: símbolo `CONFIG_*` aqui não vira `BR2_*`.
#
# Conteúdo organizado por prioridade de falha: display, armazenamento, input,
# depois o resto.
#
# Símbolo com "CONFERIR" no comentário é o que não pude validar contra a árvore do
# kernel 6.12. Se o build parar em `assert-config` citando um deles, é nome errado.

# ── display: o bloco mais frágil ─────────────────────────────
#
# ARMADILHA MEDIDA: o PHY DSI **tem de ser =y, nunca =m**.
# Como módulo ele carrega depois do controlador DSI, o painel recebe -517
# (EPROBE_DEFER) e desiste. Resultado: nenhum /dev/dri/card0, tela preta, e nenhuma
# mensagem que ligue o sintoma à causa.
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_HIMAX_HX8394=y
CONFIG_DRM_PANFROST=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Bootsplash: o fbcon NÃO toma a tela até haver texto para mostrar.
#
# Sem isto o fbcon pinta preto assim que carrega, apagando o que o U-Boot/firmware
# deixou — e o `psplash` só sobe no `S01`, alguns segundos depois. A janela preta
# no meio do boot é o que faz o usuário achar que travou.
#
# O logo do kernel (pinguim) também sai: `CONFIG_LOGO=n`. Não é vaidade — com o
# pinguim a sequência é "pinguim -> preto -> nosso splash", e sem ele é
# "preto -> nosso splash", que parece o mesmo sistema o tempo todo.
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# CONFIG_LOGO is not set
CONFIG_DRM_FBDEV_EMULATION=y
# Rotação do console. SEM ESTA OPÇÃO o parâmetro `fbcon=rotate:N` da linha de
# comando é IGNORADO EM SILÊNCIO — o kernel nem reclama.
#
# Medido no X55: a linha de comando já tinha `fbcon=rotate:3` e o console saía
# em 90x80 (720/8 x 1280/16), ou seja, na orientação NATIVA do painel, com o
# texto deitado. Não era o U-Boot: era esta opção desligada.
#
# O painel é 720x1280 (retrato) e o aparelho é usado em paisagem (1280x720).
# `fbcon=rotate:3` = 270° no sentido horário = 90° anti-horário (para a
# esquerda), que é a orientação correta aqui. Com a opção ligada o console passa
# a 160x45.
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# PWM4 alimenta o backlight: período 25000 ns (40 kHz).
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y

# ── energia: RK817 ───────────────────────────────────────────
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_RK808=y
CONFIG_INPUT_RK805_PWRKEY=y

# CONFERIR: driver de carga do RK817. Se não existir, o sistema funciona — só não
# mostra carga nem estado da bateria.
CONFIG_CHARGER_RK817=y

# ── armazenamento ────────────────────────────────────────────
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# ── entrada: 17 botões + 4 eixos ────────────────────────────
#
# NÃO é gpio-keys. Os botões e analógicos passam pelo `rocknix-joypad`
# (fora da árvore). Conferido no DTS mainline do 6.12: os 16 botões de gamepad
# JÁ estão em `gpio-keys-control` com códigos BTN_* próprios, e o volume em
# `gpio-keys-vol`. O `rocknix-joypad` só seria necessário para algo que o DTS
# não declare — o que falta hoje são os 4 eixos analógicos (`adc-joystick`).
# Só o volume é gpio-keys mainline.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
# AUSENTE no kernel 6.12 de propósito: `rocknix-joypad` é driver FORA da árvore.
# O símbolo não existe aqui, então o kernel o descarta. Enquanto o driver não
# virar pacote/patch, os 17 botões NÃO funcionam (só o volume, por gpio-keys).
# O assert-kernel-config exige esta linha: sem ela o build falha, porque um
# símbolo de entrada sumindo em silêncio é exatamente o que ele existe para
# pegar. Quando o driver entrar, remova o allow-drop.
# giochi-system:allow-drop CONFIG_JOYSTICK_ROCKNIX driver fora da árvore; botões ainda não suportados
CONFIG_JOYSTICK_ROCKNIX=y
CONFIG_KEYBOARD_GPIO=y

# SARADC + adc-joystick: os 4 eixos analógicos do aparelho.
#
# `CONFIG_IIO` e `SARADC` sozinhos NÃO bastam: o nó `adc-joystick` do DTS é
# atendido por drivers/input/joystick/adc-joystick.c. Sem
# `CONFIG_JOYSTICK_ADC` ele nunca probeia e os 4 eixos não existem — sem
# nenhuma linha de erro. Medido no X55: /proc/bus/input/devices listava
# gpio-keys-control, gpio-keys-vol e o codec, e nenhum dispositivo de eixos.
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_JOYSTICK_ADC=y

# ── áudio: RK817 em I2S ──────────────────────────────────────
#
# ARMADILHA MEDIDA (custou uma imagem sem áudio): o `olddefconfig` descarta o
# filho em silêncio se o pai estiver unset. Sem `ROCKCHIP_I2S` o
# `simple-audio-card` fica em deferred probe para sempre ("parse error") e não
# existe placa de som. Precisam estar os três: pai, I2S e I2S_TDM.
#
# Segunda armadilha: o `Playback Mux` do RK817 tem de ficar em **HP**. O
# amplificador do falante é alimentado por HPOL/HPOR; em SPK o aparelho fica mudo
# (o SPK DAC é class-D interno e não está roteado nesta placa).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
# =y, NÃO =m. O card `rk817_ext` declara `aux-devs = <&spk_amp>`, e o amplificador
# é `simple-audio-amplifier`. Como módulo ele não carrega no boot (o rootfs não
# tem autoload por modalias com mdev), o card never completa o probe e o
# resultado no aparelho foi `--- no soundcards ---`, com o dmesg dizendo apenas
# "platform sound: deferred probe pending: (reason unknown)".
#
# Medido no X55 com a imagem instalada: com =m, zero placas de som; o driver
# precisa estar embutido. Mesma classe de armadilha do PHY DSI (§12.4).
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y

# ── USB ──────────────────────────────────────────────────────
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y

# ── energia / CPU ────────────────────────────────────────────
# `CONFIG_ARM_ROCKCHIP_CPUFREQ` NÃO EXISTE no 6.12: o driver antigo foi removido
# e o RK3566 passou a usar o genérico `cpufreq-dt`, ligado pelo defconfig arm64.
# Pedir o símbolo antigo era erro silencioso — o kernel o descarta sem aviso e
# ninguém descobre que o escalonamento de frequência veio do defconfig, não do
# fragmento. Mantido como allow-drop para documentar a correção.
# giochi-system:allow-drop CONFIG_ARM_ROCKCHIP_CPUFREQ removido no 6.12; RK3566 usa cpufreq-dt
CONFIG_ARM_ROCKCHIP_CPUFREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_ROCKCHIP_THERMAL=y

# ── entropia ─────────────────────────────────────────────────
#
# ARMADILHA MEDIDA: o TRNG do RK3566 fica desligado no `rk356x.dtsi` (quem liga é o
# `rk3568.dtsi`, e a X55 é rk3566). Sem ele não há fonte de entropia: o crng
# inicializa tarde e `getrandom()` bloqueia — medido em 11 s num boot e 1024 s em
# outro.
#
# Isto só resolve com o nó `&rng { status = "okay" }` no DTS. O DTS mainline não
# traz — ver `device/powkiddy x55/README.md`.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y

# ── DONGLE Wi-Fi USB ─────────────────────────────────────────
#
# Este aparelho não tem rádio onboard, e a comunidade usa dongle na porta USB
# HOST (`usb@fd000000`, dr_mode=host, status=okay — a OTG fica para o gadget
# de rede). Sem estes drivers o dongle é plugado e NADA acontece: nenhum erro,
# nenhum wlan0, porque o kernel simplesmente não tem com que falar com ele.
#
# `CONFIG_MAC80211` e `CONFIG_CFG80211` já vêm =m do defconfig arm64; o que
# falta é o driver do chip.
#
# Cobertura escolhida — os dongles baratos que a comunidade usa:
#   RTL8XXXU   RTL8188CU/EU, RTL8192CU, RTL8723AU, RTL8188FU. É UM driver para
#              toda a família 8xxx USB, então cobre a maioria dos dongles de
#              R$ 20-40.
#   RTL8XXXU_UNTESTED  inclui os chips que o autor do driver não testou
#              (8188FU entra aqui). "Untested" significa não validado pelo
#              autor, não "quebrado" — e sem isso metade dos dongles novos fica
#              de fora. Se um dongle der problema, é aqui que se desliga.
#   RTL8192CU  driver legado do 8192CU, ainda necessário em algumas revisões
#              que o rtl8xxxu não cobre.
#   MT7601U    o dongle MediaTek mais barato; firmware própria.
#   ATH9K_HTC  AR9271 (Atheros), o mais estável da lista e comum em kits.
#
# Ficam =m: são módulos que carregam por modalias quando o dongle é plugado, e
# o `S15modules`/kmod já resolve isso. Não custam memória se ninguém plugar nada.
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTL8192CU=m
CONFIG_MT7601U=m
CONFIG_ATH9K_HTC=m

# ── Wi-Fi: RTL8821CS por SDIO ───────────────────────────────
#
# TEM driver mainline: família `rtw88`. Só o firmware precisa estar em
# /lib/firmware/rtw88/rtw8821c_fw.bin (vem do linux-firmware).
#
# Pode ser =m (ao contrário do PHY DSI, que exige =y). O SDIO precisa de
# `no-mmc` / `no-sd` / `sd-uhs-sdr50` no `&sdmmc1` do DTS, senão o probe falha
# com -110 e o wlan0 não aparece.
CONFIG_RTW88=m
CONFIG_RTW88_SDIO=m
CONFIG_RTW88_8821CS=m

# ── Bluetooth: mesmo chip, por UART em 3 fios ───────────────
#
# O chip é tratado como H5 de três fios via o fallback `rtl8723bs-bt`, mesmo o DTS
# declarando 4 fios com RTS/CTS — funciona porque o `btrtl` liga o flow control
# por comando do firmware.
#
# Armadilha: o `rtl8821cs_config.bin` do linux-firmware NÃO serve (sem entrada de
# offset 0x0c). Precisa do arquivo gerado de 25 bytes. Ver
# `device/powkiddy x55/README.md`.
# `CONFIG_BT` vem do defconfig arm64 como `=m` (Bluetooth é pilha opcional).
# Exigir `=y` aqui é atrito sem ganho: os módulos carregam por modalias do DT.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_3WIRE=y
