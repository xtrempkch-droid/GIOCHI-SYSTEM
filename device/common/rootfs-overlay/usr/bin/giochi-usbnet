#!/bin/sh
# ============================================================
# Giochi System — rede por cabo USB (usb0) + DHCP para o PC
# ============================================================
# Por que isto é padrão em TODOS os aparelhos:
#
#   a maioria não tem Wi-Fi nem Bluetooth, e console serial (TTL) exige
#   adaptador, solda ou case aberto — ferramenta que pouca gente tem.
#
# O cabo USB é o único canal que sobra: todo mundo tem um, e ele já está
# conectado para carregar. Com isto, o aparelho atende SSH em 10.55.0.2 sem
# nenhuma configuração no PC.
#
# ## RNDIS, e não ECM
#
# ECM é o padrão "correto" e foi o que se testou no bring-up da X55 — mas o
# **Windows não tem driver de ECM**. O PC cria a interface e não faz nada com
# ela: sem IP, sem adaptador de rede, sem pista do motivo.
#
# RNDIS é o que o Windows reconhece sozinho (instala o driver na hora). Linux
# também fala RNDIS (`rndis_host`), e o kernel desta árvore já traz as duas
# funções. Então:
#
#   padrão  → rndis   (Windows, e Linux também)
#   --ecm   → ecm     (macOS, ChromeOS, ou quando o host não tem rndis_host)
#
# ## DHCP, e não IP estático
#
# Com IP estático o PC precisa ser configurado à mão, em cada máquina, e a
# pessoa tem de descobrir qual endereço usar. Com `udhcpd` o PC pluga, recebe
# 10.55.0.1 em ~1 s, e `ssh root@10.55.0.2` simplesmente funciona.
#
# ## Transferência de arquivo, e por que NÃO é MTP
#
# O kernel mainline não tem `f_mtp` — não existe `CONFIG_USB_CONFIGFS_MTP` nem
# `f_mtp.c` em `drivers/usb/gadget/function/` (conferido no 6.12 desta árvore).
# MTP em Android só existe lá porque o Android não pode expor o armazenamento
# cru. Aqui pode, então `--ms` expõe uma partição como disco removível: o `cp`
# do PC funciona sem cliente nenhum.
#
# giochi-system:help:begin
# Uso:
#   giochi-usbnet                  # sobe o gadget (padrão RNDIS)
#   giochi-usbnet --ecm            # sobe com ECM (macOS/ChromeOS)
#   giochi-usbnet --ms /dev/mmcblk1p1  # expõe uma partição como disco removível
#   giochi-usbnet --ms-stop        # devolve a partição e volta ao RNDIS
#   giochi-usbnet --stop           # desmonta o gadget
#   giochi-usbnet --status         # o que está no ar, e o que o PC está vendo
# giochi-system:help:end

set -u

GADGET=/sys/kernel/config/usb_gadget/giochi
CONFIGFS=/sys/kernel/config
DEV_ADDR=10.55.0.2
DEV_CIDR=10.55.0.2/24
HOST_ADDR=10.55.0.1
HOST_MAC=02:47:49:4f:43:48
DEV_MAC=02:47:49:4f:43:49
LEASE_FILE=/var/lib/misc/udhcpd.leases
PIDFILE=/var/run/udhcpd.pid
DHCP_CONF=/etc/udhcpd.conf

log() { echo "giochi-usbnet: $*"; }
warn() { echo "giochi-usbnet: $*" >&2; }

find_udc() {
    for udc in /sys/class/udc/*; do
        [ -d "$udc" ] || continue
        basename "$udc"
        return 0
    done
    return 1
}

# ---------------------------------------------------------------- stop
stop_gadget() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
        rm -f "$PIDFILE"
        log "udhcpd parado"
    fi

    if [ -d "$GADGET" ]; then
        # Esvaziar UDC primeiro: sem isso o kernel se recusa a remover as
        # funções ("Device or resource busy") e o gadget fica meio montado.
        echo "" >"$GADGET/UDC" 2>/dev/null
        for l in "$GADGET"/configs/*/*; do
            [ -L "$l" ] && rm -f "$l"
        done
        rmdir "$GADGET"/configs/*/strings/0x409 2>/dev/null
        rmdir "$GADGET"/configs/* 2>/dev/null
        rmdir "$GADGET"/functions/* 2>/dev/null
        rmdir "$GADGET"/strings/0x409 2>/dev/null
        rmdir "$GADGET" 2>/dev/null
        log "gadget removido"
    fi
}

# ---------------------------------------------------------------- status
status() {
    echo "== UDC (controlador USB em modo dispositivo) =="
    find_udc || warn "  NENHUM UDC: o aparelho não está em modo dispositivo ( OTG )"
    for udc in /sys/class/udc/*; do
        [ -d "$udc" ] || continue
        echo "  $(basename "$udc"): state=$(cat "$udc/state" 2>/dev/null) current_speed=$(cat "$udc/current_speed" 2>/dev/null)"
    done

    echo "== gadget =="
    if [ -d "$GADGET" ]; then
        echo "  montado: $(cat "$GADGET/UDC" 2>/dev/null)"
        for f in "$GADGET"/configs/*/; do
            [ -d "$f" ] || continue
            echo "  config $(basename "$f"): $(ls "$f" 2>/dev/null | tr '\n' ' ')"
        done
    else
        echo "  NÃO montado (rode 'giochi-usbnet')"
    fi

    echo "== interface =="
    # `ip` primeiro: neste kernel `/sys/class/net/usb0` pode ser symlink
    # PENDURADO (o `net/` do gadget não existe no sysfs) mesmo com o netdev
    # funcionando e o SSH respondendo por ele. Ler o sysfs daria "não existe"
    # num aparelho perfeitamente acessível.
    if ip -o link show usb0 >/dev/null 2>&1; then
        ip -o link show usb0 2>/dev/null | sed 's/^/  /'
        ip -4 addr show usb0 2>/dev/null | sed 's/^/  /'
    elif [ -e /sys/class/net/usb0 ]; then
        echo "  usb0 no sysfs, sem ip: $(cat /sys/class/net/usb0/operstate 2>/dev/null)"
    else
        echo "  usb0 NÃO existe"
    fi

    echo "== DHCP (o PC pegou IP?) =="
    if pidof udhcpd >/dev/null 2>&1; then
        echo "  udhcpd rodando (pid $(pidof udhcpd | cut -d' ' -f1))"
        if [ -s "$LEASE_FILE" ]; then
            echo "  leases:"
            sed 's/^/    /' "$LEASE_FILE"
        else
            echo "  nenhum lease ainda — o PC não pediu IP."
            echo "  No Windows: 'ncpa.cpl' → o adaptador novo tem de aparecer."
        fi
    else
        echo "  udhcpd NÃO está rodando"
    fi

    echo "== ssh =="
    # A imagem usa **OpenSSH** (§10-A): o dropbear saiu porque os dois juntos
    # disputavam a porta 22 e o `scp` moderno é SFTP, que o dropbear não tem.
    # Este bloco dizia "dropbear NÃO está rodando" para sempre — o `pidof
    # dropbear` nunca acha nada nesta imagem, e um status que aponta para o
    # servidor errado manda procurar defeito onde não há.
    if pidof sshd >/dev/null 2>&1; then
        echo "  sshd rodando (OpenSSH)"
    else
        echo "  sshd NÃO está rodando — o SSH por USB não vai responder"
    fi
    echo
    echo "Do PC:  ssh root@$DEV_ADDR"
}

# ---------------------------------------------------------------- start
start_gadget() {
    FUNCTION=${1:-rndis}

    udc="$(find_udc)" || {
        warn "nenhum UDC encontrado."
        warn "O aparelho precisa estar em modo dispositivo. Num handheld com"
        warn "porta OTG, isso normalmente é só conectar ao PC."
        return 1
    }

    # configfs é módulo/opcional no Buildroot: montar é idempotente.
    if ! grep -q " $CONFIGFS " /proc/mounts 2>/dev/null; then
        mount -t configfs none "$CONFIGFS" 2>/dev/null || {
            warn "não consegui montar configfs. O kernel tem CONFIG_USB_CONFIGFS=y?"
            return 1
        }
    fi

    # Remontar do zero: sobra de boot anterior deixa o gadget num estado em que
    # o UDC não aceita bind, e o erro ("Device or resource busy") não diz por quê.
    if [ -d "$GADGET" ]; then
        stop_gadget >/dev/null 2>&1
    fi

    mkdir -p "$GADGET"
    cd "$GADGET" || return 1

    # IDs: VID 0x1d6b é o Linux Foundation; PID 0x0104 é "Multifunction
    # Composite Gadget". Genéricos de propósito — não somos um produto USB
    # registrado, e um VID de terceiro seria mentira.
    echo 0x1d6b >idVendor
    echo 0x0104 >idProduct
    # bcdDevice: identificável no dmesg do PC ("idVendor=1d6b").
    echo 0x0100 >bcdDevice
    echo 0x0200 >bcdUSB

    mkdir -p strings/0x409
    echo "Giochi" >strings/0x409/manufacturer
    echo "Giochi System" >strings/0x409/product
    # Serial único por aparelho evita que o Windows reaproveite o driver e o IP
    # de outro aparelho já plugado.
    SERIAL="$(cat /etc/hostname 2>/dev/null || echo giochi)-$(cat /sys/class/net/usb0/address 2>/dev/null | tr -d ':' || echo 0000)"
    echo "${SERIAL:-giochi}" >strings/0x409/serialnumber

    mkdir -p "functions/$FUNCTION.usb0"
    if [ "$FUNCTION" = "ecm" ]; then
        echo "$DEV_MAC" >functions/ecm.usb0/dev_addr
        echo "$HOST_MAC" >functions/ecm.usb0/host_addr
        LABEL="ECM"
    else
        # RNDIS: o Windows só aceita um MAC "local administered"; estes já são.
        echo "$DEV_MAC" >functions/rndis.usb0/dev_addr
        echo "$HOST_MAC" >functions/rndis.usb0/host_addr
        LABEL="RNDIS"

        # Compatible ID do RNDIS no MS OS Descriptor.
        #
        # "RNDIS" + "5162001" é o par que o Windows usa para casar o driver de
        # rede sem pedir instalacao. O caminho `os_desc/interface.rndis/` é
        # criado pelo proprio kernel (usb_os_desc_prepare_interf_dir ->
        # "interface.%s"), com os atributos compatible_id e sub_compatible_id.
        #
        # ARMADILHA: escrever nesses dois arquivos NAO BASTA. O descritor so
        # chega ao host se o gadget declarar b_vendor_code e apontar a config
        # em os_desc — feito logo abaixo. Sem isso os arquivos existem, aceitam
        # o valor e o Windows nunca os ve (bind pelo driver in-box, que
        # funciona, mas com menos determinismo entre versoes).
        if [ -d functions/rndis.usb0/os_desc/interface.rndis ]; then
            echo "RNDIS" >functions/rndis.usb0/os_desc/interface.rndis/compatible_id 2>/dev/null
            echo "5162001" >functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id 2>/dev/null
        fi
    fi

    mkdir -p configs/c.1/strings/0x409
    echo "$LABEL" >configs/c.1/strings/0x409/configuration
    echo 250 >configs/c.1/MaxPower
    ln -s "functions/$FUNCTION.usb0" configs/c.1/ 2>/dev/null

    # MS OS Descriptor: e isto que faz o Windows reconhecer o aparelho na hora.
    # b_vendor_code e o valor que o Windows usa nas requisicoes de controle
    # (0xcd e o convencional); qw_sign identifica o fornecedor da extensao
    # ("MSFT100"). O symlink os_desc -> config liga o descritor a configuracao.
    #
    # Falhar aqui NAO e fatal: RNDIS tem driver in-box e o adaptador aparece
    # mesmo sem isso.
    if [ "$FUNCTION" = "rndis" ]; then
        mkdir -p os_desc
        echo 0xcd >os_desc/b_vendor_code 2>/dev/null || true
        echo MSFT100 >os_desc/qw_sign 2>/dev/null || true
        ln -s configs/c.1 os_desc 2>/dev/null || true
    fi

    echo "$udc" >UDC 2>/dev/null || {
        warn "não consegui fazer bind do gadget em $udc"
        return 1
    }
    log "gadget $LABEL montado em $udc"

    # A interface pode levar um instante para aparecer depois do bind.
    i=0
    while [ ! -d /sys/class/net/usb0 ] && [ "$i" -lt 50 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    if [ ! -d /sys/class/net/usb0 ]; then
        warn "usb0 não apareceu após o bind"
        return 1
    fi

    ip link set usb0 up 2>/dev/null
    ip addr add "$DEV_CIDR" dev usb0 2>/dev/null || true
    log "usb0: $DEV_ADDR (o PC recebe $HOST_ADDR por DHCP)"

    start_dhcp
}

start_dhcp() {
    command -v udhcpd >/dev/null 2>&1 || {
        warn "udhcpd ausente: configure IP estático no PC ($HOST_ADDR/24) e use $DEV_ADDR."
        warn "O applet vem de CONFIG_UDHCPD no config/common.busybox.fragment."
        return 0
    }

    # Faixa de UM endereço: o cabo liga um PC por vez, e uma faixa maior só
    # aumenta a chance de o host pegar um IP que já foi de outra máquina.
    #
    # SEM `option router` E SEM `option dns`, de propósito.
    #
    # O lease anunciava `router 10.55.0.2` e `dns 10.55.0.2`, mas o aparelho não
    # encaminha pacote (`net.ipv4.ip_forward=0`), não tem NAT (nem `nft` nem
    # `iptables` na imagem) e não tem servidor DNS (porta 53 recusa). Medido
    # pela equipe da engine em 13/11/2026 no R35S: o PC recebia uma rota default
    # e um resolver apontando para um porteiro que não existe. Numa máquina cujo
    # único adaptador é este cabo, a internet do PC inteira para — e o culpado
    # parece o console.
    #
    # O `ssh root@10.55.0.2` continua funcionando sem as duas: o PC recebe
    # 10.55.0.1/24 no mesmo lease, então 10.55.0.2 está ON-LINK e não precisa de
    # gateway nenhum. O mDNS também, que é multicast no segmento.
    #
    # Se um dia houver uplink de verdade (Wi-Fi no X55), as duas linhas voltam
    # JUNTAS com a implementação — `ip_forward=1` + NAT + um resolver. Anunciar
    # sem implementar é pior que não anunciar: a rota morta esconde o erro até o
    # primeiro `connect()`.
    mkdir -p "$(dirname "$LEASE_FILE")"
    cat >"$DHCP_CONF" <<EOF
# Gerado por giochi-usbnet. Não edite: é reescrito a cada boot.
start		$HOST_ADDR
end		$HOST_ADDR
interface	usb0
max_leases	1
lease_file	$LEASE_FILE
pidfile		$PIDFILE
option	subnet	255.255.255.0
option	domain	giochi.local
EOF

    # Já rodando? Reiniciar pega lease velho e a interface pode ter mudado.
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
        sleep 0.2
    fi

    # Sem -f: o applet daemoniza sozinho e grava o pidfile declarado acima.
    # Falha aqui NÃO é fatal: o SSH continua funcionando com IP estático no PC,
    # então avisa e segue em vez de derrubar o script.
    if udhcpd -S "$DHCP_CONF" 2>/dev/null; then
        log "udhcpd rodando (o PC pega $HOST_ADDR)"
    else
        warn "udhcpd não subiu; conecte com IP estático: PC $HOST_ADDR/24, aparelho $DEV_ADDR"
    fi
}

# ---------------------------------------------------------------- massa
# Modo "armazenamento em massa": o PC vê uma PARTIÇÃO do aparelho como disco
# removível. É o caminho para copiar arquivo grande (ROM, jogo, log) sem rede
# e sem servidor nenhum rodando.
#
# Por que NÃO MTP: o kernel mainline não tem `f_mtp` — não existe
# CONFIG_USB_CONFIGFS_MTP nem `f_mtp.c` em drivers/usb/gadget/function/. MTP em
# Android vem de patch fora da árvore, e existe lá porque o Android não pode
# expor o armazenamento cru. Aqui pode: mass_storage é mais simples, mais
# rápido, e o `cp` do PC funciona sem cliente nenhum.
#
# REGRAS DE SEGURANÇA, e cada uma custou um incidente em algum lugar:
#
# 1. **Nunca a partição do rootfs.** Expor `/dev/mmcblk1p2` (que está montada em
#    `/`) ao PC deixa o host escrever num filesystem em uso, e o resultado é
#    perda silenciosa de dados — o kernel do aparelho não sabe que o PC mexeu.
#    Recusar é obrigatório, não zelo.
# 2. **Desmontar antes de expor.** Expor uma partição montada dá o mesmo
#    problema pela outra ponta: o aparelho tem cache sujo e o PC lê lixo.
# 3. **Avisar que o aparelho perde a partição.** Enquanto o modo está ativo, o
#    aparelho não vê aquele armazenamento. Silêncio aqui faz o usuário concluir
#    que o cartão "sumiu".
start_mass_storage() {
    PART="${1:-}"
    if [ -z "$PART" ]; then
        warn "uso: $0 --ms <partição>   (ex.: /dev/mmcblk1p1)"
        warn "partições disponíveis:"
        for p in /dev/mmcblk*p* /dev/sd*[0-9]; do
            [ -b "$p" ] || continue
            case "$p" in *mmcblk?p[0-9]|*sd?[0-9]) echo "  $p";; esac
        done
        return 2
    fi

    [ -b "$PART" ] || {
        warn "$PART não é um dispositivo de bloco"
        return 2
    }

    # ## A guarda que não se negocia, e a armadilha que a fez falhar
    #
    # Primeira versão comparava `awk '$2=="/"{print $1}' /proc/mounts` com o
    # part e usava `readlink -f`. NÃO funcionou, e o teste no aparelho expôs o
    # rootfs ao PC — o pior defeito possível neste script:
    #
    #   /proc/mounts     ->  /dev/root            (nome de conveniência)
    #   readlink -f      ->  /dev/root            (o node NÃO EXISTE)
    #   ls /dev/root     ->  No such file or directory
    #
    # `readlink -f` de um caminho inexistente devolve o próprio caminho, então a
    # comparação `/dev/root` vs `/dev/mmcblk1p2` dava "diferente" e a guarda
    # deixava passar.
    #
    # O método que funciona é comparar por **major:minor**, que é o que o kernel
    # usa e que não depende de nome de node:
    #
    #   /proc/self/mountinfo  ->  "24 1 179:2 / / rw ... - ext4 /dev/root rw"
    #   /sys/dev/block/179:2  ->  .../mmcblk1/mmcblk1p2
    #
    # E ainda: a partição que sustenta `/` pode não estar exposta como um node em
    # /dev (é o caso aqui), então comparar caminhos de /dev é frágil por
    # construção.
    #
    # `stat -c "%t:%T"` devolve major/minor em HEX, e o mountinfo em decimal.
    # Converter hex→decimal em shell precisaria de `strtonum` do awk, que NÃO
    # existe no busybox (§12.20 — o mesmo erro que já quebrou o contador de bits
    # do selftest).
    #
    # Caminho portável: o próprio kernel publica o número decimal como nome do
    # symlink em /sys/dev/block. Basta achar o symlink cujo DESTINO termina no
    # nome da partição — e o nome do node (`mmcblk1p2`) não depende do nome de
    # conveniência de /dev.
    raiz_maior_menor="$(awk '$5 == "/" {print $3; exit}' /proc/self/mountinfo 2>/dev/null)"
    alvo_maior_menor="$(ls -l /sys/dev/block 2>/dev/null \
        | awk -v p="$(basename "$PART")" '$NF ~ ("/" p "$") {print $9; exit}')"

    if [ -n "$raiz_maior_menor" ] && [ "$raiz_maior_menor" = "$alvo_maior_menor" ]; then
        warn "RECUSADO: $PART é a partição que sustenta o / deste aparelho."
        warn "Expor o rootfs a outro computador corrompe um filesystem EM USO,"
        warn "e o dano só aparece no próximo boot."
        return 1
    fi

    udc="$(find_udc)" || {
        warn "nenhum UDC encontrado: o aparelho não está em modo dispositivo."
        return 1
    }

    # Desmontar o que estiver montado nela, senão o aparelho tem cache sujo e o
    # PC recebe lixo.
    for mnt in $(awk -v d="$PART" '$1 == d {print $2}' /proc/mounts 2>/dev/null); do
        log "desmontando $mnt antes de expor"
        umount "$mnt" 2>/dev/null || {
            warn "não consegui desmontar $mnt — use o aparelho para liberar e tente de novo"
            return 1
        }
    done

    if ! grep -q " $CONFIGFS " /proc/mounts 2>/dev/null; then
        mount -t configfs none "$CONFIGFS" 2>/dev/null || {
            warn "não consegui montar configfs"
            return 1
        }
    fi

    [ -d "$GADGET" ] && stop_gadget >/dev/null 2>&1

    mkdir -p "$GADGET" || return 1
    cd "$GADGET" || return 1

    echo 0x1d6b >idVendor
    echo 0x0104 >idProduct
    echo 0x0100 >bcdDevice
    echo 0x0200 >bcdUSB

    mkdir -p strings/0x409
    echo "Giochi" >strings/0x409/manufacturer
    echo "Giochi System" >strings/0x409/product
    echo "$(cat /etc/hostname 2>/dev/null || echo giochi)-ms" >strings/0x409/serialnumber

    # `removable=1` faz o PC mostrar como disco removível (e permite ejetar sem
    # "write cache" pendente). `ro=0` de propósito: o objetivo é escrita.
    mkdir -p functions/mass_storage.usb0
    echo 1 >functions/mass_storage.usb0/lun.0/removable 2>/dev/null
    echo 0 >functions/mass_storage.usb0/lun.0/ro 2>/dev/null
    echo "$PART" >functions/mass_storage.usb0/lun.0/file || {
        warn "não consegui apontar $PART para o LUN"
        return 1
    }

    mkdir -p configs/c.1/strings/0x409
    echo "Armazenamento" >configs/c.1/strings/0x409/configuration
    echo 500 >configs/c.1/MaxPower
    ln -s functions/mass_storage.usb0 configs/c.1/ 2>/dev/null

    echo "$udc" >UDC 2>/dev/null || {
        warn "não consegui fazer bind do gadget em $udc"
        return 1
    }
    log "modo armazenamento: $PART exposta como disco removível"
    log "ENQUANTO ATIVO, este aparelho NÃO vê $PART — o PC está com ela."
    log "para devolver ao aparelho:  $0 --ms-stop && mount -a"
}

stop_mass_storage() {
    if [ -f "$GADGET/functions/mass_storage.usb0/lun.0/file" ]; then
        # Limpar o `file` DESANEXA o backing file. Sem isso o laser fica preso
        # no dispositivo e o aparelho não consegue remontar a partição.
        echo "" >"$GADGET/functions/mass_storage.usb0/lun.0/file" 2>/dev/null
    fi
    stop_gadget
    log "armazenamento liberado; voltando ao gadget de rede"
    start_gadget rndis
}

# ---------------------------------------------------------------- main
case "${1:-}" in
    --stop) stop_gadget ;;
    --status) status ;;
    --ecm) start_gadget ecm ;;
    --ms) start_mass_storage "${2:-}" ;;
    --ms-stop) stop_mass_storage ;;
    "" | --rndis) start_gadget rndis ;;
    -h | --help)
        # Sentinelas, e não `sed -n '2,40p'`: o recorte por número de linha
        # imprimia 30 linhas de justificativa junto do uso, e passaria a mentir
        # em silêncio quando o cabeçalho crescesse.
        awk '/^# giochi-system:help:begin$/ { dentro = 1; next }
             /^# giochi-system:help:end$/   { exit }
             dentro                         { sub(/^# ?/, ""); print }' "$0"
        ;;
    *)
        warn "opção desconhecida: $1"
        exit 2
        ;;
esac
