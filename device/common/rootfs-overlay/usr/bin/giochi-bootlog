#!/bin/sh
# ============================================================
# giochi-bootlog — grava o diagnóstico na partição FAT do cartão
# ============================================================
# Para aparelho SEM console serial. O cartão sai do aparelho e entra em qualquer
# PC (FAT é legível no Windows sem software nenhum).
#
# Uso: giochi-bootlog [early|full]
#
#   early → chamado por S10bootlog. Roda logo no começo: `dmesg` já tem TODO o
#           probe de kernel (painel, DRM, MMC, USB), então mesmo que um serviço
#           trave depois, o que interessa já está no cartão.
#   full  → chamado por S96bootlog. Acrescenta o resultado do `giochi-selftest`
#           e o estado final dos serviços.
#
# ## A armadilha que custou uma gravação de cartão
#
# A primeira versão montava com `mount -t vfat PARTUUID=47494f43-01 /mnt`.
# Não funcionou, e o log não apareceu — sem nenhum sinal, porque não há console.
#
# Causa medida: o busybox desta imagem tem `CONFIG_FEATURE_MOUNT_LABEL` DESLIGADO,
# então `mount` NÃO resolve `PARTUUID=`, `UUID=` nem `LABEL=` — só o util-linux
# faz isso. A string vai crua para o kernel, que responde ENODEV. O kernel tinha
# `CONFIG_VFAT_FS=y`, então o problema nunca foi o filesystem.
#
# Correção: achar a partição por CONTEÚDO. A partição 1 é a de boot e contém
# `extlinux/extlinux.conf` (e `boot.scr`). Se o arquivo está lá, é a partição
# certa — não importa o nome que o kernel deu ao dispositivo.
# ============================================================

set -u

PHASE="${1:-full}"
MNT=/mnt/bootlog
LOG_NAME=giochi-boot.log
# DOIS destinos, de propósito:
#
#   PERSIST_LOG  /root/giochi-boot.log  → no ext4 do cartão. SOBREVIVE ao
#                desligar e é lido de um PC Linux com `debugfs`, sem montar
#                nada. É a rede de segurança quando a montagem da FAT falha.
#   LOCAL_LOG    /var/log/giochi-boot.log → ferramenta do dia a dia enquanto o
#                sistema roda.
#
# Medido: `/var/log` é SYMLINK para `/tmp`, que é tmpfs — ou seja, /var/log NÃO
# é persistente. A versão anterior gravava só ali, então o log desaparecia no
# desligamento e não havia como ler nada depois. Guardar no FAT não bastava,
# porque era justamente a montagem do FAT que falhava.
PERSIST_LOG=/root/giochi-boot.log
LOCAL_LOG=/var/log/giochi-boot.log

# Escreve no stderr E no console do PAINEL.
#
# Por que /dev/tty0: num aparelho sem serial, o painel é a única superfície
# legível. O `console=` da cmdline aponta para a UART, então `echo >&2` some;
# mas `/dev/tty0` é o console virtual do `fbcon` — o que está desenhado na tela.
# Assim o erro aparece onde a pessoa consegue ler.
#
# Medido: a primeira versão mandava tudo para /dev/null no init script e o
# sintoma ficou sendo só "não tem log", sem nenhuma pista.
log() {
    echo "giochi-bootlog: $*" >&2
    if [ -w /dev/tty0 ]; then
        echo "giochi-bootlog: $*" >/dev/tty0 2>/dev/null
    fi
}

# Encontra a partição de boot e deixa montada em $MNT.
#
# Dois caminhos, nesta ordem:
#
#   1. Já existe um vfat montado com `extlinux.conf`/`boot.scr`? Usa esse
#      ponto. Acontece quando algo montou antes — e tentar montar por cima
#      falha com "already mounted or mount point busy", que não diz o motivo.
#   2. Senão, tenta montar cada candidato e VALIDA PELO CONTEÚDO.
#
# $MOUNTED_BY_US diz se devemos desmontar no fim: nunca desmontamos o que não
# montamos, senão derrubamos o ponto de montagem de outro processo.
MOUNTED_BY_US=0

is_boot_dir() {
    [ -f "$1/extlinux/extlinux.conf" ] || [ -f "$1/boot.scr" ]
}

mount_boot() {
    log "procurando a partição de boot"
    log "  blocos visíveis: $(ls /dev/mmcblk* /dev/sd* 2>/dev/null | tr '\n' ' ')"

    # 1. Vfat já montado com o conteúdo certo.
    for ponto in $(awk '$3 == "vfat" {print $2}' /proc/mounts 2>/dev/null); do
        if is_boot_dir "$ponto"; then
            MNT="$ponto"
            log "partição de boot já montada em $ponto"
            return 0
        fi
    done

    mkdir -p "$MNT" 2>/dev/null

    # 2. Candidatos. A ORDEM IMPORTA, e a versão anterior estava errada no X35H.
    #
    # Medido no aparelho: o kernel expõe DOIS cartões.
    #
    #   mmcblk0  3.7 GiB  eMMC interna com uma imagem antiga instalada.
    #                     mmcblk0p1 monta como vfat e TEM diretório `extlinux/`
    #                     (de outro sistema). Testá-la primeiro faz o script
    #                     gastar a tentativa num disco que não é o de boot.
    #   mmcblk1  29.7 GiB o cartão SD, que é o que bootou.
    #
    # Então a ordem é CALCULADA: começa pela partição 1 do disco que contém o
    # ROOTFS EM USO. `/proc/mounts` diz qual é, e a partição de boot mora no
    # mesmo disco. Só depois vêm os candidatos genéricos.
    # ATENÇÃO: `/proc/mounts` diz `/dev/root`, que é ALIAS, não o nome real —
    # o kernel o cria a partir do `root=` da cmdline. `readlink -f` resolve para
    # `/dev/mmcblk1p2` (medido no X35H). Sem resolver, nenhum padrão casa, a
    # ordem preferencial fica vazia e o script cai na lista genérica, que testa
    # a eMMC primeiro.
    root_dev=$(awk '$2 == "/" {print $1; exit}' /proc/mounts 2>/dev/null)
    if [ -n "$root_dev" ] && [ -e "$root_dev" ]; then
        root_real=$(readlink -f "$root_dev" 2>/dev/null)
        [ -n "$root_real" ] && root_dev="$root_real"
    fi
    # Fallback: o major:minor da raiz em /proc/self/mountinfo casa com o de
    # /sys/dev/block/<dev>/uevent, que dá o nome real do dispositivo.
    if [ "$root_dev" = "/dev/root" ] || [ ! -e "$root_dev" ]; then
        for m in /proc/self/mountinfo; do
            [ -r "$m" ] || continue
            mm=$(awk '$5 == "/" {print $3; exit}' "$m" 2>/dev/null)
            [ -n "$mm" ] || continue
            nome=$(basename "$(readlink -f "/sys/dev/block/$mm" 2>/dev/null)")
            [ -n "$nome" ] && root_dev="/dev/$nome"
        done
    fi
    preferido=""
    case "$root_dev" in
        /dev/mmcblk*p*) preferido="${root_dev%p*}p1" ;;   # mmcblk1p2 -> mmcblk1p1
        /dev/sd*[0-9] | /dev/vd*[0-9]) preferido="${root_dev%[0-9]}1" ;;
    esac
    [ -n "$preferido" ] && log "rootfs em $root_dev; partição de boot do mesmo disco: $preferido"

    for dev in $preferido /dev/mmcblk*p1 /dev/mmcblk*1 /dev/sd*[0-9] /dev/vd*[0-9]; do
        [ -b "$dev" ] || continue

        # `-o ro` no teste: se não for a nossa partição, não mexemos nela.
        # O erro vai para o log: "não montou" sem motivo é o que travou a
        # primeira tentativa deste script.
        if ! err=$(mount -t vfat -o ro "$dev" "$MNT" 2>&1); then
            log "  $dev: $err"
            continue
        fi

        if is_boot_dir "$MNT"; then
            # Remonta rw: o teste foi só leitura.
            umount "$MNT" 2>/dev/null
            if mount -t vfat -o rw,umask=0022 "$dev" "$MNT" 2>/dev/null; then
                MOUNTED_BY_US=1
                log "partição de boot: $dev"
                return 0
            fi
        fi
        log "  $dev: montou, mas não tem extlinux.conf nem boot.scr"
        umount "$MNT" 2>/dev/null
    done

    return 1
}

finish_mount() {
    if [ "$MOUNTED_BY_US" = "1" ]; then
        sync
        umount "$MNT" 2>/dev/null
    else
        sync
    fi
}

collect_early() {
    echo "=== giochi-boot.log — fase early — $(date -u '+%Y-%m-%dT%H:%M:%SZ') (UTC) ==="
    echo
    echo "## versao"
    cat /etc/giochi-system-release 2>/dev/null || cat /etc/giochi-release 2>/dev/null || uname -a
    echo
    echo "## cmdline"
    cat /proc/cmdline 2>/dev/null
    echo
    echo "## uptime"
    cat /proc/uptime 2>/dev/null
    echo
    # O bloco mais importante num bring-up: aqui estão o probe do painel DSI,
    # o DRM, o MMC e o USB — com os códigos de erro (-517 EPROBE_DEFER, -110
    # timeout) que dizem POR QUE a tela não acendeu.
    #
    # ## O spam que apaga o diagnóstico
    #
    # Medido no X55 em 08/11/2026, aparelho com a bateria desconectada
    # (`present=0`): o `rk817-charger` imprime
    #
    #   rk817-charger ...: Battery voltage 17840 below minimum voltage 3400000
    #
    # a cada ~8 s. Em 3,3 h de uptime isso são **1258 das 1260 linhas** do
    # buffer do dmesg — o log de boot inteiro foi rotacionado para fora, e
    # `dmesg | grep painel` não acha nada. O arquivo que o bring-up grava no
    # cartão viraria 1258 linhas de ruído, que é o oposto do que ele existe
    # para dar.
    #
    # Duas medidas, nesta ordem:
    #   1. comprime o ruído repetido (linhas consecutivas idênticas ganham
    #      contador) — assim um padrão que se repete continua visível, uma vez;
    #   2. grava o miolo do boot (timestamps abaixo de `BOOT_CORTE`) em bloco
    #      separado, ANTES, para o que aconteceu no boot sobreviver mesmo que
    #      o buffer já tenha rotacionado.
    #
    # Não se filtra por regex de propósito: escolher quais mensagens do kernel
    # "não importam" é como o `2>/dev/null` esconde a causa (§12.53). O corte
    # por TEMPO é objetivo: boot é o começo.
    echo "## dmesg"
    if command -v dmesg >/dev/null 2>&1; then
        # Agrupa por ASSINATURA da mensagem — timestamp removido e números
        # normalizados — e imprime a primeira ocorrência de cada padrão. Quando
        # o padrão se repete 3+ vezes, mostra a contagem e a última linha.
        #
        # Por que assinatura e não igualdade literal: cada repetição do charger
        # traz timestamp E tensão diferentes, então comparar `$0` nunca agruparia
        # nada. E por que o limite de 3: duas linhas com a mesma forma e números
        # diferentes (mmc0/mmc1 com endereços distintos) são informação, não
        # ruído — só a partir da terceira é que virou laço.
        #
        # Medido no X55: 1260 linhas de dmesg -> 8, preservando o
        # `fbcon: Taking over console` que estava espremido no meio de 1203
        # repetições de "Battery voltage ... below minimum voltage".
        dmesg 2>/dev/null | awk '
            function assinatura(s,   t) {
                t = s
                sub(/^\[[ 0-9.]+\] /, "", t)
                gsub(/[0-9]+/, "N", t)
                return t
            }
            function despeja() {
                if (primeira == "") return
                if (repetidas >= 2) {
                    printf "%s\n    ... %d linha(s) no mesmo padrao ...\n%s\n", primeira, repetidas, ultima
                } else {
                    print primeira
                    if (repetidas == 1) print ultima
                }
                primeira = ""
            }
            {
                a = assinatura($0)
                if (primeira != "" && a == anterior) { repetidas++; ultima = $0; next }
                despeja()
                anterior = a; primeira = $0; ultima = $0; repetidas = 0
            }
            END { despeja() }
        ' 2>/dev/null || echo "(dmesg indisponível)"
    else
        echo "(dmesg indisponível)"
    fi
    echo
    echo "## DRM: conectores, status e modos"
    for f in /sys/class/drm/*/status; do
        [ -r "$f" ] || continue
        echo "$f: $(cat "$f" 2>/dev/null)"
    done
    for f in /sys/class/drm/*/modes; do
        [ -r "$f" ] || continue
        echo "$f: $(head -1 "$f" 2>/dev/null)"
    done
    ls -l /dev/dri 2>/dev/null || echo "(sem /dev/dri)"
    for f in /sys/class/backlight/*/brightness; do
        [ -r "$f" ] || continue
        echo "backlight $f: $(cat "$f" 2>/dev/null)"
    done
    echo
    echo "## entrada (botões e eixos existem?)"
    cat /proc/bus/input/devices 2>/dev/null || echo "(sem /proc/bus/input)"
    echo
    echo "## armazenamento"
    cat /proc/partitions 2>/dev/null
    echo
    echo "## rede"
    ip -o link show 2>/dev/null || echo "(sem ip)"
}

collect_full() {
    echo
    echo "## rede (fase full)"
    ip -o addr show 2>/dev/null || echo "(sem ip)"
    echo
    echo "## df"
    df -h 2>/dev/null
    echo
    echo "## selftest"
    /usr/bin/giochi-selftest 2>&1
    echo
    echo "=== fim — $(date -u '+%Y-%m-%dT%H:%M:%SZ') (UTC) ==="
}

# A fase early ESCREVE; a full ACRESCENTA. Assim, se a full não rodar (serviço
# travou), o arquivo do early continua no cartão com o dmesg.
if [ "$PHASE" = "early" ]; then
    collect_early >"$PERSIST_LOG" 2>&1
else
    collect_full >>"$PERSIST_LOG" 2>&1
fi
# Cópia para /var/log: útil com o sistema no ar, descartável no desligamento.
cp "$PERSIST_LOG" "$LOCAL_LOG" 2>/dev/null || true

if ! mount_boot; then
    log "NÃO consegui montar a partição de boot."
    log "O log está em $PERSIST_LOG (partição ext4 do cartão)."
    log "Do PC: debugfs -R 'cat /root/giochi-boot.log' /dev/sdX2"
    exit 0
fi

# Sempre do persistente: ele tem as duas fases, o /var/log pode ter só a última.
cp "$PERSIST_LOG" "$MNT/$LOG_NAME" 2>/dev/null

# sync antes do umount: o cartão pode ser removido a qualquer momento depois.
finish_mount
log "gravado em $LOG_NAME em $MNT"
exit 0
