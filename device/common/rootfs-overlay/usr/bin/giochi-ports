#!/bin/sh
# ============================================================
# giochi-ports — roda o PortMaster sem entregar o aparelho a ele
# ============================================================
# giochi-system:help:begin
# Uso:
#   giochi-ports                 # abre a GUI do PortMaster (em sandbox)
#   giochi-ports --liberar-drm   # para o launcher, abre a GUI, e o devolve
#   giochi-ports --rodar 2048    # roda um port instalado (libera o DRM antes)
#   giochi-ports --sem-sandbox   # roda direto, SEM isolamento (por sua conta)
#   giochi-ports --status        # onde ele está, e se o sandbox está disponível
#   giochi-ports -- <args>       # argumentos vão para o pugwash
# giochi-system:help:end
#
# ## Por que isto existe
#
# O PortMaster é uma loja de "ports": ele baixa um `.zip` de um repositório
# público, **sem assinatura**, e executa o `.sh` de dentro **como root** — porque
# os ports montam squashfs (`$ESUDO mount mono-….squashfs`) e mexem em
# `/dev/tty0`. O código que roda ali é de terceiros, e não passa por nenhuma
# chave nossa (o contrato das duas chaves é o §12.41 do AGENTS).
#
# A resposta não é "confiar". É **cercar**: o `bubblewrap` põe o processo num
# namespace com o rootfs em somente-leitura. O port continua rodando, e o que ele
# não pode mais é instalar binário em `/usr/bin`, alterar `/etc`, matar o
# launcher ou enxergar o cartão inteiro.
#
# ## O que o sandbox garante, e o que NÃO garante
#
# Garante (medido, `tests/portmaster.test.mjs` prende o desenho):
#   - rootfs (`/`) somente-leitura — o pior estrago possível some;
#   - `/user` só — o resto do disco não aparece;
#   - PID/net/UTS/IPC namespaces próprios — não vê nem mata processo de fora;
#   - `/tmp` próprio.
#
# NÃO garante:
#   - **privacidade de dados**: `/user` é gravável e é onde ficam os jogos. Um
#     port malicioso pode apagar os jogos do usuário. Isto é inerente: o
#     PortMaster *é* um instalador, ele precisa escrever ali;
#   - **contenção de recursos**: não há cgroup/limite de CPU ou RAM;
#   - **rede**: é compartilhada de propósito (§ abaixo).
#
# Como o sistema inteiro roda como root, o processo continua sendo root **dentro**
# do namespace. O ganho não é "virar usuário sem privilégio" — é "não alcançar o
# que está fora das montagens", que é o que os namespaces dão de graça.
#
# ## Por que a rede é compartilhada
#
# Baixar port e runtime é a função dele. `--unshare-net` deixaria a GUI abrir e
# não instalar nada — defeito silencioso, do tipo que este repositório combate
# (§12.15). O que se isola é o filesystem e os processos, não a rede.
#
# ## Por que `/dev` inteiro e não um `/dev` mínimo
#
# O port precisa de `/dev/dri` (desenhar), `/dev/input` (botões), `/dev/uinput`
# (o `gptokeyb`), `/dev/tty0` (o `printf '\033c'` deles) e `/dev/snd` (áudio).
# Montar só esses à mão é mais seguro no papel e frágil na prática: cada port
# novo pode pedir outro nó, e o sintoma seria "o jogo não abre" — a família do
# §12.15. O `--dev-bind` mantém o `/dev` do aparelho.

set -u

PORTS_DIR=/user/ports
PM_DIR="$PORTS_DIR/PortMaster"
BWRAP="$(command -v bwrap 2>/dev/null || true)"

aviso() { echo "giochi-ports: $*" >&2; }

achar_pm() {
    for d in "$PM_DIR" /roms/ports/PortMaster /opt/tools/PortMaster /PortMaster; do
        if [ -f "$d/pugwash" ]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

achar_python() {
    for p in /usr/bin/python3 /usr/local/bin/python3; do
        [ -x "$p" ] && { echo "$p"; return 0; }
    done
    return 1
}

# Quem tem o /dev/dri/card0 aberto. Lê /proc e não usa `ps` — o `ps` desta
# imagem só mostra a própria TTY (§12.46), e aqui a pergunta é sobre OUTRO
# processo.
quem_tem_o_drm() {
    for f in /proc/[0-9]*/fd/*; do
        case "$(readlink "$f" 2>/dev/null)" in
            /dev/dri/card0) echo "${f#/proc/}" | cut -d/ -f1; return 0 ;;
        esac
    done
    return 1
}

# Libera o DRM para a GUI, pelo mecanismo que o `giochi-init` já conhece:
# `dev-free-console` faz o supervisor NÃO reiniciar o launcher enquanto o
# arquivo existir. SIGTERM é o sinal certo — o init zera a cota em saída por
# sinal (§12.45), então isto não gasta restart e não faz o supervisor desistir.
# A flag é verificada a cada volta, então também vale com o launcher já no ar.
DEV_FREE_FILE="${GIOCHI_DEV_FREE_FILE:-/run/giochi/dev-free-console}"

liberar_drm() {
    # Se ninguém tem o card, NÃO se cria o marcador: é o caso de quem foi
    # lançado pelo launcher, que já destrói o `Painter` antes do `spawn` e
    # devolve o DRM master (medido no código deles: "o filho recebe kmsdrm not
    # available" sem isso). Marcar ali seria mentir para o `giochi-init` sobre um
    # console que não está livre — e se o port morresse com o marcador, o
    # launcher não voltaria.
    pid="$(quem_tem_o_drm)"
    if [ -z "$pid" ]; then
        return 0
    fi
    mkdir -p "$(dirname "$DEV_FREE_FILE")" 2>/dev/null || true
    : >"$DEV_FREE_FILE" || return 1
    aviso "liberando o DRM: parando o PID $pid (o launcher) — o supervisor o trará de volta ao sair"
    kill -TERM "$pid" 2>/dev/null || true
    i=0
    while [ "$i" -lt 60 ]; do
        [ -z "$(quem_tem_o_drm)" ] && return 0
        sleep 0.1 2>/dev/null || sleep 1
        i=$((i + 1))
    done
    return 1
}

devolver_drm() {
    rm -f "$DEV_FREE_FILE" "$DEV_FREE_FILE.pid" 2>/dev/null || true
}

modo="${1:-}"
LIBERAR_DRM=0
RODAR_PORT=""
# `set -u` está ligado: variável usada só no modo `--rodar` precisa existir
# sempre, senão a GUI morre com "PORT_SH: parameter not set" — medido no R35S
# em 20/11/2026, logo depois de o modo ser acrescentado.
PORT_SH=""
PORT_DIR=""
case "$modo" in
    --help|-h)
        # `awk` com padrão ANCORADO, como o `giochi-buttons`: com `sed` sem `^…$`
        # o próprio comando abaixo (que cita os dois marcadores numa linha só)
        # reabre a faixa e imprime o resto do arquivo. Medido no R35S em
        # 20/11/2026: `--help` saía com 133 linhas, quase todas de código.
        awk '/^# giochi-system:help:begin$/ { dentro = 1; next }
             /^# giochi-system:help:end$/   { exit }
             dentro                         { sub(/^# ?/, ""); print }' "$0"
        exit 0
        ;;
    --status)
        pm="$(achar_pm || true)"
        py="$(achar_python || true)"
        echo "PortMaster:  ${pm:-ausente} (procurei em $PM_DIR, /roms/ports, /opt/tools, /PortMaster)"
        echo "python3:     ${py:-AUSENTE — ligue GIOCHI_WITH_PORTMASTER=1 no build}"
        echo "sandbox:     ${BWRAP:-AUSENTE — ligue GIOCHI_WITH_PORTMASTER=1 no build}"
        if [ -n "$pm" ]; then
            echo "versao:      $(cat "$pm/version" 2>/dev/null || echo '(arquivo version ausente)')"
        fi
        if [ -n "$pm" ] && [ -n "$py" ] && [ -n "$BWRAP" ]; then
            echo "estado:      pronto (com sandbox)"
        elif [ -n "$pm" ] && [ -n "$py" ]; then
            echo "estado:      roda, mas SEM sandbox -- o codigo dos ports corre solto"
        else
            echo "estado:      nao roda ainda"
        fi
        ep="$(quem_tem_o_drm)"
        if [ -n "$ep" ]; then
            echo "DRM:         ocupado pelo PID $ep (o launcher) — use --liberar-drm"
        else
            echo "DRM:         livre"
        fi
        exit 0
        ;;
    --liberar-drm)
        LIBERAR_DRM=1
        shift
        ;;
    --rodar)
        # O `pugwash` NÃO roda port: ele instala, gerencia e sai deixando um
        # marcador de "frontend, atualize sua lista". Quem executa o port é o
        # frontend do CFW — no nosso caso, o launcher, quando ele listar
        # `/user/ports`. Enquanto isso não existe, este modo é o que permite
        # testar um port de verdade no aparelho.
        RODAR_PORT="${2:-}"
        shift 2 2>/dev/null || shift
        ;;
    --sem-sandbox)
        shift
        ;;
esac

pm="$(achar_pm)" || {
    aviso "PortMaster nao encontrado."
    aviso "Instale em $PM_DIR (o .zip do PortMaster, extraido)."
    aviso "Veja docs/evaluacao-portmaster.md."
    exit 1
}

py="$(achar_python)" || {
    aviso "python3 ausente: o pugwash e '#!/usr/bin/env python3'."
    aviso "A imagem precisa de GIOCHI_WITH_PORTMASTER=1 no build."
    exit 1
}

# O control.txt do PortMaster resolve o diretorio dos ports por
# '/$directory/ports/PortMaster'. O symlink /roms -> /user (criado pelo
# post-build) e o que faz esse caminho existir. Sem ele, o control.txt falha em
# SILENCIO ao carregar device_info.txt/funcs.txt e os ports seguem sem
# pm_finish/pm_message -- medido no R35S em 20/11/2026.
if [ ! -d /roms ]; then
    aviso "AVISO: /roms nao existe. O PortMaster deriva controlfolder de"
    aviso "       '/\$directory/ports/PortMaster' e vai falhar ao carregar"
    aviso "       funcs.txt. A imagem deveria trazer o symlink /roms -> /user."
fi

# ── a GUI é pysdl2, e o pysdl2 traz o próprio SDL2 ─────────────────────────
#
# O pacote do PortMaster carrega uma cópia do SDL2 em `exlibs/sdl2`, e o
# `pysdl2` a resolva por padrão. Essa cópia **não tem KMSDRM**, então a GUI
# morre com:
#
#   sdl2.ext.err.SDLError: 'Error encountered initializing the video subsystem:
#   No available video device'
#
# A mensagem aponta para o pysdl2, não para o driver, e manda procurar no lugar
# errado. O `pm_launch.txt` deles resolve no `pm_hook_gui_env()`
# (`export PYSDL2_DLL_PATH="/usr/lib"`), mas o `giochi-ports` chama o `pugwash`
# direto, sem passar por aquele laço — então a variável nunca era posta.
#
# Medido no R35S em 26/11/2026 (issue #6): com ela, o erro passa a ser
# `kmsdrm not available` **só** quando o card0 está ocupado, e abre quando está
# livre. É a variável que troca o SDL2 do pacote pelo da imagem.
PYSDL2_DLL_PATH=/usr/lib
export PYSDL2_DLL_PATH

# ── .pugwash-reboot: o pedido de reinício que sobrevive e mente ─────────────
#
# O `pugwash` deixa `.pugwash-reboot` quando se auto-atualiza, e no início ele
# faz (`pylibs/pugwash/main.py:129`):
#
#   if not reboot_file.is_file():
#       with pm.enable_cancellable(True):
#           pm.run()
#
# Ou seja: se o arquivo EXISTE, ele **pula a GUI e sai**, sem mensagem. O
# `pm_launch.txt` deles apaga antes de cada execução (`$ESUDO rm -f`); chamando
# o `pugwash` direto, ninguém apagava — medido: o arquivo do R35S era de 20/11 e
# a GUI não abria desde então.
#
# É a mesma família do marcador de DRM: estado que sobra de uma execução e mente
# sobre a próxima.
PUGWASH_REBOOT="$pm/.pugwash-reboot"
rm -f "$PUGWASH_REBOOT" 2>/dev/null || true

# Roda o `pugwash` e honra o pedido de reinício dele. É UMA função porque os dois
# caminhos (com e sem sandbox) precisam do mesmo comportamento — dois laços
# copiados divergem na primeira correção (§12.49).
#
# Roda em SEGUNDO PLANO e espera com `wait`: um `trap` de shell só roda quando o
# comando em primeiro plano termina, então um TERM no wrapper ficava ENFILEIRADO
# enquanto a GUI rodava — medido no R35S em 20/11/2026, com `timeout 30` e o
# processo seguindo por 152 s. Com `wait`, o sinal interrompe e o trap pode matar
# o filho (o `bwrap` mata os netos por `--die-with-parent`).
rodar_com_reinicio() {
    _rc=0
    while :; do
        "$@" &
        BW_PID=$!
        wait "$BW_PID"
        _rc=$?
        [ -f "$PUGWASH_REBOOT" ] || break
        rm -f "$PUGWASH_REBOOT" 2>/dev/null || true
    done
    return $_rc
}

if [ "$modo" = "--sem-sandbox" ]; then
    aviso "SEM sandbox, a pedido: o codigo dos ports roda com o rootfs gravavel."
    [ "$LIBERAR_DRM" = "1" ] && liberar_drm
    cd "$pm" || exit 1
    rodar_com_reinicio "$py" ./pugwash "$@"
    rc=$?
    [ "$LIBERAR_DRM" = "1" ] && devolver_drm
    exit $rc
fi

if [ -z "$BWRAP" ]; then
    aviso "bubblewrap ausente e nao foi pedido --sem-sandbox."
    aviso "Recusando rodar codigo de terceiro com o rootfs gravavel."
    aviso "  opcao 1: build com GIOCHI_WITH_PORTMASTER=1 (traz o bwrap)"
    aviso "  opcao 2: giochi-ports --sem-sandbox   (por sua conta e risco)"
    exit 1
fi

# --rodar: o port é um `.sh` dentro de /user/ports/<nome>/. Resolve o nome do
# diretório OU o do arquivo, sem exigir que os dois sejam iguais (não são: o
# `2048` mora em `2048/2048.sh`, mas `StardewValley` mora em
# `stardewvalley/StardewValley.sh`).
if [ -n "$RODAR_PORT" ]; then
    # Dois layouts convivem, e é a convenção do EmulationStation:
    #
    #   /user/ports/<nome>.sh          + /user/ports/<nome>/    (o instalado pelo
    #                                                           PortMaster)
    #   /user/ports/<nome>/<nome>.sh                            (o feito à mão)
    #
    # O nome do diretório e o do arquivo não coincidem sempre
    # (`stardewvalley/StardewValley.sh`), então a comparação é sem caixa.
    alvo="$(printf '%s' "$RODAR_PORT" | tr 'A-Z' 'a-z')"
    PORT_SH=""
    for f in "$PORTS_DIR"/*.sh "$PORTS_DIR"/*/*.sh; do
        [ -f "$f" ] || continue
        base="${f##*/}"
        base="${base%.sh}"
        pasta="$(dirname "$f")"
        pasta="${pasta##*/}"
        if [ "$(printf '%s' "$base" | tr 'A-Z' 'a-z')" = "$alvo" ] ||
           [ "$(printf '%s' "$pasta" | tr 'A-Z' 'a-z')" = "$alvo" ]; then
            PORT_SH="$f"
            break
        fi
    done
    if [ -z "$PORT_SH" ]; then
        aviso "port '$RODAR_PORT' nao encontrado em $PORTS_DIR"
        aviso "instalados: $(for f in "$PORTS_DIR"/*.sh; do [ -f "$f" ] && printf '%s ' "${f##*/}"; done)"
        exit 1
    fi
    PORT_DIR="$(dirname "$PORT_SH")"
    aviso "rodando ${PORT_SH##*/} (de $PORT_DIR)"
    # Port desenha: precisa do DRM, sempre.
    LIBERAR_DRM=1
fi

# O KMSDRM é exclusivo: com o launcher no ar o SDL nem inicializa o vídeo, e a
# mensagem (`kmsdrm not available`) não diz quem está com o card. Medido duas
# vezes — no kmscube (§12.72) e no próprio PortMaster (20/11/2026).
if [ "$LIBERAR_DRM" = "1" ]; then
    # `trap` e não só o `rm` do fim: se a GUI for morta por sinal (o `timeout`
    # do teste, um Ctrl-C, o OOM killer num aparelho de 1 GB), o marcador
    # ficaria e o aparelho voltaria SEM interface — o `giochi-init` respeita o
    # arquivo e não sobe o launcher. Marcar é fácil; desmarcar tem de ser
    # garantido.
    trap 'devolver_drm' EXIT
    if ! liberar_drm; then
        aviso "não consegui liberar o DRM: ainda há processo com /dev/dri/card0."
        exit 1
    fi
else
    ocupante="$(quem_tem_o_drm)"
    if [ -n "$ocupante" ]; then
        aviso "o DRM está ocupado pelo PID $ocupante — o KMSDRM é exclusivo, então"
        aviso "o SDL vai falhar com 'kmsdrm not available'."
        aviso
        aviso "  giochi-ports --liberar-drm   para o launcher, abre a GUI, e devolve"
        aviso "                               a interface quando ela terminar"
        exit 1
    fi
fi

# ── as montagens ────────────────────────────────────────────────────────────
#
# --ro-bind / /            rootfs congelado; nada de instalar em /usr ou /etc
# --dev-bind /dev /dev     DRM, input, uinput, tty0, snd
# --bind /user /user       onde ele escreve: ports, jogos, runtimes
# --bind /user/home /root  $HOME gravável (o control.txt escreve
#                          /root/pm_dialog.txt; sem isto, "Read-only file system")
# --tmpfs /tmp             nada sobrevive ao processo
# --proc /proc             muitos ports leem /proc
# --unshare-all            pid/net/uts/ipc/user/mount próprios
# --share-net              menos a rede: instalar depende dela
# --die-with-parent        se o launcher cair, o port não fica órfão
# --new-session            sem terminal de controle: Ctrl-C no pai não o mata
#
# Expandido SEM aspas de propósito: são literais fixos, sem espaço e sem glob.
# Caminho que venha de variável (o `$pm`) entra entre aspas, separado.
BW_BASE="--ro-bind / / --dev-bind /dev /dev --bind /user /user --bind /user/home /root --tmpfs /tmp --proc /proc --unshare-all --share-net --die-with-parent --new-session"

# ── o gamecontrollerdb.txt, e um limite do kernel que ele estoura ──
#
# O `control.txt` do PortMaster exporta o mapeamento inteiro numa variável de
# ambiente:
#
#   sdl_controllerconfig="$(< "$SDL_GAMECONTROLLERCONFIG_FILE")"
#   export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"
#
# e o `gamecontrollerdb.txt` deles tem 472 KB. **Uma única string de ambiente
# não pode passar de MAX_ARG_STRLEN (128 KB)**, então TODO `exec` depois disso
# falha com `Argument list too long` — medido no R35S em 20/11/2026, e o
# sintoma não aponta para o mapa: parece binário quebrado.
#
# A correção é montar o NOSSO arquivo por cima do deles. São 2 KB, e o efeito
# colateral é o que se quer: o mapeamento passa a ser o do projeto, com
# `a = BTN_EAST` (a convenção do plástico, §12.74), em vez do automático do SDL2
# com `a = BTN_SOUTH`.
GAMEDB=/etc/giochi/gamecontrollerdb.txt
if [ -f "$GAMEDB" ]; then
    BW_BASE="$BW_BASE --ro-bind $GAMEDB $pm/gamecontrollerdb.txt"
fi

# O `bwrap` roda em SEGUNDO PLANO e o shell espera com `wait`. Não é estilo: um
# `trap` de shell só roda quando o comando em primeiro plano termina, então um
# TERM no wrapper ficava ENFILEIRADO enquanto o port rodava — medido no R35S em
# 20/11/2026, com `timeout 30` e o port seguindo por 152 s. Com `wait`, o sinal
# interrompe e o trap pode matar o filho (o `bwrap` mata os netos por
# `--die-with-parent`).
if [ -n "$PORT_SH" ]; then
    # `bash`, e não `/bin/sh`: os port scripts usam `exec > >(tee ...)`, que é
    # sintaxe do bash. O `sh` desta imagem é o busybox ash e morreria nela.
    if [ -x /bin/bash ]; then PORT_SHELL=/bin/bash; else PORT_SHELL=/bin/sh; fi
fi

BW_PID=""

# O PID do wrapper vai para um arquivo: se ele for morto com `kill -9`, o trap
# não roda e o marcador ficaria — o `giochi-init` lê este arquivo e se cura.
#
# Só quando o marcador EXISTE: lançado pelo launcher (que já liberou o DRM) não
# há marcador a proteger, e criar o `.pid` sozinho deixaria lixo no /run.
#
# O trap referencia `$BW_PID` entre aspas SIMPLES, então ele é lido no instante
# do sinal — é o que faz o laço de reinício abaixo não perder o sinal na
# segunda volta.
if [ "$LIBERAR_DRM" = "1" ]; then
    [ -f "$DEV_FREE_FILE" ] && { echo $$ >"$DEV_FREE_FILE.pid" 2>/dev/null || true; }
    trap 'kill -TERM "$BW_PID" 2>/dev/null; wait "$BW_PID" 2>/dev/null; devolver_drm; exit 143' TERM INT
fi

# ── execução ───────────────────────────────────────────────────────────────
#
# O `bwrap` e o `--chdir` são os mesmos nos dois casos; o que muda é o comando.
# A ordem dos literais importa: `$BW_BASE` é expandido SEM aspas (são flags
# fixas, sem espaço), e o `$pm`/`$PORT_DIR` vai entre aspas separado.
if [ -n "$PORT_SH" ]; then
    # Port não pede reinício: o `.pugwash-reboot` é do pugwash, não dele. Mas o
    # `wait` em segundo plano continua valendo pelo trap.
    "$BWRAP" $BW_BASE --chdir "$PORT_DIR" "$PORT_SHELL" "$PORT_SH" "$@" &
    BW_PID=$!
    wait "$BW_PID"
    rc=$?
else
    rodar_com_reinicio "$BWRAP" $BW_BASE --chdir "$pm" "$py" ./pugwash "$@"
    rc=$?
fi

# O `trap` do EXIT já devolve o marcador; este `exit` só propaga o status da
# GUI. Sem o trap, um `kill -9` no meio deixaria o aparelho sem interface — e o
# arquivo pode ser removido à mão por SSH (`rm /run/giochi/dev-free-console`).
exit $rc
