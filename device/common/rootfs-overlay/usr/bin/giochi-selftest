#!/bin/sh
# giochi-selftest — verifica se o hardware e as camadas de software estão
# acordando, do kernel até o render 3D.
#
# Roda no APARELHO, não no PC. Serve para responder uma pergunta só:
# "este aparelho está convergindo?" — e produzir um relatório que dá para
# colar numa issue.
#
# POSIX sh (busybox ash). Sem dependência obrigatória: cada checagem degrada
# para SKIP quando a ferramenta não existe na imagem.
#
# Uso:
#   giochi-selftest              # relatório no terminal
#   giochi-selftest > r.txt      # salvar
#   giochi-selftest --quiet      # só as falhas
#
# Saída: PASS (funciona), WARN (parcial / a conferir), FAIL (não funciona),
# SKIP (não aplicável ou ferramenta ausente). Exit 1 se houver FAIL.

QUIET=0
[ "$1" = "--quiet" ] && QUIET=1

PASS=0; WARN=0; FAIL=0; SKIP=0

say() { [ "$QUIET" -eq 1 ] && return 0; printf '%s\n' "$*"; }
pass() { PASS=$((PASS+1)); say "  [PASS] $*"; }
warn() { WARN=$((WARN+1)); say "  [WARN] $*"; }
fail() { FAIL=$((FAIL+1)); say "  [FAIL] $*"; }
skip() { SKIP=$((SKIP+1)); say "  [SKIP] $*"; }
head2() { say ""; say "── $* ──"; }

read_or() {
    # read_or <arquivo> — primeira linha, ou vazio
    [ -r "$1" ] || return 0
    head -n 1 "$1" 2>/dev/null
}

now() { date '+%Y-%m-%d %H:%M:%S' 2>/dev/null; }

say "Giochi self-test"
say "  quando: $(now)"
say "  host:   $(hostname 2>/dev/null)"
say "  kernel: $(uname -srv 2>/dev/null)"

# ── identidade ───────────────────────────────────────────────
head2 "identidade do aparelho"

MODEL=""
if [ -r /proc/device-tree/model ]; then
    # termina em NUL: cortar no primeiro zero
    MODEL=$(tr -d '\000' </proc/device-tree/model)
fi

# O U-Boot SOBRESCREVE /model com o nome da placa DELE. Medido no X35H:
#
#   /proc/device-tree/model       -> "RG353M m"      (nome do U-Boot)
#   /proc/device-tree/compatible  -> "powkiddy,x35h rockchip,rk3566"
#
# O DTB é o nosso (o compatible prova), mas quem lê só o `model` conclui que o
# aparelho é um Anbernic. O `compatible` é a identidade em que se pode confiar,
# então é ele que vai primeiro — e a divergência é mostrada, porque é o tipo de
# coisa que confunde o próximo bring-up.
COMPAT=""
if [ -r /proc/device-tree/compatible ]; then
    COMPAT=$(tr '\000' ' ' </proc/device-tree/compatible | sed 's/ *$//')
fi

if [ -n "$COMPAT" ]; then
    pass "device tree (compatible): $COMPAT"
elif [ -n "$MODEL" ]; then
    warn "só o model disponível: $MODEL"
else
    fail "sem /proc/device-tree — kernel não carregou DTB?"
fi

if [ -n "$MODEL" ] && [ -n "$COMPAT" ]; then
    # MEDIDO NO X55 (08/11/2026): os dois dizem a MESMA coisa em convenções
    # diferentes — `/model` é o nome comercial ("Powkiddy x55") e `compatible`
    # é o do DT ("powkiddy,x55 rockchip,rk3566"). Comparados crus, um aparelho
    # saudável avisa sempre, e o aviso ensina o operador a ignorar o bloco.
    _norm() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9'; }
    case "$(_norm "$COMPAT")" in
        *"$(_norm "$MODEL")"*) ;;
        *)
            # Aviso, não falha: o sistema funciona; o rótulo é que mente.
            warn "model \"$MODEL\" não corresponde ao compatible (U-Boot sobrescreve /model)"
            ;;
    esac
fi

if [ -r /etc/giochi-system-release ]; then
    pass "release: $(read_or /etc/giochi-system-release)"
else
    warn "sem /etc/giochi-system-release"
fi

# ── entropia ─────────────────────────────────────────────────
# Sem TRNG o crng inicializa tarde e getrandom() bloqueia. Já medido em 11 s
# num boot e 1024 s em outro.
head2 "entropia"
RNG="$(read_or /sys/class/misc/hw_random/rng_current)"
if [ -n "$RNG" ] && [ "$RNG" != "none" ]; then
    pass "hwrng: $RNG"
else
    warn "sem hwrng — crng pode demorar; ver nó &rng no DTS"
fi

# ── armazenamento ────────────────────────────────────────────
head2 "armazenamento"
if command -v lsblk >/dev/null 2>&1; then
    pass "blocos: $(lsblk -dn -o NAME,SIZE 2>/dev/null | tr '\n' ' ')"
else
    skip "lsblk ausente"
fi
ROOT_DEV=$(awk '$2=="/" {print $1}' /proc/mounts 2>/dev/null | head -n 1)
if [ -n "$ROOT_DEV" ]; then
    pass "rootfs em $ROOT_DEV"
else
    fail "não achei o rootfs em /proc/mounts"
fi

# ── display / DRM ────────────────────────────────────────────
# Esta é a cadeia que mais falha, e onde o sintoma (tela preta) não diz nada
# sobre a causa. Por isso cada elo é verificado separadamente.
head2 "display (DRM)"

if [ -e /dev/dri/card0 ]; then
    pass "/dev/dri/card0 presente"
else
    fail "/dev/dri/card0 AUSENTE — sem console gráfico (suspeite do PHY DSI)"
fi

# Tamanho do painel, reportado como LINHA PRÓPRIA e cedo no bloco.
#
# Não é redundância com "conector ... connected 640x480" logo abaixo: foi esse
# número, 640x480, que explicou em 04/11/2026 por que a UI de 1280x720 aparecia
# com 25% de faixa preta e fonte pela metade. Quem abre um aparelho novo precisa
# dele primeiro, e no meio de uma lista de 20 linhas de PASS ele se perde.
#
# A proporção vai junto porque é o que decide o layout: 720x1280 é retrato
# (precisa de rotate=3), 640x480 é 4:3 e recebe UI 16:9 com faixa.
PAINEL=""
for c in /sys/class/drm/card0-*; do
    [ -d "$c" ] || continue
    [ "$(read_or "$c/status")" = "connected" ] || continue
    PAINEL=$(head -n 1 "$c/modes" 2>/dev/null)
    [ -n "$PAINEL" ] && break
done
if [ -n "$PAINEL" ]; then
    W=${PAINEL%x*}
    H=${PAINEL#*x}
    case "$W$H" in
        *[!0-9]*|"") pass "painel: $PAINEL" ;;
        *)
            if [ "$W" -gt "$H" ]; then ORI="paisagem"; else ORI="retrato"; fi
            # Proporção com aritmética INTEIRA, sem awk e sem ponto flutuante:
            # o alvo é busybox ash + busybox awk, e o §12.20 já mostrou que
            # função de gawk some em silêncio (strtonum devolvia vazio e o
            # teste "passava" com zero). Aqui não há o que degradar.
            R100=$(( (W * 100 + H / 2) / H ))
            RATIO="$((R100 / 100)).$(printf '%02d' "$((R100 % 100))")"
            pass "painel: $PAINEL ($ORI, $RATIO:1)"
            ;;
    esac
else
    warn "painel: sem modo anunciado por nenhum conector — driver de painel não subiu?"
fi

if [ -e /dev/dri/renderD128 ]; then
    pass "render node presente (3D disponível para processos)"
else
    # Diagnóstico com a CAUSA, não com o sintoma. Sem render node a Mesa cai no
    # `swrast` e continua respondendo "GLES 3.1" — medido no R35S em 06/11/2026,
    # onde a única diferença era `GL_RENDERER = softpipe`. Um aviso genérico
    # ("3D pode não inicializar") não leva a lugar nenhum; o nome do módulo leva.
    GPU_MOD=""
    for m in panfrost lima; do
        if ls /lib/modules/*/kernel/drivers/gpu/drm/$m/$m.ko* >/dev/null 2>&1; then
            GPU_MOD="$m"
            break
        fi
    done
    if [ -n "$GPU_MOD" ]; then
        warn "sem /dev/dri/renderD128 — '$GPU_MOD' existe em /lib/modules mas não está carregado: 3D cai no softpipe (CPU) com GL_VERSION idêntica. Use CONFIG_DRM_PANFROST=y, não =m"
    else
        warn "sem /dev/dri/renderD128 — nenhum driver de GPU no rootfs: 3D será software"
    fi
fi

DRM_DRIVER=""
[ -r /sys/class/drm/card0/device/driver ] && \
    DRM_DRIVER=$(basename "$(readlink -f /sys/class/drm/card0/device/driver 2>/dev/null)" 2>/dev/null)
[ -n "$DRM_DRIVER" ] && pass "driver DRM: $DRM_DRIVER" || warn "driver DRM não identificado"

CONNECTED=0
for c in /sys/class/drm/card0-*; do
    [ -d "$c" ] || continue
    st="$(read_or "$c/status")"
    name=$(basename "$c")
    [ "$st" = "connected" ] || continue
    CONNECTED=$((CONNECTED+1))
    mode=$(head -n 1 "$c/modes" 2>/dev/null)
    pass "conector $name: connected $mode"
done
[ "$CONNECTED" -eq 0 ] && fail "nenhum conector 'connected' — painel não subiu"

BL=""
for b in /sys/class/backlight/*; do
    [ -d "$b" ] || continue
    BL="$(read_or "$b/brightness")/$(read_or "$b/max_brightness")"
    break
done
[ -n "$BL" ] && pass "backlight: $BL" || warn "sem backlight em /sys/class/backlight"

# Orientação do console. O painel pode ser retrato (720x1280) enquanto o
# aparelho é usado em paisagem; sem rotação o texto sai deitado. E o parâmetro
# `fbcon=rotate:N` da linha de comando é IGNORADO EM SILÊNCIO quando o kernel não
# tem CONFIG_FRAMEBUFFER_CONSOLE_ROTATION — o kernel nem avisa. Por isso o teste
# olha o resultado, não a intenção.
FBCON_ROT=$(cat /sys/class/graphics/fbcon/rotate 2>/dev/null || echo "")
FB_SIZE=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null || echo "")
MODE_FIRST=$(ls /sys/class/drm/*/modes 2>/dev/null | head -n 1)
DRM_MODE=""
[ -n "$MODE_FIRST" ] && DRM_MODE=$(head -n 1 "$MODE_FIRST" 2>/dev/null)

# Quem de fato pegou o console. MEDIDO NO X55 (08/11/2026): com
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y — ligado de propósito para não
# haver janela preta antes do splash — o fbcon NÃO assume até alguém escrever no
# VT, e o getty está no `console` (serial), então ninguém escreve. O sysfs
# `fbcon/rotate` existe e vale 0 nos dois casos, então ele sozinho não distingue
# "rotação desligada" de "nada na tela". Quem distingue é o vtconsole.
FBCON_ATIVO=0
for _v in /sys/class/vtconsole/vtcon*/name; do
    [ -r "$_v" ] || continue
    case "$(cat "$_v" 2>/dev/null)" in
        "(M) frame buffer device"*) FBCON_ATIVO=1 ;;
    esac
done

if [ -n "$FBCON_ROT" ]; then
    # 90x80 = 720/8 por 1280/16: retrato nativo, rotação não aplicada.
    GEOM=$(dmesg 2>/dev/null | sed -n 's/.*frame buffer device \([0-9]*x[0-9]*\).*/\1/p' | head -n 1)
    if [ "$FBCON_ATIVO" -eq 0 ]; then
        warn "console de texto NÃO está na tela — o fbcon não assumiu (DEFERRED_TAKEOVER espera alguém escrever em /dev/tty0); rotação não se aplica a um console que não aparece"
    else
        case "$DRM_MODE" in
            720x1280)
                case "$FBCON_ROT" in
                    0) warn "console sem rotação (rotate=$FBCON_ROT${GEOM:+, $GEOM}) — painel é retrato, texto sai deitado" ;;
                    *) pass "console rotacionado (rotate=$FBCON_ROT${GEOM:+, $GEOM}) para painel retrato" ;;
                esac
                ;;
            *)
                pass "console rotate=$FBCON_ROT${GEOM:+, $GEOM} (painel ${DRM_MODE:-?})"
                ;;
        esac
    fi
else
    warn "sem /sys/class/graphics/fbcon/rotate — CONFIG_FRAMEBUFFER_CONSOLE_ROTATION desligado?"
fi

# Ferramenta de teste de botões: só existe se evtest estiver na imagem.
if command -v evtest >/dev/null 2>&1; then
    pass "evtest presente (base do giochi-buttons)"
else
    warn "evtest ausente — giochi-buttons não funciona (BR2_PACKAGE_EVTEST)"
fi

# ── render 3D ────────────────────────────────────────────────
head2 "render 3D"

# O driver do `card0` é o controlador de DISPLAY (`rockchip-drm`, `msm`…), não a
# GPU — perguntar a ele se a GPU existe dá WARN falso em aparelho saudável (o
# panfrost mora no render node, outro minor). A pergunta certa é qual driver
# atende o render node; `card0` fica como reserva para kernel sem render node.
GPU_DRIVER=""
if [ -e /sys/class/drm/renderD128/device/driver ]; then
    GPU_DRIVER=$(basename "$(readlink -f /sys/class/drm/renderD128/device/driver 2>/dev/null)" 2>/dev/null)
fi
if [ -z "$GPU_DRIVER" ]; then
    for c in /sys/class/drm/card*/device/driver; do
        [ -e "$c" ] || continue
        d=$(basename "$(readlink -f "$c" 2>/dev/null)" 2>/dev/null)
        case "$d" in
            panfrost|msm|etnaviv|lima|v3d|virtio_gpu|vgem|mali|kbase) GPU_DRIVER="$d"; break ;;
        esac
    done
fi

case "$GPU_DRIVER" in
    panfrost|msm|etnaviv|lima|v3d|virtio_gpu|vgem|mali|kbase)
        pass "driver de GPU reconhecido: $GPU_DRIVER" ;;
    "") warn "nenhum driver de GPU atendendo os dispositivos DRM — 3D seria software" ;;
    *)  warn "driver de GPU '$GPU_DRIVER' — não é GPU conhecida; 3D pode ser software" ;;
esac

# EGL/GLES: sem binário de teste não há como provar. Não fingir.
if command -v kmscube >/dev/null 2>&1; then
    if timeout 10 kmscube -D /dev/dri/card0 >/dev/null 2>&1; then
        pass "kmscube rodou (EGL/GLES + scanout OK)"
    else
        fail "kmscube falhou — EGL/GLES ou scanout quebrado"
    fi
else
    skip "kmscube ausente — não dá para provar 3D; habilitar BR2_PACKAGE_KMSCUBE"
fi

if [ -r /proc/meminfo ]; then
    pass "RAM: $(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo)"
fi

# ── bibliotecas que o launcher carrega ───────────────────────
#
# Um `libSDL2_ttf` sem `libharfbuzz` por trás NÃO falha ao abrir: ele só faz
# shaping errado, em silêncio. E um `libasound` ausente mata o launcher no
# `dlopen` inicial, com mensagem que não diz qual biblioteca faltou.
#
# Estas quatro são as que o launcher precisa. A ordem importa: SDL2_ttf é
# inútil sem freetype, então as duas são reportadas juntas.
head2 "bibliotecas do launcher"

# ARMADILHA MEDIDA: `ls /usr/lib/x.so* /lib/x.so*` retorna NÃO-ZERO quando o
# padrão de UM dos diretórios não casa — mesmo que o outro exista. A primeira
# versão disto deu 5 FAILs falsos num aparelho onde as cinco bibliotecas
# estavam em /usr/lib. Cada caminho tem de ser testado sozinho.
lib_existe() {
    for dir in /usr/lib /lib; do
        if ls "$dir/$1".so* >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

for lib in libasound libfreetype libharfbuzz libSDL2-2.0 libSDL2_ttf; do
    if lib_existe "$lib"; then
        pass "$lib"
    else
        fail "$lib ausente — o launcher não inicia ou quebra em runtime"
    fi
done

# HarfBuzz ligado no SDL2_ttf? A biblioteca sozinha não prova nada: o
# sdl2_ttf 2.22 é configurado com --disable-harfbuzz por padrão, e o
# `BR2_PACKAGE_HARFBUZZ=y` só troca isso se o pacote for RECONFIGURADO —
# num build retomado ele não é. Medido neste repositório: a lib estava na
# imagem e o TTF_USE_HARFBUZZ continuava 0.
#
# `readelf -d` seria a prova exata (entrada NEEDED), mas o binutils NÃO está na
# imagem: `BR2_PACKAGE_BINUTILS_TARGET=y` instala a toolchain inteira no target
# (ar, as, ld, objdump, strip…) só para um diagnóstico. Medido no X35H em
# 04/11: o bloco saía sempre `[SKIP]`, justamente no item que importa.
#
# A saída não é instalar binutils nem se contentar com busca de string: o
# LOADER DINÂMICO faz o mesmo trabalho e já está em toda imagem dinâmica.
#
#     /lib/ld-linux-aarch64.so.1 --list /usr/lib/libSDL2_ttf-2.0.so.0
#
# Isso imprime as dependências que o loader RESOLVE — o mesmo conjunto que
# `readelf -d` mostra como NEEDED, mais `linux-vdso.so.1` e o próprio loader.
# Medido no host contra `libpng16`: `--list` deu libz/libm/libc, idêntico ao
# `readelf -d`. Nenhum pacote novo, nenhum binário a mais.
#
# Então há TRÊS caminhos, e eles provam coisas diferentes — por isso o texto do
# PASS diz qual foi usado:
#
#   readelf -d     NEEDED  → prova que o ligador exigiu a libharfbuzz
#   ld.so --list   resolve → prova que o loader a resolve AGORA; pega também
#                            biblioteca NEEDED que não está instalada
#   grep -a        soname → prova que o nome está no binário. Para `.dynstr`
#                           isso é o mesmo que NEEDED na prática; o que ele não
#                           distingue é um `dlopen()` opcional, que o
#                           SDL2_ttf não faz.
#
# Um FAIL falso aqui seria pior que SKIP: some com a confiança no bloco.
TTF_LIB=""
for dir in /usr/lib /lib; do
    for cand in "$dir"/libSDL2_ttf-2.0.so.0 "$dir"/libSDL2_ttf.so; do
        [ -e "$cand" ] || continue
        TTF_LIB="$cand"
        break
    done
    [ -n "$TTF_LIB" ] && break
done

# O loader tem nome por arquitetura. Procuramos em vez de fixar para não
# quebrar o selftest se ele mudar de lugar numa atualização de toolchain.
LOADER=""
for cand in /lib/ld-linux-aarch64.so.1 /lib/ld-linux.so.3 /lib/ld-linux-armhf.so.3 \
            /lib/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2; do
    [ -x "$cand" ] && { LOADER="$cand"; break; }
done

if [ -n "$TTF_LIB" ]; then
    if command -v readelf >/dev/null 2>&1; then
        if readelf -d "$TTF_LIB" 2>/dev/null | grep -q libharfbuzz; then
            pass "SDL2_ttf com harfbuzz (NEEDED, readelf) — shaping complexo ativo"
        else
            warn "SDL2_ttf SEM harfbuzz (NEEDED, readelf) — script complexo sai errado"
        fi
    else
        # ARMADILHA MEDIDA (forjando um ELF com NEEDED para lib inexistente): o
        # loader NÃO escreve a lista quando uma dependência falta — ele aborta
        # com `error while loading shared libraries` e exit 127. Um
        # `--list | grep -q libharfbuzz` simplesmente devolve falso, e a
        # cascata cairia no `grep -a` do binário, que ACHA o soname e daria
        # PASS — falso positivo no caso exato que importa (biblioteca pedida e
        # ausente). Por isso o exit code é lido:
        PEDE=0
        grep -aq 'libharfbuzz\.so' "$TTF_LIB" 2>/dev/null && PEDE=1
        LISTA=""
        LOADER_OK=0
        if [ -n "$LOADER" ]; then
            LISTA="$("$LOADER" --list "$TTF_LIB" 2>&1)" && LOADER_OK=1
        fi
        if [ "$LOADER_OK" = 1 ]; then
            if printf '%s\n' "$LISTA" | grep -q 'libharfbuzz.*not found'; then
                warn "SDL2_ttf pede harfbuzz e o loader NÃO a resolve — instale libharfbuzz"
            elif printf '%s\n' "$LISTA" | grep -q 'libharfbuzz'; then
                pass "SDL2_ttf com harfbuzz (resolvido pelo loader) — shaping complexo ativo"
            elif [ "$PEDE" = 1 ]; then
                warn "SDL2_ttf menciona harfbuzz mas o loader não a lista — verifique libharfbuzz"
            else
                warn "SDL2_ttf SEM harfbuzz — script complexo sai errado (loader lista, sem harfbuzz)"
            fi
        elif [ "$PEDE" = 1 ]; then
            warn "SDL2_ttf pede harfbuzz e o loader falhou ao resolver — dependência ausente"
        elif [ -n "$LOADER" ]; then
            warn "SDL2_ttf SEM harfbuzz — script complexo sai errado (loader falhou)"
        else
            warn "SDL2_ttf SEM harfbuzz — script complexo sai errado (sem readelf nem loader)"
        fi
    fi
else
    skip "libSDL2_ttf não encontrada — nada a provar sobre harfbuzz"
fi

# Fontes: o diretório existir não prova nada (dejavu.mk cria vazio sem família).
FONTS=$(ls /usr/share/fonts/dejavu/*.ttf 2>/dev/null | wc -l)
if [ "$FONTS" -gt 0 ]; then
    pass "fontes: $FONTS arquivo(s) .ttf em /usr/share/fonts/dejavu"
else
    fail "nenhuma .ttf instalada — TTF_OpenFont falha e o launcher desenha vazio"
fi

if [ -r /proc/meminfo ]; then
    pass "RAM: $(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo)"
fi

# ── entrada ──────────────────────────────────────────────────
head2 "entrada"

EVENTS=$(ls /dev/input/event* 2>/dev/null | wc -l)
if [ "$EVENTS" -gt 0 ]; then
    pass "$EVENTS dispositivo(s) /dev/input/event*"
else
    fail "nenhum /dev/input/event* — sem controle"
fi

for n in /sys/class/input/event*/device/name; do
    [ -r "$n" ] || continue
    say "         nome: $(read_or "$n")"
done

# Conta os controles de verdade, em vez de assumir. O mapa de botões só serve
# para algo se o kernel entregar os códigos: um `buttons.map` com 31 entradas e
# nenhum dispositivo de gamepad é um mapa apontando para o vazio.
count_bits() {
    # capabilities/key e capabilities/abs são bitmaps em hex, palavra de maior
    # peso primeiro. Conta os bits ligados dígito a dígito com `index`/`substr`:
    # `strtonum` é extensão do gawk e NÃO existe no awk do busybox, que é o que
    # roda neste rootfs — usar strtonum aqui devolveria vazio em silêncio.
    awk '{
        digits = "0123456789abcdef"
        weight = "0112122312233344"
        total = 0
        for (i = 1; i <= NF; i++) {
            w = tolower($i)
            for (j = 1; j <= length(w); j++) {
                p = index(digits, substr(w, j, 1))
                if (p > 0) total += substr(weight, p, 1) + 0
            }
        }
        print total
    }'
}

# ## Três origens de gamepad, não uma
#
# O nome do dispositivo de entrada depende do DRIVER, e cada aparelho usa um:
#
#   gpio-keys-control   botões por GPIO direto (X55, X35H)
#   adc-joystick        um canal de ADC por eixo (mainline)
#   r36s_Gamepad        multiplexador atrás de um canal só (R35S, rocknix-joypad)
#
# Contar só os dois primeiros dava **dois FAIL falsos** no R35S em 06/11/2026,
# com `r36s_Gamepad` registrado em `event1` e os 19 botões e 4 eixos
# funcionando. É a classe do §12.30 e §12.34: o teste perguntou a coisa errada,
# e FAIL falso custa a confiança no bloco inteiro.
#
# Aqui a pergunta passa a ser a CONSEQUÊNCIA: quantos BTN_/ABS_ este dispositivo
# declara em `capabilities/`, seja qual for o driver que o criou.
PAD_BUTTONS=0
PAD_AXES=0
PAD_ORIGEM=""
for dev in /sys/class/input/event*/device; do
    [ -r "$dev/name" ] || continue
    [ -r "$dev/capabilities/key" ] || continue
    name=$(read_or "$dev/name")

    # Teclado e controle de volume não são gamepad: o mapa de botões não os
    # descreve. Filtrar por nome conhecido é mais seguro que contar tudo.
    case "$name" in
        gpio-keys-control|adc-joystick|*Gamepad*|*gamepad*|*joypad*)
            ;;
        *)
            continue
            ;;
    esac

    bts=$(count_bits < "$dev/capabilities/key" 2>/dev/null)
    axs=0
    [ -r "$dev/capabilities/abs" ] && axs=$(count_bits < "$dev/capabilities/abs" 2>/dev/null)
    # Fica com o dispositivo que tem MAIS botões: um aparelho pode ter um nó
    # auxiliar (volume) que também casa por nome.
    if [ "${bts:-0}" -gt "${PAD_BUTTONS:-0}" ]; then
        PAD_BUTTONS=$((${bts:-0} + 0))
        PAD_ORIGEM=$name
    fi
    if [ "${axs:-0}" -gt "${PAD_AXES:-0}" ]; then
        PAD_AXES=$((axs + 0))
    fi
done

# Quantos botões de gamepad o `buttons.map` trata como OBRIGATÓRIOS.
#
# O kernel declara 17 (o patch 0002 acrescenta o BTN_MODE), mas o gabarito físico
# desta revisão tem 16: o botão `F` não existe. O mapa marca essa entrada como
# OPCIONAL e é ele que manda — exigir 17 aqui deixaria o teste falhando para
# sempre, e um vermelho permanente esconde um botão realmente quebrado.
MAP_FILE=/etc/giochi/buttons.map
MAP_GAMEPAD=0
if [ -r "$MAP_FILE" ]; then
    MAP_GAMEPAD=$(awk '
        {
            opc = (tolower($0) ~ /opcional/)
            sub(/#.*/, "")
            if (index($0, "=") == 0) next
            split($0, par, "=")
            codigo = par[2]
            gsub(/[ \t]/, "", codigo)
            if (codigo ~ /^BTN_/) {
                if (opc) nopt++
                else total++
            }
        }
        END { print total + 0 }
    ' "$MAP_FILE" 2>/dev/null)
fi

if [ "${PAD_BUTTONS:-0}" -gt 0 ] && [ "$MAP_GAMEPAD" -gt 0 ] && [ "$PAD_BUTTONS" -lt "$MAP_GAMEPAD" ]; then
    fail "botões de gamepad: $PAD_BUTTONS declarados — o mapa exige $MAP_GAMEPAD"
elif [ "${PAD_BUTTONS:-0}" -gt 0 ]; then
    EXTRA=$((PAD_BUTTONS - MAP_GAMEPAD))
    if [ "$EXTRA" -gt 0 ]; then
        pass "botões de gamepad: $PAD_BUTTONS declarados ($MAP_GAMEPAD obrigatórios + $EXTRA opcional(is))"
    else
        pass "botões de gamepad: $PAD_BUTTONS ($PAD_ORIGEM)"
    fi
else
    fail "nenhum dispositivo de gamepad (gpio-keys-control, adc-joystick ou *Gamepad)"
fi

# Os 4 eixos vêm de `adc-joystick`; sem CONFIG_JOYSTICK_ADC ele nem aparece.
if [ "${PAD_AXES:-0}" -ge 4 ]; then
    pass "eixos analógicos: $PAD_AXES (ABS_*)"
elif [ "${PAD_AXES:-0}" -gt 0 ]; then
    fail "eixos analógicos: $PAD_AXES — esperado 4 (ABS_X/Y/RX/RY)"
else
    fail "sem eixos analógicos — nenhum ABS_* no gamepad (JOYSTICK_ADC ou joypad fora da árvore?)"
fi

if [ -r /etc/giochi/buttons.map ]; then
    MAPS=$(grep -c '=' /etc/giochi/buttons.map 2>/dev/null)
    pass "/etc/giochi/buttons.map ($MAPS entradas)"
else
    fail "/etc/giochi/buttons.map AUSENTE — launcher usaria o padrão embutido"
fi

# ── áudio ────────────────────────────────────────────────────
head2 "áudio"

if [ -r /proc/asound/cards ]; then
    # `[[:space:]]` e não `\s`: `\s` é extensão do GNU grep, e o alvo desta
    # imagem é o busybox (§12.20). Onde ele não é aceito, `^\s*[0-9]` vira
    # "zero ou mais letras `s` seguidas de dígito" — e as linhas de
    # `/proc/asound/cards` começam com ESPAÇO, então a contagem dava zero e o
    # veredito era `FAIL nenhuma placa de som` num aparelho com som.
    CARDS=$(grep -c '^[[:space:]]*[0-9]' /proc/asound/cards 2>/dev/null)
    if [ "${CARDS:-0}" -gt 0 ]; then
        pass "placas de som: $(grep '^[[:space:]]*[0-9]' /proc/asound/cards | sed 's/^[[:space:]]*//' | tr '\n' ' ')"
    else
        fail "nenhuma placa de som — asoc provavelmente em deferred probe"
    fi
else
    fail "sem /proc/asound — ALSA não carregou"
fi

# O `Playback Mux` do RK817 tem DOIS valores (HP | SPK) e a escolha certa depende
# do roteamento do DTS — não é a mesma em todo aparelho. Este bloco dizia
# "precisa estar em HP" com a justificativa da X55 ("o SPK DAC é class-D interno e
# não está roteado nesta placa"), e isso é FALSO no R35S, cujo DTS roteia
# `Speaker -> SPKO` e `Headphones -> HPOL/HPOR`. Resultado medido em 06/11/2026: o
# R35S dava `[PASS] Playback Mux = HP` com o falante potencialmente mudo — um PASS
# falso, que é pior que FAIL porque encerra a investigação.
#
# A expectativa agora vem do próprio device tree, que é a fonte da verdade do
# roteamento:
#   X55   : "Speaker Amp INL" -> HPOL   (amp alimentado por HPOL)  => Mux = HP
#   R35S  : "Speaker"         -> SPKO   (falante no SPKO)          => Mux = SPK
#
# `amixer` existe no Buildroot — como SUBOPÇÃO do `alsa-utils`, desligada por
# padrão (§12.16). Durante onze revisões este comentário dizia que ele "não
# existe", porque "não empacotado" e "empacotado e desligado" dão o mesmo
# sintoma numa imagem. Hoje ele está nos defconfigs dos aparelhos com tela.
#
# O caminho principal continua sendo o `alsactl store`: ele é o mecanismo que o
# ALSA prevê para APLICAR estado de placa (é o que o `S51mixer` usa), e o
# formato é um arquivo versionável. O `amixer` é a reserva, para o caso de uma
# imagem construída sem a subopção.
EXPECT_MUX=""
EXPECT_WHY=""
# Globs, e NÃO `find`: o `find` do busybox não desce em `/proc/device-tree`
# (`find /proc/device-tree -maxdepth 1` devolve só a raiz). Medido no R35S em
# 06/11/2026 — a versão com `find` não achava o nó e o bloco caía no WARN
# "não permitiu decidir", que parece um dado ausente e é a ferramenta errada.
# Dois níveis cobrem o nó na raiz (`rk817-sound`) e sob um pai (`sound`).
for f in /proc/device-tree/*/simple-audio-card,routing \
         /proc/device-tree/*/*/simple-audio-card,routing; do
    [ -r "$f" ] || continue
    PARSED=$(tr '\0' '\n' < "$f" 2>/dev/null | awk '
        NR % 2 == 1 { src = $0; next }
        {
            if (src ~ /[Ss]peaker/) {
                if ($0 ~ /^SPK/) { print "SPK|" src " -> " $0; exit }
                if ($0 ~ /HPO/)  { print "HP|"  src " -> " $0; exit }
            }
        }
    ' 2>/dev/null)
    if [ -n "$PARSED" ]; then
        EXPECT_MUX=${PARSED%%|*}
        EXPECT_WHY=${PARSED#*|}
        break
    fi
done

MUX=""
if command -v amixer >/dev/null 2>&1; then
    MUX=$(amixer sget "Playback Mux" 2>/dev/null | sed -n "s/.*Item0: '\([A-Z]*\)'.*/\1/p" | head -n 1)
fi
if [ -z "$MUX" ] && command -v alsactl >/dev/null 2>&1; then
    STATE=/tmp/giochi-mixer.state
    if alsactl -f "$STATE" store >/dev/null 2>&1; then
        # O bloco é: name 'Playback Mux' / value <X>. Pega o value seguinte.
        MUX=$(awk "
            /name .Playback Mux./ { achou = 1; next }
            achou && /value / { print \$2; exit }
        " "$STATE" 2>/dev/null)
        rm -f "$STATE"
    fi
fi
if [ -n "$MUX" ]; then
    if [ -z "$EXPECT_MUX" ]; then
        warn "Playback Mux = $MUX — roteamento do DTS não permitiu decidir o esperado (confira 'Speaker' em simple-audio-card,routing)"
    elif [ "$MUX" = "$EXPECT_MUX" ]; then
        pass "Playback Mux = $MUX (casa com o DTS: $EXPECT_WHY)"
    else
        fail "Playback Mux = $MUX — o DTS roteia '$EXPECT_WHY', então precisa ser $EXPECT_MUX (em $MUX o falante fica MUDO)"
    fi
elif command -v alsactl >/dev/null 2>&1 || command -v amixer >/dev/null 2>&1; then
    warn "controle 'Playback Mux' não encontrado no mixer"
else
    skip "sem amixer e sem alsactl"
fi

# ── USB ──────────────────────────────────────────────────────
head2 "USB"
UDC=$(ls /sys/class/udc 2>/dev/null)
if [ -n "$UDC" ]; then
    pass "UDC: $UDC · estado $(read_or /sys/class/udc/$UDC/state)"
else
    warn "sem UDC — sem gadget USB (rede por USB/SSH indisponível)"
fi

# ── rede por cabo USB: o canal de acesso padrão ──────────────
#
# Este bloco vem ANTES de "rede" de propósito. Na maioria dos aparelhos não há
# Wi-Fi nem Bluetooth, e console serial exige hardware que quase ninguém tem.
# Se o usb0 não subir, o aparelho está inacessível — é o FAIL mais grave desta
# seção, e não um detalhe no meio de uma lista.
head2 "rede por USB (canal de acesso padrão)"

# ATENÇÃO: `/sys/class/net/usb0` é symlink PENDURADO no kernel 6.12 do X35H —
# `ls` mostra a entrada, mas `[ -e ]`/`[ -d ]` e a leitura de `operstate` falham
# (o `net/` do gadget não existe no sysfs, embora o netdev funcione e o SSH
# responda por ele). A fonte confiável é o `ip`, com o sysfs só como reserva.
usb0_existe() {
    if command -v ip >/dev/null 2>&1; then
        ip -o link show usb0 >/dev/null 2>&1 && return 0
    fi
    [ -e /sys/class/net/usb0/operstate ] && return 0
    return 1
}

if usb0_existe; then
    USB0_STATE="$(read_or /sys/class/net/usb0/operstate)"
    [ -n "$USB0_STATE" ] || USB0_STATE="$(ip -o link show usb0 2>/dev/null | sed 's/.*state \([A-Z_]*\).*/\1/' | head -1)"
    [ -n "$USB0_STATE" ] || USB0_STATE="desconhecido"
    # `ip` devolve UP em MAIÚSCULAS; sysfs devolve minúsculas. Normalizar evita
    # o rótulo errado de "cabo desconectado" num link ativo.
    USB0_STATE=$(printf '%s' "$USB0_STATE" | tr 'A-Z' 'a-z')
    USB0_ADDR=""
    # `ip -4 -o addr show usb0` é a forma estável; ifconfig varia entre applets.
    if command -v ip >/dev/null 2>&1; then
        USB0_ADDR="$(ip -4 -o addr show usb0 2>/dev/null | awk '{print $4}' | head -1)"
    fi
    if [ -z "$USB0_ADDR" ]; then
        # Interface existe mas sem IP: o gadget montou e o endereço não entrou.
        fail "usb0 existe mas SEM IP — o SSH por cabo não atende"
    elif [ "$USB0_STATE" = "up" ] || [ "$USB0_STATE" = "unknown" ]; then
        pass "usb0: $USB0_ADDR ($USB0_STATE) — ssh root@${USB0_ADDR%%/*}"
    else
        # `down` aqui NAO é defeito: o netdev do gadget é criado no boot e a
        # operstate só sobe quando um host energiza o barramento. Sem cabo
        # plugado, `down` é o estado correto — e o aparelho continua bootando
        # e funcionando. Marcar FAIL aqui seria o vermelho permanente que
        # esconde defeito real (ver AGENTS §12.22).
        pass "usb0: $USB0_ADDR pronto (link $USB0_STATE — cabo desconectado)"
    fi

    # `pidof`, não pidfile: medido no X35H, o udhcpd do busybox está rodando
    # (pid 176) e NÃO deixa /var/run/udhcpd.pid. O pidfile como critério dava
    # "udhcpd parado" num servidor que havia acabado de dar IP ao PC.
    if pidof udhcpd >/dev/null 2>&1; then
        # Sem `grep -c ... || echo 0`: `grep -c` SEM casa imprime `0` **e** sai 1,
        # então o `|| echo 0` produzia "0\n0" — e essa string, que não é número,
        # é o defeito do §12.56. Aqui o valor não é usado para decidir nada (só
        # o `pidof` decide), então a variável saiu de vez em vez de virar uma
        # contagem que ninguém lê.
        pass "udhcpd ativo (pid $(pidof udhcpd | cut -d' ' -f1)) — o PC recebe IP sozinho"
    else
        # Sem udhcpd ainda dá para conectar, mas exige IP estático no PC.
        warn "udhcpd parado — o PC precisa de IP estático 10.55.0.1/24"
    fi
else
    if [ -n "${UDC:-}" ]; then
        fail "sem usb0 apesar de haver UDC — rode 'giochi-usbnet' e veja o erro"
    else
        warn "sem usb0 e sem UDC — o aparelho não está em modo dispositivo"
    fi
fi

# Porta USB HOST: é onde o dongle Wi-Fi entra nos aparelhos sem rádio onboard.
# Sem controlador host em modo "host", o dongle é plugado e nada acontece.
HOST_USB=0
for u in /sys/bus/platform/drivers/dwc3/*.usb /sys/bus/platform/drivers/dwc3/*/*.usb; do
    [ -r "$u/mode" ] || continue
    [ "$(cat "$u/mode" 2>/dev/null)" = "host" ] && HOST_USB=1
done
for u in /sys/bus/usb/devices/usb*; do
    [ -d "$u" ] && HOST_USB=1
done
if [ "$HOST_USB" = "1" ]; then
    pass "porta USB host disponível (dongle Wi-Fi pode ser plugado)"
else
    warn "sem porta USB host — dongle Wi-Fi não teria onde entrar"
fi

# Dongle plugado? Só reporta o que está lá; não exige nada — num aparelho sem
# rádio onboard é normal não ter wlan0. O nome que o cfg80211 dá é wlan0/wlan1
# (o onboard da X55 também é wlan0, então este bloco não distingue os dois).
if [ -d /sys/class/net/wlan0 ]; then
    pass "wlan0 presente ($(read_or /sys/class/net/wlan0/address))"
else
    skip "sem wlan0 — nenhum dongle plugado (ou sem rádio onboard)"
fi

# Os módulos de dongle existem na imagem? Sem eles, plugar não faz nada e
# nenhuma mensagem explica.
if [ -d /lib/modules ]; then
    MODS=$(find /lib/modules -name 'rtl8xxxu*' -o -name 'mt7601u*' -o -name 'ath9k_htc*' 2>/dev/null | wc -l)
    if [ "$MODS" -gt 0 ]; then
        pass "módulos de dongle Wi-Fi: $MODS arquivo(s) (rtl8xxxu/mt7601u/ath9k_htc)"
    else
        fail "sem módulo de dongle Wi-Fi — plugar não tem efeito nenhum"
    fi
fi

# Servidor SSH: é o que o usb0 existe para servir.
if pidof sshd >/dev/null 2>&1; then
    pass "sshd rodando (porta 22)"
elif [ -x /usr/sbin/sshd ]; then
    fail "sshd instalado mas NÃO rodando — o aparelho fica inacessível"
else
    fail "sshd ausente da imagem"
fi

# Dois servidores SSH na mesma porta é um erro que já aconteceu aqui: o
# dropbear e o openssh vinham juntos, cada um com seu S50*, e o segundo a subir
# falhava. O sintoma é "ssh às vezes não responde", dependendo da ordem.
if [ -x /usr/sbin/dropbear ] && [ -x /usr/sbin/sshd ]; then
    fail "dropbear E openssh na imagem — os dois disputam a porta 22"
fi

# ── rede ─────────────────────────────────────────────────────
head2 "rede"
IFACES=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | tr '\n' ' ')
if [ -n "$IFACES" ]; then
    pass "interfaces: $IFACES"
else
    warn "nenhuma interface além de lo"
fi

# ── energia ──────────────────────────────────────────────────
head2 "energia"
BAT=""
BAT_PRESENTE=""
for p in /sys/class/power_supply/*; do
    [ "$(read_or "$p/type")" = "Battery" ] || continue
    # MEDIDO NO X55 (08/11/2026): `present=0` com `capacity=0` é o aparelho SEM
    # célula — sem chicote, sem bateria. Reportar "0%" manda o operador carregar
    # um aparelho que não tem o que carregar, e é indistinguível de bateria
    # arriada, onde a ação é outra. O atributo é opcional, então vazio = presente.
    BAT_PRESENTE="$(read_or "$p/present")"
    BAT="$(read_or "$p/capacity")% ($(read_or "$p/status"))"
    break
done
if [ -n "$BAT" ] && [ "$BAT_PRESENTE" = "0" ]; then
    warn "bateria AUSENTE (present=0) — sem célula neste aparelho; 'capacidade 0%' aqui não é bateria vazia"
elif [ -n "$BAT" ]; then
    pass "bateria: $BAT"
else
    warn "sem bateria detectada"
fi

TEMP=""
for t in /sys/class/thermal/thermal_zone*; do
    [ -r "$t/temp" ] || continue
    TEMP="$(( $(read_or "$t/temp") / 1000 ))C"
    break
done
[ -n "$TEMP" ] && pass "temperatura: $TEMP" || warn "sem zona térmica"

# ── relógio ──────────────────────────────────────────────────
# A equipe do app perguntou em 06/11/2026 se o aparelho "tem como guardar hora".
# A resposta é SIM nos três aparelhos desta árvore (rk808-rtc / rk817-rtc), mas
# ela depende de três coisas que falham em silêncio: o driver no kernel, o
# `hwclock` do busybox, e alguém gravar de volta. Perguntar só "existe
# /dev/rtc0" daria PASS num aparelho cujo RTC está em 1970 — o defeito que
# importa para licença com prazo é a HORA, não o nó.
if [ -e /dev/rtc0 ] || [ -d /sys/class/rtc/rtc0 ]; then
    RTC_NOME="$(read_or /sys/class/rtc/rtc0/name)"
    ANO="$(date +%Y 2>/dev/null)"
    case "$ANO" in
        ''|*[!0-9]*) warn "RTC $RTC_NOME presente, mas a data do sistema é ilegível" ;;
        *)
            # Mesmo piso do S50hwclock: antes do ano de construção da imagem é
            # impossível estar certo. Vem do build, não de constante escrita à mão.
            PISO="$(sed -n 's/^built_at_utc=\([0-9]\{4\}\)-.*/\1/p' /etc/giochi/build-info.txt 2>/dev/null | head -1)"
            [ -n "$PISO" ] || PISO=2024
            if [ "$ANO" -lt "$PISO" ]; then
                warn "relógio em $ANO, antes de $PISO — RTC $RTC_NOME existe mas o sistema nasceu com data errada"
                say "        não é falta de RTC: ninguém acertou o relógio ainda (S50hwclock grava no desligamento)"
            else
                pass "relógio: $(date '+%Y-%m-%d %H:%M') · RTC $RTC_NOME"
            fi
            ;;
    esac
else
    warn "sem /dev/rtc0 — a hora não sobrevive ao desligamento"
fi

# ── camada Giochi ────────────────────────────────────────────
head2 "camada Giochi"

# Quem chama o giochi-init é o /etc/inittab, por `respawn` — ele nunca é PID 1
# (PID 1 é o init do busybox). A pergunta certa é "existe a linha?", não
# "é PID 1?", que nunca seria verdade e daria WARN eterno.
LAUNCHER=/opt/giochi/apps/launcher/bin/giochi-launcher
if [ -x /usr/bin/giochi-init ]; then
    if grep -q '^::respawn:/usr/bin/giochi-init$' /etc/inittab 2>/dev/null; then
        pass "inittab chama giochi-init (respawn)"
    elif [ -x "$LAUNCHER" ] || [ -f /etc/giochi/boot-layer ]; then
        # O launcher (ou o marcador) pede a camada de boot e ela não está ligada:
        # o launcher nunca subiria, e nada no boot diria por quê.
        fail "inittab NÃO chama giochi-init — o launcher não sobe"
    else
        # Sem launcher, é o estado correto: a linha só entra quando há o que
        # iniciar. Não é falha.
        pass "giochi-init pronto (sem launcher: camada de boot desligada)"
    fi
else
    fail "giochi-init ausente"
fi

if [ -x "$LAUNCHER" ]; then
    pass "launcher: $LAUNCHER"

    # O `giochi-init` para de reiniciar depois de RESTART_MAX quedas e dorme.
    # Isso é correto contra laço de crash e, sem aviso, o resultado em campo é
    # "aparelho ligado, tela parada, nenhum erro" — foi o que a equipe do app
    # relatou em 06/11/2026. O arquivo transforma o silêncio em diagnóstico.
    PARADA_FILE="${GIOCHI_PARADA_FILE:-/run/giochi/launcher-parado}"
    if [ -r "$PARADA_FILE" ]; then
        fail "giochi-init DESISTIU de reiniciar o launcher: $(tr '\n' ' ' <"$PARADA_FILE")"
    fi

    # O launcher é o dono do DRM master. Se ele está vivo, o processo aparece em
    # /proc — e aqui não vale `ps`: a imagem tem procps-ng, cujo `ps` sem
    # argumento mostra só os processos da MESMA TTY (§12.46). Foi assim que a
    # equipe do app concluiu "o launcher não está rodando" com ele na tela.
    LAUNCHER_VIVO=0
    for cmdline in /proc/[0-9]*/cmdline; do
        # O processo pode sumir entre o glob e o `open` (é /proc): o redirect
        # falha e polui a saída com "No such file". Silêncio é o certo aqui.
        cmd="$(tr '\0' ' ' <"$cmdline" 2>/dev/null)"
        pid="${cmdline#/proc/}"
        pid="${pid%/cmdline}"
        # Fora a si mesmo e o pai: se alguém rodar este teste de um shell cuja
        # linha de comando cite "giochi-launcher" (um `grep`, um `sh -c`), o
        # processo entraria na contagem e um launcher MORTO passaria por vivo —
        # o mesmo tipo de falso negativo que o §12.46 descreve.
        case "$pid" in "$$"|"$PPID") continue ;; esac
        case "$cmd" in
            *giochi-launcher*) LAUNCHER_VIVO=$((LAUNCHER_VIVO + 1)) ;;
        esac
    done
    if [ "$LAUNCHER_VIVO" -eq 0 ] && [ ! -r "$PARADA_FILE" ]; then
        warn "launcher instalado mas nenhum processo rodando (lido de /proc, não de ps)"
    fi
else
    skip "sem launcher empacotado (/opt/giochi/apps/launcher)"
fi

if [ -r /opt/giochi/apps/index.json ]; then
    pass "catálogo de apps: $(grep -c '"id"' /opt/giochi/apps/index.json) app(s)"
else
    warn "sem /opt/giochi/apps/index.json — a grade ficaria vazia"
fi

# ── resumo ───────────────────────────────────────────────────
say ""
say "════════════════════════════════════════"
say "  PASS $PASS · WARN $WARN · FAIL $FAIL · SKIP $SKIP"
say "════════════════════════════════════════"

if [ "$FAIL" -gt 0 ]; then
    say ""
    say "Há falha(s). Ordem de investigação, do mais provável:"
    say "  1. tela preta        -> DTB errado, não kernel (ver docs/troubleshooting.md)"
    say "  2. sem /dev/dri      -> CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y (nunca =m)"
    say "  3. mudou o Mux       -> Playback Mux casa com o roteamento do DTS (HP ou SPK)"
    say "  4. sem botão         -> buttons.map e o driver do joypad"
    exit 1
fi

exit 0
