#!/bin/sh
# giochi-selftest — verifica se o hardware e as camadas de software estão
# acordando, do kernel até o render 3D.
#
# Roda no APARELHO, não no PC. Serve para responder uma pergunta só:
# "este aparelho está convergindo?" — e produzir um relatório que dá para
# colar numa issue.
#
# POSIX sh (busybox ash). Sem dependência obrigatória: cada checagem degrada
# para SKIP quando a ferramenta não existe na imagem.
#
# Uso:
#   giochi-selftest              # relatório no terminal
#   giochi-selftest > r.txt      # salvar
#   giochi-selftest --quiet      # só as falhas
#
# Saída: PASS (funciona), WARN (parcial / a conferir), FAIL (não funciona),
# SKIP (não aplicável ou ferramenta ausente). Exit 1 se houver FAIL.

QUIET=0
[ "$1" = "--quiet" ] && QUIET=1

PASS=0; WARN=0; FAIL=0; SKIP=0

say() { [ "$QUIET" -eq 1 ] && return 0; printf '%s\n' "$*"; }
pass() { PASS=$((PASS+1)); say "  [PASS] $*"; }
warn() { WARN=$((WARN+1)); say "  [WARN] $*"; }
fail() { FAIL=$((FAIL+1)); say "  [FAIL] $*"; }
skip() { SKIP=$((SKIP+1)); say "  [SKIP] $*"; }
head2() { say ""; say "── $* ──"; }

read_or() {
    # read_or <arquivo> — primeira linha, ou vazio
    [ -r "$1" ] || return 0
    head -n 1 "$1" 2>/dev/null
}

now() { date '+%Y-%m-%d %H:%M:%S' 2>/dev/null; }

say "Giochi self-test"
say "  quando: $(now)"
say "  host:   $(hostname 2>/dev/null)"
say "  kernel: $(uname -srv 2>/dev/null)"

# ── identidade ───────────────────────────────────────────────
head2 "identidade do aparelho"

MODEL=""
if [ -r /proc/device-tree/model ]; then
    # termina em NUL: cortar no primeiro zero
    MODEL=$(tr -d '\000' </proc/device-tree/model)
fi

if [ -n "$MODEL" ]; then
    pass "device tree: $MODEL"
else
    fail "sem /proc/device-tree/model — kernel não carregou DTB?"
fi

if [ -r /etc/giochi-system-release ]; then
    pass "release: $(read_or /etc/giochi-system-release)"
else
    warn "sem /etc/giochi-system-release"
fi

# ── entropia ─────────────────────────────────────────────────
# Sem TRNG o crng inicializa tarde e getrandom() bloqueia. Já medido em 11 s
# num boot e 1024 s em outro.
head2 "entropia"
RNG="$(read_or /sys/class/misc/hw_random/rng_current)"
if [ -n "$RNG" ] && [ "$RNG" != "none" ]; then
    pass "hwrng: $RNG"
else
    warn "sem hwrng — crng pode demorar; ver nó &rng no DTS"
fi

# ── armazenamento ────────────────────────────────────────────
head2 "armazenamento"
if command -v lsblk >/dev/null 2>&1; then
    pass "blocos: $(lsblk -dn -o NAME,SIZE 2>/dev/null | tr '\n' ' ')"
else
    skip "lsblk ausente"
fi
ROOT_DEV=$(awk '$2=="/" {print $1}' /proc/mounts 2>/dev/null | head -n 1)
if [ -n "$ROOT_DEV" ]; then
    pass "rootfs em $ROOT_DEV"
else
    fail "não achei o rootfs em /proc/mounts"
fi

# ── display / DRM ────────────────────────────────────────────
# Esta é a cadeia que mais falha, e onde o sintoma (tela preta) não diz nada
# sobre a causa. Por isso cada elo é verificado separadamente.
head2 "display (DRM)"

if [ -e /dev/dri/card0 ]; then
    pass "/dev/dri/card0 presente"
else
    fail "/dev/dri/card0 AUSENTE — sem console gráfico (suspeite do PHY DSI)"
fi

if [ -e /dev/dri/renderD128 ]; then
    pass "render node presente (3D disponível para processos)"
else
    warn "sem /dev/dri/renderD128 — 3D pode não inicializar"
fi

DRM_DRIVER=""
[ -r /sys/class/drm/card0/device/driver ] && \
    DRM_DRIVER=$(basename "$(readlink -f /sys/class/drm/card0/device/driver 2>/dev/null)" 2>/dev/null)
[ -n "$DRM_DRIVER" ] && pass "driver DRM: $DRM_DRIVER" || warn "driver DRM não identificado"

CONNECTED=0
for c in /sys/class/drm/card0-*; do
    [ -d "$c" ] || continue
    st="$(read_or "$c/status")"
    name=$(basename "$c")
    [ "$st" = "connected" ] || continue
    CONNECTED=$((CONNECTED+1))
    mode=$(head -n 1 "$c/modes" 2>/dev/null)
    pass "conector $name: connected $mode"
done
[ "$CONNECTED" -eq 0 ] && fail "nenhum conector 'connected' — painel não subiu"

BL=""
for b in /sys/class/backlight/*; do
    [ -d "$b" ] || continue
    BL="$(read_or "$b/brightness")/$(read_or "$b/max_brightness")"
    break
done
[ -n "$BL" ] && pass "backlight: $BL" || warn "sem backlight em /sys/class/backlight"

# Orientação do console. O painel pode ser retrato (720x1280) enquanto o
# aparelho é usado em paisagem; sem rotação o texto sai deitado. E o parâmetro
# `fbcon=rotate:N` da linha de comando é IGNORADO EM SILÊNCIO quando o kernel não
# tem CONFIG_FRAMEBUFFER_CONSOLE_ROTATION — o kernel nem avisa. Por isso o teste
# olha o resultado, não a intenção.
FBCON_ROT=$(cat /sys/class/graphics/fbcon/rotate 2>/dev/null || echo "")
FB_SIZE=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null || echo "")
MODE_FIRST=$(ls /sys/class/drm/*/modes 2>/dev/null | head -n 1)
DRM_MODE=""
[ -n "$MODE_FIRST" ] && DRM_MODE=$(head -n 1 "$MODE_FIRST" 2>/dev/null)

if [ -n "$FBCON_ROT" ]; then
    # 90x80 = 720/8 por 1280/16: retrato nativo, rotação não aplicada.
    GEOM=$(dmesg 2>/dev/null | sed -n 's/.*frame buffer device \([0-9]*x[0-9]*\).*/\1/p' | head -n 1)
    case "$DRM_MODE" in
        720x1280)
            case "$FBCON_ROT" in
                0) warn "console sem rotação (rotate=$FBCON_ROT${GEOM:+, $GEOM}) — painel é retrato, texto sai deitado" ;;
                *) pass "console rotacionado (rotate=$FBCON_ROT${GEOM:+, $GEOM}) para painel retrato" ;;
            esac
            ;;
        *)
            pass "console rotate=$FBCON_ROT${GEOM:+, $GEOM} (painel ${DRM_MODE:-?})"
            ;;
    esac
else
    warn "sem /sys/class/graphics/fbcon/rotate — CONFIG_FRAMEBUFFER_CONSOLE_ROTATION desligado?"
fi

# Ferramenta de teste de botões: só existe se evtest estiver na imagem.
if command -v evtest >/dev/null 2>&1; then
    pass "evtest presente (base do giochi-buttons)"
else
    warn "evtest ausente — giochi-buttons não funciona (BR2_PACKAGE_EVTEST)"
fi

# ── render 3D ────────────────────────────────────────────────
head2 "render 3D"

if [ -n "$DRM_DRIVER" ]; then
    case "$DRM_DRIVER" in
        panfrost|msm|etnaviv|lima|v3d|virtio_gpu|vgem) pass "driver de GPU reconhecido: $DRM_DRIVER" ;;
        *) warn "driver DRM '$DRM_DRIVER' — não é GPU conhecida; 3D pode ser software" ;;
    esac
fi

# EGL/GLES: sem binário de teste não há como provar. Não fingir.
if command -v kmscube >/dev/null 2>&1; then
    if timeout 10 kmscube -D /dev/dri/card0 >/dev/null 2>&1; then
        pass "kmscube rodou (EGL/GLES + scanout OK)"
    else
        fail "kmscube falhou — EGL/GLES ou scanout quebrado"
    fi
else
    skip "kmscube ausente — não dá para provar 3D; habilitar BR2_PACKAGE_KMSCUBE"
fi

if [ -r /proc/meminfo ]; then
    pass "RAM: $(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo)"
fi

# ── bibliotecas que o launcher carrega ───────────────────────
#
# Um `libSDL2_ttf` sem `libharfbuzz` por trás NÃO falha ao abrir: ele só faz
# shaping errado, em silêncio. E um `libasound` ausente mata o launcher no
# `dlopen` inicial, com mensagem que não diz qual biblioteca faltou.
#
# Estas quatro são as que o launcher precisa. A ordem importa: SDL2_ttf é
# inútil sem freetype, então as duas são reportadas juntas.
head2 "bibliotecas do launcher"

MISSING_LIB=""
for lib in libasound libfreetype libharfbuzz libSDL2-2.0 libSDL2_ttf; do
    # O nome real tem versão (libharfbuzz.so.0), então procura o prefixo.
    if ls /usr/lib/${lib}.so* /lib/${lib}.so* >/dev/null 2>&1; then
        pass "$lib"
    else
        fail "$lib ausente — o launcher não inicia ou quebra em runtime"
        MISSING_LIB="$MISSING_LIB $lib"
    fi
done

# HarfBuzz ligado no SDL2_ttf? A biblioteca sozinha não prova nada: o
# sdl2_ttf 2.22 é configurado com --disable-harfbuzz por padrão, e o
# `BR2_PACKAGE_HARFBUZZ=y` só troca isso se o pacote for RECONFIGURADO —
# num build retomado ele não é. Medido neste repositório: a lib estava na
# imagem e o TTF_USE_HARFBUZZ continuava 0.
if [ -r /usr/lib/libSDL2_ttf.so ] || ls /usr/lib/libSDL2_ttf-2.0.so.0 >/dev/null 2>&1; then
    if command -v readelf >/dev/null 2>&1; then
        if readelf -d /usr/lib/libSDL2_ttf-2.0.so.0 2>/dev/null | grep -q libharfbuzz; then
            pass "SDL2_ttf com harfbuzz (shaping de script complexo ativo)"
        else
            warn "SDL2_ttf SEM harfbuzz — texto latino sai, script complexo sai errado"
        fi
    else
        skip "sem readelf — não dá para provar que o SDL2_ttf usa harfbuzz"
    fi
fi

# Fontes: o diretório existir não prova nada (dejavu.mk cria vazio sem família).
FONTS=$(ls /usr/share/fonts/dejavu/*.ttf 2>/dev/null | wc -l)
if [ "$FONTS" -gt 0 ]; then
    pass "fontes: $FONTS arquivo(s) .ttf em /usr/share/fonts/dejavu"
else
    fail "nenhuma .ttf instalada — TTF_OpenFont falha e o launcher desenha vazio"
fi

if [ -r /proc/meminfo ]; then
    pass "RAM: $(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo)"
fi

# ── entrada ──────────────────────────────────────────────────
head2 "entrada"

EVENTS=$(ls /dev/input/event* 2>/dev/null | wc -l)
if [ "$EVENTS" -gt 0 ]; then
    pass "$EVENTS dispositivo(s) /dev/input/event*"
else
    fail "nenhum /dev/input/event* — sem controle"
fi

for n in /sys/class/input/event*/device/name; do
    [ -r "$n" ] || continue
    say "         nome: $(read_or "$n")"
done

# Conta os controles de verdade, em vez de assumir. O mapa de botões só serve
# para algo se o kernel entregar os códigos: um `buttons.map` com 31 entradas e
# nenhum dispositivo de gamepad é um mapa apontando para o vazio.
count_bits() {
    # capabilities/key e capabilities/abs são bitmaps em hex, palavra de maior
    # peso primeiro. Conta os bits ligados dígito a dígito com `index`/`substr`:
    # `strtonum` é extensão do gawk e NÃO existe no awk do busybox, que é o que
    # roda neste rootfs — usar strtonum aqui devolveria vazio em silêncio.
    awk '{
        digits = "0123456789abcdef"
        weight = "0112122312233344"
        total = 0
        for (i = 1; i <= NF; i++) {
            w = tolower($i)
            for (j = 1; j <= length(w); j++) {
                p = index(digits, substr(w, j, 1))
                if (p > 0) total += substr(weight, p, 1) + 0
            }
        }
        print total
    }'
}

PAD_BUTTONS=0
PAD_AXES=0
for dev in /sys/class/input/event*/device; do
    [ -r "$dev/name" ] || continue
    name=$(read_or "$dev/name")
    case "$name" in
        gpio-keys-control)
            PAD_BUTTONS=$(count_bits < "$dev/capabilities/key" 2>/dev/null)
            ;;
        adc-joystick)
            PAD_AXES=$(count_bits < "$dev/capabilities/abs" 2>/dev/null)
            ;;
    esac
done

# Quantos botões de gamepad o `buttons.map` trata como OBRIGATÓRIOS.
#
# O kernel declara 17 (o patch 0002 acrescenta o BTN_MODE), mas o gabarito físico
# desta revisão tem 16: o botão `F` não existe. O mapa marca essa entrada como
# OPCIONAL e é ele que manda — exigir 17 aqui deixaria o teste falhando para
# sempre, e um vermelho permanente esconde um botão realmente quebrado.
MAP_FILE=/etc/giochi/buttons.map
MAP_GAMEPAD=0
if [ -r "$MAP_FILE" ]; then
    MAP_GAMEPAD=$(awk '
        {
            opc = (tolower($0) ~ /opcional/)
            sub(/#.*/, "")
            if (index($0, "=") == 0) next
            split($0, par, "=")
            codigo = par[2]
            gsub(/[ \t]/, "", codigo)
            if (codigo ~ /^BTN_/) {
                if (opc) nopt++
                else total++
            }
        }
        END { print total + 0 }
    ' "$MAP_FILE" 2>/dev/null)
fi

if [ "${PAD_BUTTONS:-0}" -gt 0 ] && [ "$MAP_GAMEPAD" -gt 0 ] && [ "$PAD_BUTTONS" -lt "$MAP_GAMEPAD" ]; then
    fail "botões de gamepad: $PAD_BUTTONS declarados — o mapa exige $MAP_GAMEPAD"
elif [ "${PAD_BUTTONS:-0}" -gt 0 ]; then
    EXTRA=$((PAD_BUTTONS - MAP_GAMEPAD))
    if [ "$EXTRA" -gt 0 ]; then
        pass "botões de gamepad: $PAD_BUTTONS declarados ($MAP_GAMEPAD obrigatórios + $EXTRA opcional(is))"
    else
        pass "botões de gamepad: $PAD_BUTTONS (gpio-keys-control)"
    fi
else
    fail "sem gpio-keys-control — nenhum botão de gamepad"
fi

# Os 4 eixos vêm de `adc-joystick`; sem CONFIG_JOYSTICK_ADC ele nem aparece.
if [ "${PAD_AXES:-0}" -ge 4 ]; then
    pass "eixos analógicos: $PAD_AXES (adc-joystick)"
elif [ "${PAD_AXES:-0}" -gt 0 ]; then
    fail "eixos analógicos: $PAD_AXES — esperado 4 (ABS_X/Y/RX/RY)"
else
    fail "sem adc-joystick — os analógicos não existem (CONFIG_JOYSTICK_ADC?)"
fi

if [ -r /etc/giochi/buttons.map ]; then
    MAPS=$(grep -c '=' /etc/giochi/buttons.map 2>/dev/null)
    pass "/etc/giochi/buttons.map ($MAPS entradas)"
else
    fail "/etc/giochi/buttons.map AUSENTE — launcher usaria o padrão embutido"
fi

# ── áudio ────────────────────────────────────────────────────
head2 "áudio"

if [ -r /proc/asound/cards ]; then
    CARDS=$(grep -c '^\s*[0-9]' /proc/asound/cards 2>/dev/null)
    if [ "${CARDS:-0}" -gt 0 ]; then
        pass "placas de som: $(grep '^\s*[0-9]' /proc/asound/cards | sed 's/^ *//' | tr '\n' ' ')"
    else
        fail "nenhuma placa de som — asoc provavelmente em deferred probe"
    fi
else
    fail "sem /proc/asound — ALSA não carregou"
fi

# O `Playback Mux` do RK817 precisa estar em HP: o amplificador do falante é
# alimentado por HPOL/HPOR, e em SPK o aparelho fica MUDO — o SPK DAC é o
# class-D interno do RK817 e não está roteado nesta placa.
#
# `amixer` NÃO existe no Buildroot 2024.02 (o pacote alsa-utils só traz
# alsactl e alsamixer). Por isso o caminho principal aqui é o `alsactl store`,
# que despeja todos os controles com nome e valor em formato de texto.
MUX=""
if command -v amixer >/dev/null 2>&1; then
    MUX=$(amixer sget "Playback Mux" 2>/dev/null | sed -n "s/.*Item0: '\([A-Z]*\)'.*/\1/p" | head -n 1)
fi
if [ -z "$MUX" ] && command -v alsactl >/dev/null 2>&1; then
    STATE=/tmp/giochi-mixer.state
    if alsactl -f "$STATE" store >/dev/null 2>&1; then
        # O bloco é: name 'Playback Mux' / value <X>. Pega o value seguinte.
        MUX=$(awk "
            /name .Playback Mux./ { achou = 1; next }
            achou && /value / { print \$2; exit }
        " "$STATE" 2>/dev/null)
        rm -f "$STATE"
    fi
fi
if [ -n "$MUX" ]; then
    case "$MUX" in
        HP) pass "Playback Mux = HP (falante roteado por HPOL/HPOR)" ;;
        *)  fail "Playback Mux = $MUX — falante fica MUDO; precisa ser HP" ;;
    esac
elif command -v alsactl >/dev/null 2>&1 || command -v amixer >/dev/null 2>&1; then
    warn "controle 'Playback Mux' não encontrado no mixer"
else
    skip "sem amixer e sem alsactl"
fi

# ── USB ──────────────────────────────────────────────────────
head2 "USB"
UDC=$(ls /sys/class/udc 2>/dev/null)
if [ -n "$UDC" ]; then
    pass "UDC: $UDC · estado $(read_or /sys/class/udc/$UDC/state)"
else
    warn "sem UDC — sem gadget USB (rede por USB/SSH indisponível)"
fi

# ── rede por cabo USB: o canal de acesso padrão ──────────────
#
# Este bloco vem ANTES de "rede" de propósito. Na maioria dos aparelhos não há
# Wi-Fi nem Bluetooth, e console serial exige hardware que quase ninguém tem.
# Se o usb0 não subir, o aparelho está inacessível — é o FAIL mais grave desta
# seção, e não um detalhe no meio de uma lista.
head2 "rede por USB (canal de acesso padrão)"

if [ -d /sys/class/net/usb0 ]; then
    USB0_STATE="$(read_or /sys/class/net/usb0/operstate)"
    USB0_ADDR=""
    # `ip -4 -o addr show usb0` é a forma estável; ifconfig varia entre applets.
    if command -v ip >/dev/null 2>&1; then
        USB0_ADDR="$(ip -4 -o addr show usb0 2>/dev/null | awk '{print $4}' | head -1)"
    fi
    if [ -z "$USB0_ADDR" ]; then
        # Interface existe mas sem IP: o gadget montou e o endereço não entrou.
        fail "usb0 existe mas SEM IP — o SSH por cabo não atende"
    elif [ "$USB0_STATE" = "up" ] || [ "$USB0_STATE" = "unknown" ]; then
        pass "usb0: $USB0_ADDR ($USB0_STATE) — ssh root@${USB0_ADDR%%/*}"
    else
        # `down` aqui NAO é defeito: o netdev do gadget é criado no boot e a
        # operstate só sobe quando um host energiza o barramento. Sem cabo
        # plugado, `down` é o estado correto — e o aparelho continua bootando
        # e funcionando. Marcar FAIL aqui seria o vermelho permanente que
        # esconde defeito real (ver AGENTS §12.22).
        pass "usb0: $USB0_ADDR pronto (link $USB0_STATE — cabo desconectado)"
    fi

    if [ -f /var/run/udhcpd.pid ] && kill -0 "$(cat /var/run/udhcpd.pid 2>/dev/null)" 2>/dev/null; then
        LEASES=$(grep -c '^[0-9a-f]' /var/lib/misc/udhcpd.leases 2>/dev/null || echo 0)
        pass "udhcpd ativo — o PC recebe IP sozinho ($LEASES lease(s))"
    else
        # Sem udhcpd ainda dá para conectar, mas exige IP estático no PC.
        warn "udhcpd parado — o PC precisa de IP estático 10.55.0.1/24"
    fi
else
    if [ -n "${UDC:-}" ]; then
        fail "sem usb0 apesar de haver UDC — rode 'giochi-usbnet' e veja o erro"
    else
        warn "sem usb0 e sem UDC — o aparelho não está em modo dispositivo"
    fi
fi

# Servidor SSH: é o que o usb0 existe para servir.
if pidof sshd >/dev/null 2>&1; then
    pass "sshd rodando (porta 22)"
elif [ -x /usr/sbin/sshd ]; then
    fail "sshd instalado mas NÃO rodando — o aparelho fica inacessível"
else
    fail "sshd ausente da imagem"
fi

# Dois servidores SSH na mesma porta é um erro que já aconteceu aqui: o
# dropbear e o openssh vinham juntos, cada um com seu S50*, e o segundo a subir
# falhava. O sintoma é "ssh às vezes não responde", dependendo da ordem.
if [ -x /usr/sbin/dropbear ] && [ -x /usr/sbin/sshd ]; then
    fail "dropbear E openssh na imagem — os dois disputam a porta 22"
fi

# ── rede ─────────────────────────────────────────────────────
head2 "rede"
IFACES=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | tr '\n' ' ')
if [ -n "$IFACES" ]; then
    pass "interfaces: $IFACES"
else
    warn "nenhuma interface além de lo"
fi

# ── energia ──────────────────────────────────────────────────
head2 "energia"
BAT=""
for p in /sys/class/power_supply/*; do
    [ "$(read_or "$p/type")" = "Battery" ] || continue
    BAT="$(read_or "$p/capacity")% ($(read_or "$p/status"))"
    break
done
[ -n "$BAT" ] && pass "bateria: $BAT" || warn "sem bateria detectada"

TEMP=""
for t in /sys/class/thermal/thermal_zone*; do
    [ -r "$t/temp" ] || continue
    TEMP="$(( $(read_or "$t/temp") / 1000 ))C"
    break
done
[ -n "$TEMP" ] && pass "temperatura: $TEMP" || warn "sem zona térmica"

# ── camada Giochi ────────────────────────────────────────────
head2 "camada Giochi"

# Quem chama o giochi-init é o /etc/inittab, por `respawn` — ele nunca é PID 1
# (PID 1 é o init do busybox). A pergunta certa é "existe a linha?", não
# "é PID 1?", que nunca seria verdade e daria WARN eterno.
LAUNCHER=/opt/giochi/apps/launcher/bin/giochi-launcher
if [ -x /usr/bin/giochi-init ]; then
    if grep -q '^::respawn:/usr/bin/giochi-init$' /etc/inittab 2>/dev/null; then
        pass "inittab chama giochi-init (respawn)"
    elif [ -x "$LAUNCHER" ] || [ -f /etc/giochi/boot-layer ]; then
        # O launcher (ou o marcador) pede a camada de boot e ela não está ligada:
        # o launcher nunca subiria, e nada no boot diria por quê.
        fail "inittab NÃO chama giochi-init — o launcher não sobe"
    else
        # Sem launcher, é o estado correto: a linha só entra quando há o que
        # iniciar. Não é falha.
        pass "giochi-init pronto (sem launcher: camada de boot desligada)"
    fi
else
    fail "giochi-init ausente"
fi

if [ -x "$LAUNCHER" ]; then
    pass "launcher: $LAUNCHER"
else
    skip "sem launcher empacotado (/opt/giochi/apps/launcher)"
fi

if [ -r /opt/giochi/apps/index.json ]; then
    pass "catálogo de apps: $(grep -c '"id"' /opt/giochi/apps/index.json) app(s)"
else
    warn "sem /opt/giochi/apps/index.json — a grade ficaria vazia"
fi

# ── resumo ───────────────────────────────────────────────────
say ""
say "════════════════════════════════════════"
say "  PASS $PASS · WARN $WARN · FAIL $FAIL · SKIP $SKIP"
say "════════════════════════════════════════"

if [ "$FAIL" -gt 0 ]; then
    say ""
    say "Há falha(s). Ordem de investigação, do mais provável:"
    say "  1. tela preta        -> DTB errado, não kernel (ver docs/troubleshooting.md)"
    say "  2. sem /dev/dri      -> CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y (nunca =m)"
    say "  3. mudou o Mux       -> Playback Mux precisa ser HP"
    say "  4. sem botão         -> buttons.map e o driver do joypad"
    exit 1
fi

exit 0
