#!/bin/sh
# giochi-init — primeiro processo do console.
#
# Responsabilidade única: manter a interface viva. Ele NÃO desenha nada, não lê
# controle e não conhece app nenhum.
#
# ## Por que ele existe
#
# O launcher **não** faz `exec` para abrir um jogo: ele faz `fork` + `wait`
# (`Command::status()` em poweroff/reboot, e o mesmo padrão para o jogo). Medido
# no X35H e no X55 em 04/11/2026: o launcher continua sendo o mesmo PID enquanto
# o jogo roda, e volta com o texto intacto depois.
#
# Isso tem duas consequências, e a segunda é a que importa aqui:
#
#   1. O launcher NÃO deixa de existir quando um jogo roda. Quem cuida do ciclo
#      do jogo é ele, não este script.
#   2. Este script fica bloqueado no `"$LAUNCHER"` o jogo inteiro e só vê saída
#      quando o launcher realmente morre — por crash, por `exit` ou por sinal.
#
# Portanto: **toda saída do launcher vista aqui é anormal**, e é isso que
# `RESTART_MAX` conta. Um launcher saudável não sai enquanto o aparelho está
# ligado.
#
#     giochi-init ──▶ launcher ──fork+wait──▶ jogo
#          ▲              │                    │
#          │              └──── jogo termina ──┘   (o launcher continua vivo)
#          └──── só quando o launcher MORRE ────────
#
# O `exec` é decisão futura do Giochi app (registrada no `docs/integracao.md`
# deles), para nunca haver dois processos disputando o DRM master. Se ele
# acontecer, o diagrama muda — e `RESTART_MAX` passa a contar também o fim
# normal de cada jogo, o que exige revisar o limite. Ver a nota em
# docs/giochi-init.md.
#
# ## O que ele também resolve
#
# - Cria o diretório de configuração, que é a partição de dados do app.
# - Restaura o brilho salvo (senão o aparelho volta ao máximo a cada boot).
# - Abre o configurador de controles quando o mapeamento precisa de conserto.
#
# POSIX sh de propósito: roda em busybox ash, sem bash na imagem.

set -u

LAUNCHER="${GIOCHI_LAUNCHER:-/opt/giochi/apps/launcher/bin/giochi-launcher}"
CONTROLLERS="${GIOCHI_CONTROLLERS:-/opt/giochi/apps/controllers/bin/giochi-controllers}"

CONFIG_DIR="${GIOCHI_CONFIG_DIR:-/user/.config/giochi}"
SETUP_FLAG="$CONFIG_DIR/controller-setup"
BRIGHTNESS_FILE="$CONFIG_DIR/brightness"

# Quantas vezes o launcher pode cair antes de desistirmos. Sem isso, um launcher
# quebrado entra em laço de reinício e a tela pisca sem parar — pior que uma
# mensagem de erro parada.
RESTART_MAX=5
RESTART_WINDOW=60

# ## Queda por sinal deliberado não é queda
#
# Relatado pela equipe do `Giochi app` em 06/11/2026, medido no R35S: cada
# `verificar` deles derruba o launcher uma vez para capturar o quadro (o KMSDRM
# é exclusivo, não há como ler o framebuffer com o launcher vivo). Depois de
# cinco verificações em duas horas de bancada o `giochi-init` **parava de
# reiniciar** e dormia — correto contra laço de crash, e o resultado em campo
# era "aparelho ligado, tela parada, nenhum erro na tela".
#
# O aviso deles estava certo: a ferramenta de diagnóstico estava consumindo a
# cota que existe para o defeito. A distinção que faltava é a única que importa:
#
#   status 0            → o launcher saiu por conta própria (usuário fechou)
#   status 129/130/143  → 128+SIGHUP/SIGINT/SIGTERM: alguém MATOU de propósito
#   qualquer outro      → crash de verdade, conta na cota
#
# Nada disso afrouxa a proteção contra laço: um launcher que crasha com segfault
# (139), panic (101) ou `exit 7` continua contando. O que muda é que o
# encerramento deliberado **zera** a cota em vez de consumi-la.
#
# A desistência também deixou de ser invisível: além do console, ela grava
# `/run/giochi/launcher-parado`, porque "tela parada" sem texto é
# indistinguível de "não ligou". Quem entra por SSH pergunta ao arquivo em vez
# de adivinhar. Ver §12.45 em AGENTS.md.
PARADA_FILE="${GIOCHI_PARADA_FILE:-/run/giochi/launcher-parado}"

# ## Console livre para desenvolvimento
#
# `touch /run/giochi/dev-free-console` faz o giochi-init NÃO iniciar o launcher
# enquanto o arquivo existir. `rm` devolve o comportamento normal.
#
# Por que existe, medido: para testar um binário que precisa do DRM master (a
# engine, o `hello_rect`), era preciso `chmod -x` no launcher e lembrar de
# reverter — e esquecer deixa o aparelho sem interface para sempre, sem nada no
# console dizendo por quê. Pior: o launcher morto 5 vezes em 60 s faz o
# supervisor DESISTIR, e aí a tela fica preta e o `sleep 3600` não conta nada.
# Relatado pela equipe da engine em 07/11/2026 (P4) como o item de maior valor.
#
# A flag é verificada ANTES de cada tentativa, então também funciona quando o
# launcher já está rodando: ele sai, o giochi-init vê a flag e não reinicia.
DEV_FREE_FILE="${GIOCHI_DEV_FREE_FILE:-/run/giochi/dev-free-console}"

# Saída deliberada: 0 (o launcher pediu para sair) ou morte por sinal
# "administrativo". 128+sinal é o que o shell devolve para filho morto por sinal.
saida_deliberada() {
    case "$1" in
        0|129|130|143) return 0 ;;
        *) return 1 ;;
    esac
}

# Intervalo entre tentativas de encontrar o launcher, em segundos.
LAUNCHER_WAIT="${GIOCHI_LAUNCHER_WAIT:-30}"

log() {
    printf 'giochi-init: %s\n' "$1" >&2
}

# O diretório de configuração é a partição de dados do app, e **nada nesta
# árvore o cria**: `/user` não existe na imagem porque a partição de dados da
# loja ainda não foi implementada. Medido no `rootfs.ext4` de 04/11:
#
#     debugfs -R "ls -l /" rootfs.ext4 | grep user   -> nada
#
# O launcher grava brilho, volume e rotação em `$CONFIG_DIR`. Sem o diretório,
# a escrita falha e o app fica sem estado — sem mensagem que ligue o sintoma à
# causa, porque o `giochi-init` só *lia* dali, nunca escrevia.
#
# Quem declara o caminho é quem o prepara. Se `GIOCHI_CONFIG_DIR` apontar para
# outro lugar (teste, partição montada depois), isto cria o lugar certo e não
# atrapalha o que já existe.
prepare_config_dir() {
    if mkdir -p "$CONFIG_DIR" 2>/dev/null; then
        log "diretório de configuração pronto: $CONFIG_DIR"
    else
        # Não é fatal: o launcher decide o que fazer sem estado. Mas tem de
        # aparecer, senão "o app não salva o brilho" volta a ser mistério.
        log "AVISO: não consegui criar $CONFIG_DIR (o app fica sem estado)"
    fi
}

uptime_seconds() {
    # /proc/uptime em vez de `date`: sempre existe, não depende de RTC correto.
    cut -d. -f1 /proc/uptime 2>/dev/null || echo 0
}

restore_brightness() {
    [ -r "$BRIGHTNESS_FILE" ] || return 0

    value=$(cat "$BRIGHTNESS_FILE" 2>/dev/null)
    case "$value" in
        ''|*[!0-9]*) log "brilho salvo inválido, ignorando"; return 0 ;;
    esac

    for backlight in /sys/class/backlight/*; do
        [ -w "$backlight/brightness" ] || continue
        max=$(cat "$backlight/max_brightness" 2>/dev/null)
        case "$max" in
            ''|*[!0-9]*) continue ;;
        esac
        if [ "$value" -gt "$max" ]; then
            value=$max
        fi
        printf '%s' "$value" > "$backlight/brightness" 2>/dev/null \
            && log "brilho restaurado para $value/$max em $backlight"
        return 0
    done

    log "nenhum backlight gravável encontrado"
}

# Se o mapeamento de botões estiver errado, o usuário não consegue navegar até a
# tela de configuração — o ovo e a galinha. Por isso o configurador roda ANTES,
# quando o sinalizador existe.
#
# CONTRATO com o `giochi-controllers` (conferido com a equipe do app em
# 04/11/2026, item 5 da mensagem das 20:10):
#
#   argv     nenhum — este script chama o binário seco
#   env      herdado; usa `GIOCHI_CONFIG_DIR` para saber onde salvar
#   saída 0  mapeamento salvo   -> o sinalizador é APAGADO
#   saída ≠0 falha              -> o sinalizador PERMANECE, para haver nova
#                                  chance no próximo boot
#
# A segunda regra é a correção de um bug medido: a versão anterior apagava o
# sinalizador **independentemente** do código de saída. Se o configurador
# travasse, falhasse no link ou saísse com 1, o pedido de socorro desaparecia e
# o usuário ficava com o mapa errado **e sem como chamar o configurador** — num
# aparelho sem SSH, isso é ficar sem saída.
run_controller_setup() {
    [ -e "$SETUP_FLAG" ] || return 0

    if [ ! -x "$CONTROLLERS" ]; then
        log "sinalizador de setup existe, mas $CONTROLLERS não é executável"
        log "mantendo $SETUP_FLAG para a próxima tentativa"
        return 0
    fi

    log "abrindo configurador de controles"
    "$CONTROLLERS"
    status=$?
    log "configurador saiu com $status"

    if [ "$status" -eq 0 ]; then
        rm -f "$SETUP_FLAG"
        log "mapeamento salvo; sinalizador removido"
    else
        log "configurador falhou; sinalizador mantido para nova tentativa"
    fi
}

# O launcher NÃO nasce neste repositório: ele vem do Giochi app e entra na
# imagem pelo Giochi os. Portanto existe uma janela — e talvez uma imagem
# inteira — em que o giochi-init roda sem launcher.
#
# Sair na hora aqui é o pior comportamento possível. Medido: 99 ms até o
# `exit 1`. Com `::respawn:` no inittab, o BusyBox reinicia o processo assim que
# ele morre, então isso vira um laço de ~10 vezes por segundo inundando o
# console — e mensagem repetida é pior que mensagem nenhuma, porque esconde o
# getty na mesma tela.
#
# Então espera. Sem CPU, sem ruído, e o PID 1 continua vivo.
# ---------------------------------------------------------------
# Bootsplash: quem decide a hora de sair é ESTE script.
#
# O `S01splash` sobe o psplash antes de tudo. Ele cobre o texto que o kernel
# deixou no framebuffer, e sai por dois motivos possíveis:
#
#   com launcher    -> o launcher assume o DRM master; o splash tem de sair
#                      ANTES, senão ele segura o master e a tela do app fica
#                      preta (o pior sintoma: sistema bom, tela morta)
#   sem launcher    -> o console (getty) é a interface; o splash tem de sair
#                      para o login aparecer
#
# Se este script não estivesse aqui para decidir, o splash ficaria na tela para
# sempre no caso sem launcher — que é o caso de TODA imagem desta árvore hoje.
# ---------------------------------------------------------------
stop_splash() {
    [ -p /tmp/psplash_fifo ] || return 0
    if command -v psplash-write >/dev/null 2>&1; then
        psplash-write "QUIT" 2>/dev/null && log "splash encerrado"
        return 0
    fi
    for p in $(pidof psplash 2>/dev/null); do
        kill "$p" 2>/dev/null && log "splash encerrado (por sinal)"
    done
    return 0
}

wait_for_launcher() {
    # Sem launcher, o console É a interface: tira o splash para o getty aparecer.
    # Sem isto, a imagem fica com o logo na tela e ninguém vê o login — e como o
    # getty escreve no ttyS2, quem está na serial vê tudo e quem olha a tela não
    # vê nada. Assimetria que custa tempo para diagnosticar.
    stop_splash
    log "launcher ausente ainda: $LAUNCHER"
    log "esperando aparecer; verifico a cada ${LAUNCHER_WAIT}s (sem inundar o console)"
    while [ ! -x "$LAUNCHER" ]; do
        sleep "$LAUNCHER_WAIT"
    done
    log "launcher encontrado: $LAUNCHER"
}

main() {
    prepare_config_dir
    restore_brightness
    run_controller_setup

    restarts=0
    window_start=0
    dev_aviso=0

    while :; do
        # Flag de desenvolvimento: launcher não sobe enquanto o arquivo existir.
        # Verificada a cada volta, então `touch` no meio de uma sessão também
        # funciona — o launcher sai na próxima queda deliberada e não volta.
        if [ -f "$DEV_FREE_FILE" ]; then
            if [ "$dev_aviso" != "1" ]; then
                log "console livre para desenvolvimento ($DEV_FREE_FILE) — launcher NÃO será iniciado"
                log "remova o arquivo para voltar ao normal"
                dev_aviso=1
            fi
            sleep 5
            continue
        fi
        dev_aviso=0

        # Cobre tanto o primeiro boot sem launcher quanto o caso de ele
        # desaparecer depois (imagem trocada, app removido).
        [ -x "$LAUNCHER" ] || wait_for_launcher

        now=$(uptime_seconds)

        # Janela deslizante: se passou tempo suficiente desde a primeira falha,
        # zera a contagem. Um launcher saudável nunca chega perto do limite.
        if [ $((now - window_start)) -ge $RESTART_WINDOW ]; then
            restarts=0
            window_start=$now
        fi

        # ANTES de executar: o launcher vai virar DRM master, e o psplash
        # segurando a tela impediria o primeiro quadro dele de aparecer.
        stop_splash
        "$LAUNCHER"
        status=$?

        # Encerramento deliberado (o app matou para ler o framebuffer, ou o
        # usuário fechou) não é queda: zera a cota em vez de consumi-la.
        if saida_deliberada "$status"; then
            log "launcher saiu com $status — encerramento deliberado, cota zerada"
            restarts=0
            window_start=$now
            sleep 1
            continue
        fi

        restarts=$((restarts + 1))

        log "launcher saiu com $status (queda $restarts de $RESTART_MAX na janela de ${RESTART_WINDOW}s)"

        # O limite é checado DEPOIS de contar a queda atual: `RESTART_MAX=5`
        # significa cinco tentativas de rodar, não seis. A versão anterior
        # contava antes de rodar e imprimia "reinício 6 de 5", medido.
        if [ "$restarts" -ge "$RESTART_MAX" ]; then
            log "launcher já caiu $RESTART_MAX vezes na janela de ${RESTART_WINDOW}s; parando de reiniciar"
            log "o processo continua vivo para o kernel não ficar sem init"
            # Deixa rastro fora do console: tela parada sem texto é
            # indistinguível de "não ligou" num handheld.
            mkdir -p "$(dirname "$PARADA_FILE")" 2>/dev/null || true
            {
                printf 'motivo=quedas_repetidas\n'
                printf 'quedas=%s\n' "$restarts"
                printf 'janela_s=%s\n' "$RESTART_WINDOW"
                printf 'ultimo_status=%s\n' "$status"
                printf 'launcher=%s\n' "$LAUNCHER"
                printf 'uptime_s=%s\n' "$now"
            } >"$PARADA_FILE" 2>/dev/null || true
            # Não reinicia mais. Dorme para não consumir CPU, mas o processo
            # continua vivo para o kernel não entrar em pânico por falta de init.
            while :; do sleep 3600; done
        fi

        # Um intervalo curto evita loop apertado em falha instantânea.
        sleep 1
    done
}

main "$@"
