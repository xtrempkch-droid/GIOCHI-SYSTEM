#!/bin/sh
# ============================================================
# S01splash — bootsplash o mais cedo possível
# ============================================================
# Sobe o `psplash` antes de qualquer serviço, para cobrir o texto do kernel que
# ficou no framebuffer. Sai quando o launcher assume a tela (`S99launcher`) ou
# quando o boot termina sem launcher (`giochi-init`).
#
# ## Por que S01 e não S00
#
# O `rcS` do busybox roda os scripts em ordem alfabética depois de montar
# `/proc`, `/sys` e `/dev`. Um `S00` rodaria antes de `/dev` existir, e o
# `/dev/fb0` não estaria lá. `S01` é o primeiro ponto em que o framebuffer é
# acessível de verdade.
#
# ## Por que não é fatal
#
# Sem splash o aparelho boota igual — só mostra texto. Derrubar o boot por causa
# de cosmético transformaria um detalhe de apresentação num sistema que não
# liga. Aqui, falha = aviso e segue.
#
# ## O FIFO, e o caminho que estava errado
#
# O `psplash` faz `chdir(rundir)` e cria `"psplash_fifo"` — nome RELATIVO
# (`psplash.c`, `#define PSPLASH_FIFO "psplash_fifo"`). O `rundir` vem de
# `$PSPLASH_FIFO_DIR` e, quando a variável não existe, é **`/run`**:
#
#     rundir = getenv("PSPLASH_FIFO_DIR");
#     if (!rundir) rundir = "/run";
#     chdir(rundir);
#
# Nosso código procurava `/tmp/psplash_fifo` em três lugares (aqui na espera,
# aqui no stop e no `giochi-init`), e `/tmp` NUNCA tem o arquivo.
#
# Consequência medida no X55 em 08/11/2026: o `stop_splash` do `giochi-init`
# começava com `[ -p /tmp/psplash_fifo ] || return 0` e retornava SEMPRE. O
# `psplash` ficou vivo de 1,7 s de uptime até 12017 s — e segurando `/dev/fb0`.
# Este script também imprimia "psplash não criou o FIFO — seguindo" a cada boot,
# que é um aviso sobre a ferramenta, não sobre o splash.
#
# A função abaixo procura os dois lugares e é a única fonte da verdade do
# caminho; `$PSPLASH_FIFO_DIR` entra primeiro para acompanhar um build que mude
# o diretório.
psplash_fifo() {
    for _f in "${PSPLASH_FIFO_DIR:-/run}/psplash_fifo" /run/psplash_fifo /tmp/psplash_fifo; do
        [ -p "$_f" ] && { printf '%s' "$_f"; return 0; }
    done
    return 1
}

case "$1" in
    start)
        command -v psplash >/dev/null 2>&1 || {
            echo "splash: psplash não está na imagem — seguindo sem splash"
            exit 0
        }
        [ -e /dev/fb0 ] || {
            # Sem framebuffer não há onde desenhar. Acontece em aparelho cujo
            # painel não subiu — e nesse caso o problema é o painel, não o
            # splash; avisar aqui evita procurar no lugar errado.
            echo "splash: /dev/fb0 ausente — sem splash (o painel subiu?)"
            exit 0
        }

        # fbcon=rotate:N usa rotação horária; o ângulo do psplash é anti-horário.
        # A X55 (rotate:3) foi medida no aparelho com psplash -a 90.
        PSPLASH_ANGLE=0
        for _arg in $(cat /proc/cmdline 2>/dev/null); do
            case "$_arg" in
                fbcon=rotate:0) PSPLASH_ANGLE=0 ;;
                fbcon=rotate:1) PSPLASH_ANGLE=270 ;;
                fbcon=rotate:2) PSPLASH_ANGLE=180 ;;
                fbcon=rotate:3) PSPLASH_ANGLE=90 ;;
            esac
        done

        # `-n`: não daemoniza, para este script poder esperar o desenho inicial.
        # O `&` é do shell: o processo fica filho do init e sobrevive ao script.
        psplash -n -a "$PSPLASH_ANGLE" >/dev/null 2>&1 &
        SPLASH_PID=$!
        # Espera o FIFO aparecer, que é o sinal de que ele desenhou o primeiro
        # quadro. Sem essa espera, o `PROGRESS` logo abaixo cairia no vazio.
        i=0
        while ! psplash_fifo >/dev/null && [ "$i" -lt 30 ]; do
            sleep 0.1
            i=$((i + 1))
        done
        if FIFO="$(psplash_fifo)"; then
            echo "splash: psplash rodando (pid $SPLASH_PID, fifo $FIFO)"
        else
            echo "splash: psplash rodando (pid $SPLASH_PID) mas sem fifo — QUIT cairá no kill"
        fi
        ;;
    stop)
        # `QUIT` é o caminho normal; o kill é a rede de segurança para o caso de
        # o FIFO ter sumido (ex.: alguém limpou /run).
        if psplash_fifo >/dev/null && command -v psplash-write >/dev/null 2>&1; then
            psplash-write "QUIT" 2>/dev/null
        fi
        for p in $(pidof psplash 2>/dev/null); do
            kill "$p" 2>/dev/null
        done
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Uso: $0 {start|stop|restart}"
        exit 2
        ;;
esac

exit 0
