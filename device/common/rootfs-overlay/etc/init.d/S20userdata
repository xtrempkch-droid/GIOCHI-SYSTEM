#!/bin/sh
# giochi-system:help:begin
# S20userdata — monta /user na partição de dados, e migra no primeiro boot.
#
# O problema que isto resolve: numa imagem recém-gravada, /user é um diretório
# DENTRO do rootfs. Montar a partição de dados por cima esconde esse diretório —
# e com ele o LEIA-ME, os jogos que o usuário já tinha posto e a pasta que o
# launcher espera existir. Se nada for feito, o efeito de trocar de imagem é
# "sumiu tudo", sem mensagem.
#
# O que este script faz, em ordem:
#
#   1. procura a partição de dados (rótulo GIOCHI_USER), com prioridade para a
#      do MESMO cartão do rootfs;
#   2. se o /user montado estiver vazio e o /user de baixo tiver conteúdo, move
#      o conteúdo (migração do primeiro boot);
#   3. garante as quatro pastas do contrato (games, apps, musica, ports);
#   4. não faz nada — e DIZ isso — quando não há partição de dados.
#
# Por que o passo 2 existe: a partição nasce formatada e VAZIA no make-sd-image.
# Sem a migração, quem tiver arquivos no /user do rootfs perde o acesso a eles
# no momento em que a partição é montada pela primeira vez. Mover é mais seguro
# que copiar: com cópia o espaço fica ocupado duas vezes (e o aparelho tem 1 GB).
#
# ## O segundo cartão
#
# Este aparelho tem dois controladores SD (medido no DTB: mmc@ff370000 e
# mmc@ff380000 no RK3326; equivalentes no RK3566). Um cartão de dados no
# SEGUNDO slot também serve: o critério é o rótulo, nunca o nome do device —
# `mmcblk0` num boot pode ser o cartão do sistema e no boot seguinte o de dados.
#
# Ordem de preferência, e cada uma tem motivo:
#   a) a p3 do cartão do rootfs   — sempre presente, cabe na imagem
#   b) o segundo cartão com GIOCHI_USER — o que o usuário põe para ter espaço
#   c) nada                        — /user fica no rootfs, como antes
#
# Um cartão de dados que NÃO tenha o rótulo não é montado em /user: ele é mídia
# removível, e montá-lo ali confundiria "meu save" com "o cartão do fulano".
# Ele aparece em /media/<LABEL>, que o app já conhece pelo pontos-de-montagem.
# giochi-system:help:end

set -u

LABEL_PREFERIDO=GIOCHI_USER
MNT=/user

log() { echo "S20userdata: $*"; }

# ── achar a partição de dados ──
#
# ## A versão anterior disto estava ERRADA, e o teste não pegava
#
# Ela procurava `/dev/disk/by-label/GIOCHI_USER*`. Medido em 27/11/2026 no
# `.config` do Buildroot:
#
#     BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
#     # BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV is not set
#     # BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV is not set
#
# Quem cria `/dev/disk/by-label` é o udev (ou o mdev, que aqui não roda). Com
# **devtmpfs puro, esse diretório NÃO EXISTE** — devtmpfs cria os nodes dos
# devices, não os symlinks por rótulo. Ou seja: o script nunca encontrava a
# partição, e o `/user` ficava sempre no rootfs, silenciosamente.
#
# Por que o teste passava: a bancada do teste **criava** o symlink by-label. O
# mock era mais generoso que o aparelho — a mesma classe do `mount` falso que
# lia `ext4` como origem (§12.37): a ferramenta respondia, e a resposta não era
# lida com desconfiança.
#
# ## Como se acha partição sem rótulo, sem udev e sem blkid confiável
#
# Três critérios, nesta ordem, e nenhum depende de symlink:
#
#   1. **LAYOUT**: a p3 do MESMO cartão do rootfs. É construção nossa — p1 boot,
#      p2 rootfs, p3 dados. `<rootfs>` = `/dev/mmcblk1p2` → cartão `mmcblk1` →
#      `/dev/mmcblk1p3`. Determinístico, zero dependência.
#   2. **MARCADOR**: qualquer partição cujo raiz tenha o diretório `giochi-user`
#      (ou `.giochi-user`). É o segundo cartão: o usuário cria a pasta no
#      Windows com dois cliques, e ela é a identidade do volume.
#   3. **RÓTULO**, se por acaso existir `/dev/disk/by-label` (imagem com eudev).
#      Mantido como terceiro porque é barato e não atrapalha.
#
# A enumeração das partições usa `/sys/class/block/*/partition` — esse arquivo
# só existe PARA PARTIÇÕES, então não há adivinhação de nome (`sda1` vs
# `mmcblk0p1` vs `vda1`) e nenhum cartão inteiro entra na lista.

LABEL_PREFERIDO=GIOCHI_USER
MARCADOR=giochi-user
# Nota de mount degradado. Arquivo e não variável: a função que monta roda em
# subshell, e atribuição lá dentro não volta para cá.
NOTA_ARQ=/tmp/.giochi-userdata-nota

# Tipo de filesystem pelo magic do início do device. Sem blkid: o do busybox
# existe mas é incompleto, e o do util-linux não está nesta imagem.
#   ext2/3/4: 0x438 = 53 ef      exFAT: offset 3 = "EXFAT"
#   FAT32: offset 82 = "FAT32"   FAT16: offset 54 = "FAT16"
tipo_de_fs() {
    _d="$1"
    _m="$(dd if="$_d" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n')"
    [ "$_m" = "53ef" ] && { echo ext4; return 0; }
    _m="$(dd if="$_d" bs=1 skip=3 count=5 2>/dev/null)"
    [ "$_m" = "EXFAT" ] && { echo exfat; return 0; }
    _m="$(dd if="$_d" bs=1 skip=82 count=5 2>/dev/null)"
    [ "$_m" = "FAT32" ] && { echo vfat; return 0; }
    _m="$(dd if="$_d" bs=1 skip=54 count=5 2>/dev/null)"
    [ "$_m" = "FAT16" ] && { echo vfat; return 0; }
    return 1
}

# Opções de montagem por tipo.
#
# exFAT e FAT **não guardam permissão**: quem decide é o mount. `fmask=0000` e
# `dmask=0000` dão 0777 a arquivo e diretório, e é o que faz `ports/*.sh` e o
# binário de um jogo serem executáveis. Num aparelho onde tudo roda como root
# isso não abre nada que já não estivesse aberto — e sem isso, `chmod +x` num
# exFAT é no-op e o port não roda.
#
# `iocharset=utf8` é o que faz "Música.mp3" chegar com o nome certo: exFAT usa
# UTF-16 e o driver traduz pelo NLS (CONFIG_NLS_UTF8 no fragmento de kernel).
opcoes_de_mount() {
    case "$1" in
        exfat) echo "uid=0,gid=0,fmask=0000,dmask=0000,iocharset=utf8" ;;
        vfat)  echo "uid=0,gid=0,fmask=0000,dmask=0000,iocharset=utf8,codepage=437" ;;
        *)     echo "" ;;
    esac
}

# Tenta montar $1 em $2, descobrindo o tipo. Imprime "<tipo> [nota]".
#
# ## Por que as opções vão em DEGRAUS, e não de uma vez
#
# Medido em 27/11/2026 num container: `mount -t vfat -o iocharset=utf8` num
# kernel SEM `CONFIG_NLS_UTF8` **não degrada — derruba o mount inteiro**:
#
#     mount: wrong fs type, bad option, bad superblock ... missing codepage
#
# A mensagem acusa "bad superblock" para um problema de módulo do kernel, e o
# que se perde é o `/user` INTEIRO (não só o acento do nome do arquivo). O mesmo
# vale para `codepage=437` sem `CONFIG_NLS_CODEPAGE_437`.
#
# No kernel desta árvore o 437 é `=y` e o UTF-8 passou a ser pedido no fragmento
# — mas uma imagem antiga, ou um aparelho que perca o símbolo, perderia a
# partição por causa de uma opção cosmética. Então: tenta com tudo, cai para o
# mínimo, e só então desiste. Cada degrau avisa o que perdeu.
montar_com_degraus() {
    _dev="$1"; _mnt="$2"; _tipo="$3"

    if [ "$_tipo" = "ext4" ] || [ -z "$_tipo" ]; then
        mount -t "${_tipo:-auto}" "$_dev" "$_mnt" 2>/dev/null || return 1
        return 0
    fi

    # A nota vai para ARQUIVO, e não variável: `montar_por_tipo` roda dentro de
    # `$(...)`, que é subshell — variável atribuída lá dentro não chega ao pai.
    # Medido: com variável, a nota sumia e o aviso nunca aparecia.
    : >"$NOTA_ARQ" 2>/dev/null || true
    # Degrau 1: completo (uid/gid + permissão + charset).
    if mount -t "$_tipo" -o "$(opcoes_de_mount "$_tipo")" "$_dev" "$_mnt" 2>/dev/null; then
        return 0
    fi
    # Degrau 2: sem charset — nome acentuado pode sair estranho, mas a partição
    # monta. É a diferença entre "Música.mp3 vira M?sica.mp3" e "não há /user".
    if mount -t "$_tipo" -o "uid=0,gid=0,fmask=0000,dmask=0000" "$_dev" "$_mnt" 2>/dev/null; then
        echo "sem charset: o kernel não tem CONFIG_NLS_UTF8, nome com acento pode aparecer errado" >"$NOTA_ARQ" 2>/dev/null
        return 0
    fi
    # Degrau 3: sem permissão — arquivo não é executável, mas o dado está lá.
    if mount -t "$_tipo" "$_dev" "$_mnt" 2>/dev/null; then
        echo "sem uid/gid/permissão: nada em /user é executável até o próximo boot com as opções certas" >"$NOTA_ARQ" 2>/dev/null
        return 0
    fi
    return 1
}

# Tenta montar $1 em $2, descobrindo o tipo. Imprime o tipo em caso de sucesso.
montar_por_tipo() {
    _dev="$1"; _mnt="$2"
    _tipo="$(tipo_de_fs "$_dev" 2>/dev/null || true)"
    if [ -n "$_tipo" ]; then
        montar_com_degraus "$_dev" "$_mnt" "$_tipo" || return 1
        echo "$_tipo"
        return 0
    fi
    # Magic desconhecido (FS exótico): deixa o kernel autodetectar, com as
    # opções de exFAT/FAT — se for ext4 elas dariam EINVAL, então tenta sem.
    mount "$_dev" "$_mnt" 2>/dev/null && { echo auto; return 0; }
    for _t in exfat vfat; do
        montar_com_degraus "$_dev" "$_mnt" "$_t" && { echo "$_t"; return 0; }
    done
    return 1
}

# Lista as partições existentes, as do cartão do rootfs PRIMEIRO.
listar_particioes() {
    _mesmo=""
    _outros=""
    for _p in /sys/class/block/*/partition; do
        [ -e "$_p" ] || continue
        _nome="$(basename "$(dirname "$_p")")"
        [ -e "/dev/$_nome" ] || continue
        _cartao="$(echo "$_nome" | sed 's/p\?[0-9]*$//')"
        if [ -n "$ROOT_CARD" ] && [ "$_cartao" = "$ROOT_CARD" ]; then
            _mesmo="$_mesmo /dev/$_nome"
        else
            _outros="$_outros /dev/$_nome"
        fi
    done
    printf '%s %s\n' "$_mesmo" "$_outros"
}

# ── crescer a partição de dados até o fim do disco (primeiro boot) ──
#
# O problema que isto resolve: a `.img` tem 2 GiB (o GitHub recusa asset ≥ 2
# GiB), então a p3 nasce com ~704 MiB **mesmo num cartão de 120 GB**. O
# `--grow` do `flash-sd.sh` cobre quem grava com ele — mas quem grava com `dd`
# puro, `balenaEtcher` ou o Raspberry Pi Imager fica com 704 MiB e 99% do
# cartão sem uso.
#
# Aqui o aparelho resolve sozinho, no primeiro boot: lê o tamanho real do disco,
# cresce a p3 até o fim e ajusta o filesystem.
#
# ## Como a partição é crescida, e por que não com `fdisk`/`sfdisk`
#
# Medido em 27/11/2026: `sfdisk` NÃO está no Buildroot 2025.02 (só LIBFDISK), e
# o `fdisk` do busybox por script é frágil — numa bancada ele criou a partição 2
# com **512 bytes** em vez de 1 GiB, sem erro nenhum. Um `fdisk` que erra em
# silêncio é a última ferramenta que se quer mexendo no cartão que acabou de
# bootar.
#
# A entrada de partição no MBR é uma estrutura FIXA de 16 bytes, e a posição é
# conhecida: `0x1BE + 16*(n-1)`. Para a p3: `0x1DE`, com o LBA inicial em
# `0x1DE+8` e o tamanho em setores em `0x1DE+12`, ambos little-endian. Escrever
# 4 bytes com `dd` é determinístico e não depende de ferramenta nenhuma.
#
# O CHS (offsets 5-7) fica `0xFF 0xFF 0xFF`, que é o "use LBA" do padrão. Nem o
# kernel nem o U-Boot leem CHS.
#
# ## Os três formatos não são iguais aqui
#
#   ext4        `resize2fs` cresce PRESERVANDO os dados. Pode rodar de novo
#               sempre que o cartão mudar.
#   exFAT/FAT   **não têm resize** — nem no Linux, nem no upstream (o
#               `exfatprogs` não traz ferramenta de resize). Crescer exige
#               REFORMATAR, então só é feito quando a partição está vazia.
#
# Grava o tamanho (4 bytes, little-endian) na entrada da partição no MBR.
#
# Octal, nunca hexa. Medido nas três shells, com o valor 8372224
# (bytes 00 c0 7f 00 — NUL nas duas pontas, que é o caso que falha):
#
#   dash         comenta que 'printf "\\x00"' escreve o TEXTO \x00 (4 bytes de
#                texto no setor de boot, em vez de 1 byte NUL)
#   bash         ok
#   busybox ash  ok
#
# O aparelho usa busybox ash, então a forma hexa "funcionaria" ali. Mas este
# script declara `#!/bin/sh`, e /bin/sh é dash em Debian/Ubuntu: quem rodar o
# S20userdata fora do aparelho para depurar escreveria 16 bytes de texto no
# lugar de 4 bytes de tamanho — MBR inválido, cartão sem tabela, sem mensagem.
# Octal é POSIX e funciona nas três. É o §12.20 na letra: só o que o alvo
# garante, e o alvo não é só o busybox.
# giochi-system:mbr:begin
gravar_tamanho_mbr() {
    _alvo="$1"; _off="$2"; _val="$3"
    _b0=$((   _val        & 255 ))
    _b1=$(( ( _val >>  8) & 255 ))
    _b2=$(( ( _val >> 16) & 255 ))
    _b3=$(( ( _val >> 24) & 255 ))
    printf "\\$(printf '%03o' $_b0)\\$(printf '%03o' $_b1)\\$(printf '%03o' $_b2)\\$(printf '%03o' $_b3)" \
        | dd of="$_alvo" bs=1 seek="$_off" conv=notrunc status=none 2>/dev/null
}
# giochi-system:mbr:end

# É por isso que o crescimento de exFAT/FAT acontece **uma vez**: no primeiro
# boot a p3 tem só o marcador e as quatro pastas (a imagem nasce assim). Depois
# que o usuário põe dados, reformatar seria perda — então o script avisa e não
# mexe.
crescer_particao_dados() {
    # giochi-system:grow:begin
    _dev="$1"; _tipo="$2"
    _cartao="$(basename "$_dev" | sed 's/p\?[0-9]*$//')"
    _num="$(basename "$_dev" | sed 's/^.*[^0-9]\([0-9]*\)$/\1/')"
    _disco="/dev/$_cartao"

    # Tamanho do disco, em setores de 512 (o sysfs sempre reporta em 512).
    _disco_setores="$(cat "/sys/class/block/$_cartao/size" 2>/dev/null)" || return 0
    [ -n "$_disco_setores" ] || return 0

    # A entrada da p3 no MBR: LBA inicial e tamanho, little-endian.
    _entrada=$(( 0x1BE + 16 * (_num - 1) ))
    _lba_ini="$(dd if="$_disco" bs=1 skip=$(( _entrada + 8 )) count=4 2>/dev/null \
        | od -An -tu4 -N4 2>/dev/null | tr -d ' ')"
    _lba_tam="$(dd if="$_disco" bs=1 skip=$(( _entrada + 12 )) count=4 2>/dev/null \
        | od -An -tu4 -N4 2>/dev/null | tr -d ' ')"
    case "$_lba_ini$_lba_tam" in ''|*[!0-9]*) return 0 ;; esac
    [ "$_lba_ini" -gt 0 ] || return 0

    # Margem de 1 MiB: o sfdisk do host alinha no MiB, e crescer até o último
    # setor exato costuma deixar espaço que o próximo `mkfs` reclama.
    _novo_tam=$(( _disco_setores - _lba_ini - 2048 ))
    [ "$_novo_tam" -gt "$_lba_tam" ] || return 0

    _atual_mib=$(( _lba_tam / 2 / 1024 ))
    _novo_mib=$(( _novo_tam / 2 / 1024 ))
    log "disco de ${_disco_setores} setores (~$(( _disco_setores / 2 / 1024 / 1024 )) GiB):"
    log "  p3 tem ${_atual_mib} MiB de ${_novo_mib} MiB possíveis"

    case "$_tipo" in
        ext4)
            # Caminho seguro: cresce a tabela e o filesystem, preservando dados.
            gravar_tamanho_mbr "$_disco" $(( _entrada + 12 )) "$_novo_tam" || return 0
            partprobe "$_disco" 2>/dev/null || true
            sleep 1
            if resize2fs "$_dev" >/dev/null 2>&1; then
                log "  crescido para ${_novo_mib} MiB (resize2fs, dados preservados)"
            else
                log "  AVISO: resize2fs falhou — a p3 fica com ${_atual_mib} MiB"
            fi
            ;;
        exfat|vfat)
            # Não há resize: só reformatar. Seguro APENAS se estiver vazia — e
            # estar vazia é o estado do primeiro boot (só o marcador e as
            # quatro pastas). Se houver qualquer arquivo do usuário, não mexe.
            # A partição está DESMONTADA aqui (é o requisito para crescer), então
            # montar num ponto temporário é a única forma de olhar o conteúdo.
            # No primeiro boot ela tem só as quatro pastas, o marcador e o
            # LEIA-ME — a imagem nasce assim.
            _tmpmnt=/run/giochi/p3-tmp
            mkdir -p "$_tmpmnt" 2>/dev/null
            _extra=""
            if mount -t "$_tipo" -o "uid=0,gid=0,fmask=0000,dmask=0000" "$_dev" "$_tmpmnt" 2>/dev/null; then
                _extra="$(ls -A "$_tmpmnt" 2>/dev/null | grep -vxE 'games|apps|musica|ports|giochi-user|LEIA-ME.txt' | head -1)"
                umount "$_tmpmnt" 2>/dev/null
            else
                # Não conseguiu montar para inspecionar: não cresce. Na dúvida,
                # preservar o dado é sempre a escolha certa.
                _extra="(não consegui montar para conferir)"
            fi
            rmdir "$_tmpmnt" 2>/dev/null
            if [ -n "$_extra" ]; then
                log "  AVISO: a p3 é $_tipo e crescer exigiria reformatar"
                log "         há dados do usuário ('$_extra') — não vou apagar"
                log "         para usar o cartão inteiro: regrave com --grow, ou copie"
                log "         o conteúdo, formate do zero e devolva"
                return 0
            fi
            gravar_tamanho_mbr "$_disco" $(( _entrada + 12 )) "$_novo_tam" || return 0
            partprobe "$_disco" 2>/dev/null || true
            sleep 1
            _mkfs=""
            case "$_tipo" in
                exfat) _mkfs="mkfs.exfat -L $LABEL_PREFERIDO" ;;
                vfat)  _mkfs="mkfs.vfat -F 32 -n $LABEL_PREFERIDO" ;;
            esac
            if command -v ${_mkfs%% *} >/dev/null 2>&1 && $_mkfs "$_dev" >/dev/null 2>&1; then
                log "  crescido para ${_novo_mib} MiB (reformatado — estava vazio)"
            else
                log "  AVISO: sem ${_mkfs%% *} na imagem — a p3 fica com ${_atual_mib} MiB"
            fi
            ;;
        *)
            log "  AVISO: não sei crescer $_tipo sem perder dados"
            ;;
    esac
    # giochi-system:grow:end
}

# Acha e monta a partição de dados em $MNT. Imprime "<device> <tipo>" na saída.
achar_e_montar_dados() {
    _partes="$(listar_particioes)"
    [ -n "$_partes" ] || return 1

    for _dev in $_partes; do
        _cartao="$(basename "$_dev" | sed 's/p\?[0-9]*$//')"
        _num="$(basename "$_dev" | sed 's/^.*[^0-9]\([0-9]*\)$/\1/')"
        _e_do_rootfs=0
        if [ -n "$ROOT_CARD" ] && [ "$_cartao" = "$ROOT_CARD" ]; then
            _e_do_rootfs=1
        fi
        # O rootfs em uso não é candidato: montá-lo em /user mostraria a raiz
        # do sistema ali, e é leitura desnecessária do cartão que está rodando.
        [ "$(basename "$_dev")" = "$ROOT_PARTICAO" ] && continue

        _tipo="$(montar_por_tipo "$_dev" "$MNT" 2>/dev/null || true)"
        [ -n "$_tipo" ] || continue

        # Critério 1 — LAYOUT: p3 do cartão do rootfs é a nossa, por construção.
        if [ "$_e_do_rootfs" = 1 ] && [ "$_num" = "3" ]; then
            printf '%s %s layout\n' "$_dev" "$_tipo"
            return 0
        fi
        # Critério 2 — MARCADOR: vale para o segundo cartão, e também para uma
        # p3 de um layout antigo (que era a p2 crescida).
        if [ -d "$MNT/$MARCADOR" ] || [ -e "$MNT/$MARCADOR" ] || [ -d "$MNT/games" ] || [ -d "$MNT/musica" ]; then
            printf '%s %s marcador\n' "$_dev" "$_tipo"
            return 0
        fi
        # Não é a nossa: desmonta (fomos nós que montamos) e segue.
        umount "$MNT" 2>/dev/null
    done

    # Critério 3 — RÓTULO, só se o by-label existir (imagem com eudev).
    for _alvo in /dev/disk/by-label/"$LABEL_PREFERIDO"*; do
        [ -e "$_alvo" ] || continue
        _real="$(readlink -f "$_alvo" 2>/dev/null)" || continue
        [ -n "$_real" ] || continue
        _tipo="$(montar_por_tipo "$_real" "$MNT" 2>/dev/null || true)"
        [ -n "$_tipo" ] || continue
        printf '%s %s rotulo\n' "$_real" "$_tipo"
        return 0
    done
    return 1
}

# Nome do CARTÃO que sustenta o rootfs (`mmcblk1` a partir de `mmcblk1p2`).
#
# ## O defeito que estava aqui
#
# A versão anterior lia `/proc/self/mountinfo` com o formato de `/proc/mounts`:
#
#     awk '$2 == "/" { print $1; exit }'      # $2 no mountinfo é o PARENT ID
#
# No `mountinfo` os campos são `id parent-id maj:min root mountpoint ...` — o
# ponto de montagem é o **$5** e o device é o **$3**. Com `$2` a comparação
# nunca casava, a função devolvia vazio, e o critério "p3 do cartão do rootfs"
# nunca disparava. Ficou invisível porque o código antigo dependia só de
# by-label, que também não existe (ver o comentário da descoberta) — dois
# defeitos que se escondiam um atrás do outro.
# Nome da PARTIÇÃO do rootfs (ex.: `mmcblk1p2`). Serve para NÃO tentar montá-la
# em /user: montar o sistema em cima de /user mostraria a raiz inteira ali,
# e o teste de marcador reprovaria depois de já ter mexido no ponto de montagem.
particao_do_root() {
    _mm="$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo 2>/dev/null)"
    [ -n "$_mm" ] || return 1
    _n="$(basename "$(readlink -f "/sys/dev/block/$_mm" 2>/dev/null)")"
    [ -n "$_n" ] && echo "$_n"
}

dispositivo_do_root() {
    MAJMIN="$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo 2>/dev/null)"
    [ -n "$MAJMIN" ] || return 1
    dev="$(readlink -f "/sys/dev/block/$MAJMIN" 2>/dev/null)"
    [ -n "$dev" ] || return 1
    # .../mmcblk0/mmcblk0p2 -> mmcblk0 (o cartão, não a partição)
    base="$(basename "$dev")"
    case "$base" in
        *p[0-9]*) echo "$base" | sed 's/p[0-9]*$//' ;;
        *) echo "$base" | sed 's/[0-9]*$//' ;;
    esac
}

ROOT_CARD="$(dispositivo_do_root 2>/dev/null || true)"
ROOT_PARTICAO="$(particao_do_root 2>/dev/null || true)"

# ── montar ──
#
# Se já está montado (init anterior, ou o app montou), não mexe: desmontar o que
# não se montou é o defeito do §12.28, e aqui derrubaria o usuário no meio.
if mountpoint -q "$MNT" 2>/dev/null || grep -q " $MNT " /proc/mounts 2>/dev/null; then
    log "$MNT já está montado — não mexo"
else
    mkdir -p "$MNT"
    # Guarda o que está embaixo ANTES de montar por cima. Sem isso, a migração
    # do primeiro boot não teria de onde ler.
    if [ -d "$MNT" ] && [ -n "$(ls -A "$MNT" 2>/dev/null)" ]; then
        mkdir -p /run/giochi
        rm -rf /run/giochi/user-antes-da-montagem
        cp -a "$MNT/." /run/giochi/user-antes-da-montagem/ 2>/dev/null || true
        log "guardei o /user do rootfs em /run/giochi/user-antes-da-montagem"
    fi

    # ── crescer ANTES de montar ──
    #
    # A p3 do cartão do rootfs é determinística (LAYOUT): não precisa montar para
    # saber que é ela. Crescer exige a partição desmontada, então esta é a única
    # janela do boot em que dá para fazer.
    #
    # Só a p3 — o segundo cartão não é crescido. Ele já vem no tamanho que o
    # usuário formatou, e mexer na partição de um cartão alheio é o tipo de coisa
    # que apaga o save de outra pessoa.
    if [ -n "$ROOT_CARD" ] && [ -n "$ROOT_PARTICAO" ]; then
        case "$ROOT_PARTICAO" in
            *p[0-9]*) _p3="/dev/$(echo "$ROOT_PARTICAO" | sed 's/p[0-9]*$//')p3" ;;
            *)        _p3="/dev/$(echo "$ROOT_PARTICAO" | sed 's/[0-9]*$//')3" ;;
        esac
        if [ -e "$_p3" ]; then
            _tipo_p3="$(tipo_de_fs "$_p3" 2>/dev/null || true)"
            [ -n "$_tipo_p3" ] && crescer_particao_dados "$_p3" "$_tipo_p3"
        fi
    fi

    RESULTADO="$(achar_e_montar_dados 2>/dev/null || true)"
    if [ -z "$RESULTADO" ]; then
        log "sem partição de dados — /user continua no rootfs"
        log "  (o layout espera a p3; num segundo cartão, crie a pasta '$MARCADOR' na raiz dele)"
        exit 0
    fi
    DATA_DEV="$(echo "$RESULTADO" | awk '{print $1}')"
    DATA_TIPO="$(echo "$RESULTADO" | awk '{print $2}')"
    DATA_COMO="$(echo "$RESULTADO" | awk '{print $3}')"
    log "$DATA_DEV ($DATA_TIPO, achada por $DATA_COMO) montada em $MNT"
    # Se o mount só passou num degrau degradado, isso tem de aparecer: sem a
    # nota, "os jogos não executam" ou "os acentos estão errados" parecem bug de
    # outro lugar.
    [ -s "$NOTA_ARQ" ] && log "  ATENÇÃO: $(cat "$NOTA_ARQ")"
    case "$DATA_TIPO" in
        exfat|vfat)
            # O aviso que evita a pergunta "por que meu save sumiu": exFAT e FAT
            # não guardam permissão nem dono, e todo arquivo entra como 0777.
            log "  $DATA_TIPO não guarda permissão — o mount aplica 0777 (fmask=0000)"
            ;;
    esac
fi

# ── migrar no primeiro boot ──
#
# Critério: a partição está VAZIA e há conteúdo guardado de baixo. Se a
# partição já tem qualquer coisa, não toco — pode ser o save de um jogo, e
# sobrescrever seria perda de dado sem volta.
GUARDADO=/run/giochi/user-antes-da-montagem
if [ -d "$GUARDADO" ]; then
    if [ -z "$(ls -A "$MNT" 2>/dev/null)" ]; then
        log "primeiro boot: migrando o /user do rootfs para a partição de dados"
        # `cp -a` num exFAT/FAT FALHA ao tentar preservar dono e permissão —
        # ambos são no-op lá, mas o busybox cp pode abortar no meio e deixar
        # cópia parcial. O conteúdo é o mesmo; só não há o que preservar.
        case "${DATA_TIPO:-ext4}" in
            exfat|vfat) cp -r "$GUARDADO/." "$MNT/" 2>/dev/null || log "  aviso: cópia parcial" ;;
            *)          cp -a "$GUARDADO/." "$MNT/" 2>/dev/null || log "  aviso: cópia parcial" ;;
        esac
        # Só apaga depois de copiar; se a cópia falhou no meio, o original fica.
        if [ -n "$(ls -A "$MNT" 2>/dev/null)" ]; then
            rm -rf "$GUARDADO"
            log "  migração concluída"
        fi
    else
        log "partição de dados já tem conteúdo — não mexo (nada foi apagado)"
    fi
fi

# ── as quatro pastas do contrato, em qualquer cartão ──
#
# Idempotente: `mkdir -p` não faz nada se já existem. É o que garante que
# `/user/games` exista também num segundo cartão recém-formatado.
for pasta in games apps musica ports; do
    mkdir -p "$MNT/$pasta" 2>/dev/null || true
done

# O marcador: é o que faz ESTE cartão ser reconhecido como partição de dados no
# próximo boot, e o que o usuário cria com dois cliques no Windows para separar
# um segundo cartão. Criado aqui para o primeiro cartão não precisar de nada.
mkdir -p "$MNT/$MARCADOR" 2>/dev/null || true

# /roms -> /user é criado pelo post-build DENTRO do rootfs; se a partição de
# dados foi montada por cima, o link continua válido porque aponta para o
# caminho, não para o inode. Conferir e recriar é barato e cobre imagem antiga.
[ -e /roms ] || ln -sfn /user /roms 2>/dev/null || true

log "pronto: $(df -h "$MNT" 2>/dev/null | awk 'NR==2 {print $2" total, "$4" livre"}')"
exit 0
