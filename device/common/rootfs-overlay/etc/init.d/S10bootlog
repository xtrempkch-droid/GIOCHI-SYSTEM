#!/bin/sh
# ============================================================
# S10bootlog — log do boot na FAT do cartão, o MAIS CEDO possível
# ============================================================
# Roda logo depois do devtmpfs (S01/S02) e antes de rede, sshd e qualquer
# serviço que possa travar. O que interessa num bring-up (probe do painel, DRM,
# MMC, USB) já está no `dmesg` neste ponto — então mesmo que um serviço pendure
# o boot depois, o diagnóstico está no cartão.
#
# Só roda quando o aparelho tem o marcador /etc/giochi/boot-log. Aparelho com
# console (X55) não tem o marcador e não escreve no cartão a cada boot.
#
# NÃO silencie a saída: a primeira versão fazia `>/dev/null 2>&1` e o único
# sintoma passou a ser "não tem log" — sem nenhuma pista de qual passo falhou.
# O `giochi-bootlog` já manda as mensagens para /dev/tty0, o console do painel.

[ -f /etc/giochi/boot-log ] || exit 0
/usr/bin/giochi-bootlog early
exit 0
