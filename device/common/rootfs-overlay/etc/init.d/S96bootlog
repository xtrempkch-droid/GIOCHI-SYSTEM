#!/bin/sh
# ============================================================
# S96bootlog — log do boot: acrescenta o resultado final
# ============================================================
# O S10bootlog já gravou o dmesg e o estado do DRM. Aqui acrescenta o que só
# existe no fim: endereços de rede e o veredito do `giochi-selftest`.
#
# O arquivo é o MESMO (giochi-boot.log): a fase early escreve, a full anexa.
# Se esta não rodar porque um serviço travou, o do early continua lá.

[ -f /etc/giochi/boot-log ] || exit 0
/usr/bin/giochi-bootlog full
exit 0
