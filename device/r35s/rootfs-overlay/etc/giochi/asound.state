# Estado do mixer do R35S — restaurado por /etc/init.d/S51mixer no boot.
#
# Só existe por causa de UM controle: `Playback Mux`, que é `HP` | `SPK`. Ele é
# virtual (DAPM, `SOC_ENUM_SINGLE_VIRT` no driver mainline), nenhum registrador
# guarda o valor, e o driver não lê propriedade de DT para ele — quem escolhe é
# userspace. O default do driver é `HP`.
#
# No R35S o DTS roteia `Speaker -> SPKO`, e a tabela de rotas do codec é
# explícita: `Playback Mux, "HP"` alimenta HPOL/HPOR; só `Playback Mux, "SPK"`
# alimenta `SPK DAC -> SPKO`. Com `HP` o falante NÃO recebe sinal — o aparelho
# só toca no fone. Medido em 06/11/2026: o selftest dava `PASS` porque a regra
# de HP era da X55 (lá o amplificador é alimentado por HPOL/HPOR, então HP é o
# valor certo).
#
# Formato: saída de `alsactl store`, editada no valor do Mux. Conferido no
# aparelho — `alsactl -f <este arquivo> restore` deixa o controle em SPK.
state.rk817int {
	control.1 {
		iface CARD
		name 'Headphones Jack'
		value true
		comment {
			access read
			type BOOLEAN
			count 1
		}
	}
	control.2 {
		iface MIXER
		name 'Master Playback Volume'
		value.0 255
		value.1 255
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 255'
			dbmin -9500
			dbmax 0
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.3 {
		iface MIXER
		name 'Master Capture Volume'
		value.0 255
		value.1 255
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 255'
			dbmin -9500
			dbmax 0
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.4 {
		iface MIXER
		name 'Mic Capture Gain'
		value.0 6
		value.1 6
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 15'
			dbmin -1800
			dbmax 2700
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.5 {
		iface MIXER
		name 'Playback Mux'
		value SPK
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 HP
			item.1 SPK
		}
	}
}
