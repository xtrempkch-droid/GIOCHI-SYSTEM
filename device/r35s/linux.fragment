# R35S / R36S — fragmento de KERNEL
#
# Aplicado ao `.config` do kernel via `BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES`.
# NÃO é fragmento de Buildroot: símbolo `CONFIG_*` aqui não vira `BR2_*`.
#
# ## Proveniência — isto não é cópia de receita
#
# Cada símbolo abaixo foi conferido contra a config do kernel que **realmente
# roda** nesta placa. Ela foi extraída do aparelho em 06/11/2026 pela console
# serial (`/proc/config.gz`, 41 849 bytes, md5 `93bf213f1cbaed4f5867236cdfb4c13c`)
# e está guardada em `extracted/kernel-config.gz`.
#
# O kernel do ROCKNIX é vendor `7.1.2`; o nosso é mainline **6.12**. Símbolo que
# o 6.12 não conhece é descartado em silêncio pelo `olddefconfig` — para isso
# existe `scripts/assert-kernel-config.mjs`, que roda depois e falha o build
# citando o nome. É a rede que impede este arquivo de virar ficção.
#
# ## A armadilha do DSI (a mesma que já custou um build na X55)
#
# O PHY MIPI-DSI tem de ser `=y`, nunca `=m`. Como módulo ele carrega DEPOIS do
# controlador, o painel recebe -517 (EPROBE_DEFER) e desiste. Sintoma: nenhum
# `/dev/dri/card0`, tela preta, e nada no log ligando a causa ao efeito.

# ── display: o bloco mais frágil ────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_ROCKCHIP_IOMMU=y
# Backlight por PWM. O painel declarado no DTS usa `backlight = <&backlight>`
# com `pwm-backlight`, e há um `power-supply = <&vcc_bl>` que precisa de
# `pwm-regulator` no caminho.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y

# GPU: `=y`, e NÃO `=m` como o vendor declara.
#
# O raciocínio anterior aqui era "`=m` como no vendor, para o `mali_kbase`
# proprietário também poder carregar depois". Medido no R35S em 06/11/2026, ele
# custa a GPU inteira: o rootfs do Buildroot não tem `/etc/modules` nem
# `modules-load`, então o `.ko` fica no disco e ninguém o carrega — não sobra nem
# `/dev/dri/renderD128`. É exatamente a armadilha do áudio (§12.43 deste
# AGENTS.md), uma camada acima.
#
# O que torna isso perigoso, e não só quebrado: sem panfrost a Mesa cai no
# `swrast`, e o probe devolve
#
#   com panfrost:  GL_RENDERER = Mali-G31 (Panfrost)   GL_VERSION = OpenGL ES 3.1
#   sem panfrost:  GL_RENDERER = softpipe              GL_VERSION = OpenGL ES 3.1
#
# — a MESMA versão e o MESMO "GLES respondeu". Quem pergunta "tem GLES 3.1?"
# recebe sim nos dois casos, com o aparelho renderizando na CPU.
#
# GPU é hardware onboard, presente em todo boot: `=y` é a regra do repositório.
# E o `mali_kbase` da loja não se beneficia do `=m` — os dois drivers disputam o
# mesmo nó `gpu@ff400000`, então nunca conviveriam carregados.
CONFIG_DRM_PANFROST=y

# ── armazenamento ───────────────────────────────────────────
# O cartão desta placa é SDHCI do DesignWare. Sem `MMC_DW_ROCKCHIP` não há rootfs.
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_SQUASHFS=y

# ── entrada ─────────────────────────────────────────────────
# `JOYSTICK_ADC` é o que faz o nó `adc-joystick` do DTS funcionar. Sem ele o nó
# existe e não gera evento — o pior tipo de falha (AGENTS §12.15).
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_KEYBOARD_GPIO=y
# ADC do SoC: o driver do joypad lê o multiplexador por `saradc`.
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y

# ── joypad fora da árvore ───────────────────────────────────
# O R35S lê os 16 botões e os 4 eixos por UM canal do SARADC, atrás de um
# multiplexador analógico. O `adc-joystick` do mainline exige um canal por eixo
# e não atende; quem atende é o `rocknix-singleadc-joypad`, trazido para dentro
# da árvore pelo patch `patches/0002-giochi-joypad-singleadc.patch`.
#
# `=y` e não `=m` de propósito: o `S15modules` só carrega o que está em
# `/etc/modules`, e um driver de gamepad que depende disso é um gamepad que
# pode não existir no boot. Medido na X55: módulo presente, nada carregado,
# botões mortos e build verde (§3 daquele bring-up).
#
# Sem este símbolo o DTS declara `compatible = "rocknix-singleadc-joypad"` e
# nenhum driver responde — o aparelho boota, mostra o login e não tem botão
# nenhum, sem uma linha de erro (é o §12.15 na forma mais cara).
CONFIG_JOYSTICK_ODROIDGO3=y

# ── áudio ───────────────────────────────────────────────────
# Medido no aparelho: card `rk817_int`, codec no PMIC RK817.
# `SIMPLE_AMPLIFIER` fica `=m` como no vendor; se o card depender dele em
# `aux-devs`, ele precisa carregar junto — o mesmo problema que deu
# "--- no soundcards ---" na X55.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# O I2S é FILHO de SND_SOC_ROCKCHIP (`depends on HAVE_CLK && SND_SOC_ROCKCHIP`).
# Pedir só o filho não basta: o pai ficou `=m` e o filho não pôde passar de `m`.
# Medido — o `assert-kernel-config` pegou:
#
#   CONFIG_SND_SOC_ROCKCHIP_I2S: pedido =y, ficou =m
#
# Sem o pai explícito a imagem sairia com o driver de áudio como módulo,
# dependente de autoload, e o card `rk817_int` não apareceria no boot.
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m

# ## O CARD, não só o codec
#
# Medido no aparelho em 06/11/2026 com a imagem que bootou: codec, I2S e PMIC
# todos `=y` e mesmo assim `--- no soundcards ---`. Faltava a peça que LÊ o nó
# `rk817-sound` do DTS e monta o card: o `simple-audio-card`.
#
# Ele estava `=m` (default do defconfig arm64), e o R35S não tem `/etc/modules`
# nem `S15modules` — a mesma armadilha do X55 (§3): módulo presente na imagem,
# nada o carrega, build verde, hardware mudo. O `.ko` estava em
# `/lib/modules/.../snd-soc-simple-card.ko` e ninguém o abria.
#
# `=y` porque o alto-falante é hardware ONBOARD: aparece em todo boot, não é
# acessório que o usuário pluga (§12.31). `select SND_SIMPLE_CARD_UTILS` vem
# junto, então não precisa pedir.
CONFIG_SND_SIMPLE_CARD=y

CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y

# ── energia e relógio ───────────────────────────────────────
CONFIG_REGULATOR=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_RK808=y

# BATERIA: o nó `charger` do rk817 existe no DT (com `monitored-battery` para o
# `simple-battery`), e o driver ficou no default do defconfig arm64 — `=m`, sem
# ninguém para carregá-lo. Medido no R35S em 06/11/2026:
#
#   antes:   /sys/class/power_supply/ VAZIO  → selftest "sem bateria detectada"
#   modprobe rk817_charger →
#            rk817-battery  TYPE=Battery PRESENT=1 STATUS=Discharging
#            rk817-charger  TYPE=USB
#
# Sem isto o launcher não tem nível de carga para mostrar, e o aparelho desliga
# sem aviso. `=y` pelo mesmo motivo do panfrost (§12.51): bateria é onboard.
CONFIG_CHARGER_RK817=y

# THERMAL: o DT declara `thermal-zones` (soc e gpu), mas sem o driver não há
# `thermal_zone*` — só `cooling_device*` órfãos. Medido: `modprobe
# rockchip_thermal` fez aparecer `thermal_zone0 = soc-thermal 44090` e
# `thermal_zone1 = gpu-thermal 47727`. Sem ele o aparelho não tem proteção
# térmica nem leitura de temperatura, e o selftest avisa "sem zona térmica".
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y

# A pilha de frequência do PX30 no mainline é `cpufreq-dt`, não
# `rockchip-cpufreq` — o símbolo do antecessor foi removido no 6.12 (§12.9).
#
# MEDIDO ao montar este fragmento: `CONFIG_ROCKCHIP_CPUINFO=y` existe no
# kernel do vendor (7.1.2) e NÃO existe no 6.12 — mesmo destino do
# `ARM_ROCKCHIP_CPUFREQ`. Conferir cada símbolo contra o Kconfig da árvore
# (64 símbolos: 63 presentes, 1 ausente) custou segundos e evita um
# `assert-kernel-config` vermelho depois de 40 min de build.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_PM_DEVFREQ=y

# ── USB: é o único canal de shell (não há rádio nesta placa) ─
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y

# ## Transferência de arquivo pela USB: o que EXISTE no kernel mainline
#
# MTP não é opção. O kernel mainline **não tem `f_mtp`**: não há
# `CONFIG_USB_CONFIGFS_MTP` nem `f_mtp.c` em `drivers/usb/gadget/function/`
# (conferido no 6.12 desta árvore). MTP em Android vem de patch fora da árvore,
# e Android usa MTP porque não pode expor o armazenamento cru — restrição que
# não temos.
#
# O que existe e serve é `mass_storage`, e ele já vem `=y` do defconfig arm64.
# Declarado explicitamente porque é o que `giochi-usbnet --ms` usa para expor
# uma partição ao PC como disco removível: `cp` e `rsync` funcionam direto, sem
# daemon nem biblioteca no aparelho.
#
# `F_FS` (FunctionFS) é a porta para um MTP em userspace, se algum dia houver
# um daemon. Fica ligado, custa nada e mantém a opção aberta — mas sem daemon
# ele não faz nada, e é honesto dizer isso em vez de deixar parecer MTP.
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# ── rádio USB (dongle do usuário) ───────────────────────────
# A placa não tem rádio onboard, mas a imagem é gravada uma vez e o dongle
# chega depois (AGENTS §12.31). Tudo `=m`: carrega por modalias, custo zero
# se ninguém plugar. `RTL8XXXU_UNTESTED` é o que cobre o 8188FU, o dongle
# barato de hoje.
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTL8192CU=m
CONFIG_MT7601U=m
CONFIG_ATH9K_HTC=m
CONFIG_MAC80211=m
CONFIG_CFG80211=m

# ── painel DSI fora da árvore ───────────────────────────────
# O painel do R35S é um clone sem controlador nomeado, então o ROCKNIX o
# descreve em DADOS: a sequência de init (155 comandos), a geometria e a
# temporização vão na propriedade `panel_description` do DT, e o driver
# `panel-generic-dsi` interpreta. É o que `scripts/panel-to-dtsi.mjs` gera.
#
# Sem este símbolo o nó `panel@0` do DTS fica ÓRFÃO: o `dw-mipi-dsi-rockchip`
# probe, o `mipi-dsi ff450000.dsi.0` é criado, e nenhum driver responde. Não há
# `/dev/dri/card0`, não há erro no dmesg, e o sintoma é **tela preta com o
# sistema bootando normal** — medido no R35S em 06/11/2026.
#
# `=y` e não `=m`: um módulo que depende do `S15modules` é uma tela que pode não
# acender. O painel é o console desta placa.
CONFIG_DRM_PANEL_GENERIC_DSI=y

# ── console de vídeo e bootsplash ───────────────────────────
# O painel é o console: `giochi-selftest` e o getty aparecem nele, e o psplash
# pinta por cima no `S01`.
#
# `DEFERRED_TAKEOVER` faz o fbcon esperar haver texto antes de tomar a tela —
# sem ele o fbcon pinta preto assim que carrega e apaga o que estava lá, criando
# uma janela preta no meio do boot que parece travamento.
#
# `CONFIG_LOGO=n` tira o pinguim: com ele a sequência é "pinguim -> preto ->
# nosso splash"; sem ele é "preto -> nosso splash", que parece o mesmo sistema
# do começo ao fim.
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# CONFIG_LOGO is not set
