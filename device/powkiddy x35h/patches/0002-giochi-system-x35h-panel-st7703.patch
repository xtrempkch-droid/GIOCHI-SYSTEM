+static const struct drm_display_mode powkiddy_x35h_panel_mode = {
+	.hdisplay	= 640,
+	.hsync_start	= 640 + 150,
+	.hsync_end	= 640 + 150 + 50,
+	.htotal		= 640 + 150 + 50 + 150,
+	.vdisplay	= 480,
