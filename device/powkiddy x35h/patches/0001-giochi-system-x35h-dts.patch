+++ b/arch/arm64/boot/dts/rockchip/rk3566-powkiddy-x35h.dts
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Powkiddy X35H (e X35S) — variante de painel menor da Powkiddy X55.
+ *
+ * Reaproveita o DTS da X55 inteiro porque o que difere é pouco e mensurável:
+ * painel (640x480 em vez de 720x1280) e capacidade da bateria (3000 mAh em
+ * vez de 4000 mAh). O SoC é o mesmo RK3566, o layout de gpio-keys é o mesmo,
+ * o RTL8821CS simplesmente não é populado.
+ *
+ * O painel é um Sitronix ST7703: a sequência de inicialização medida na
+ * ROCKNIX usa apenas comandos que o driver mainline panel-sitronix-st7703.c
+ * já implementa (B9/B1/B2/B3/B4/B5/B6/B8/BA/BC/BF/C0/C1/C6/C7/C8/CC/E0/E3/
+ * E9/EA/EF). Por isso ele entra por um `compatible` novo em vez de exigir o
+ * driver fora da árvore `rocknix,generic-dsi`.
+ */
+
+#include "rk3566-powkiddy-x55.dts"
+
+/ {
+	model = "Powkiddy x35h";
+	compatible = "powkiddy,x35h", "rockchip,rk3566";
+};
+
+&battery {
+	charge-full-design-microamp-hours = <3000000>;
+};
+
+/*
+ * Os patches do DTS da X55 NAO se aplicam aqui: patch de kernel nao se compoe
+ * entre aparelhos, e este DTS inclui a versao MAINSTREAM do
+ * rk3566-powkiddy-x55.dts. Sem as correcoes abaixo o build fica verde e a
+ * imagem herda defeitos que so aparecem no aparelho.
+ */
+
+/* HDMI nao esta ligado fisicamente. Deixado "okay", o DRM cria um conector
+ * fantasma e o probe do dw-hdmi atrasa o boot sem uso possivel.
+ */
+&hdmi {
+	status = "disabled";
+};
+
+&hdmi_sound {
+	status = "disabled";
+};
+
+/* sdmmc1 e o barramento do RTL8821CS (Wi-Fi/BT) da X55. Esta placa nao tem o
+ * chip: com o no "okay" e `non-removable`, o kernel inicializa um cartao SDIO
+ * que nao existe e falha com -110 repetidamente, atrasando o boot. Nao basta
+ * omitir o patch da X55 — e preciso DESLIGAR o que o DTS da X55 liga.
+ */
+&sdmmc1 {
+	status = "disabled";
+};
+
+/* uart1 e o Bluetooth do mesmo chip, tambem ausente. */
+&uart1 {
+	status = "disabled";
+};
+
+/* TRNG: o rk356x.dtsi deixa "disabled" e o RK3566 nao herda o "okay" do
+ * rk3568.dtsi. Sem entropia o crng demora a inicializar e o getrandom()
+ * bloqueia — inclusive o sshd na primeira conexao.
+ */
+&rng {
+	status = "okay";
+};
+
+&panel {
+	compatible = "powkiddy,x35h-panel";
+	/* O painel é montado na orientação natural nesta carcaça. */
+	rotation = <0>;
+};
